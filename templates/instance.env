# @NAME@ instance -- docker plumbing only.
#
# Everything an operator tunes lives in the settings file below, which
# is read by Lua and so works for a natively run LSd too. Nothing in
# THIS file is read by the server itself: lsdctl turns it into docker
# compose variables, and the entrypoint into argv.
LSD_PORT=@PORT@
# the ONE shared config, used by every instance: it decides only the
# order things load in. Everything else is in the .settings file.
LSD_CONFIG_FILE=./config.lua
# this instance's settings: its name, gamemode, maps, module list
LSD_SETTINGS_FILE=@SETTINGS@
# this server's own maps; nothing else reads or writes them
LSD_MAPS_DIR=@MAPSDIR@
LSD_RW_VOLUME=lsd-@NAME@-rw
# run the in-development scripts.dev/ layer (0 = released scripts only)
LSD_SCRIPTS_DEV=1
