#T# Template `lsdctl new` fills in for a new instance. @PLACEHOLDERS@ are
#T# substituted and #T# lines are dropped; everything else is copied
#T# through, so a setting added here reaches every instance created after.
# @NAME@ instance
LSD_PORT=@PORT@
LSD_NAME=@NAME@
LSD_GAMEMODE=ctf
LSD_MAPS=@MAPS@
LSD_CONFIG_FILE=./@CONFIG@
# this server's own maps; nothing else reads or writes them
LSD_MAPS_DIR=./@MAPSDIR@
LSD_RW_VOLUME=lsd-@NAME@-rw
# run the in-development scripts.dev/ layer (0 = released scripts only)
LSD_SCRIPTS_DEV=1
# announce this instance to the public server lists (0 = unlisted)
LSD_MASTERLIST=1
