#!/bin/sh
# lsdctl -- manage dockerized LSD server instances
#
# Copyright (C) 2026 Fran6nd. AGPL-3.0-or-later; see LICENSE.
#
# Each instance is the pair instances/<name>.env + instances/<name>.config.lua,
# run as its own compose project (lsd-<name>) off the shared docker-compose.yml.
# Per-instance commands take the instance name first: `lsdctl <name> <command>`.
# The *All commands (and `all <command>`) fan a command out over every instance.
#
# The instance's .env file is the source of truth for its settings. A running
# container keeps the values it was created with, so commands that apply a
# setting live also record it in the .env; `reload` notices when the two have
# drifted apart and recreates instead of restarting in place.
set -eu

DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
cd "$DIR"

INSTANCES_DIR=instances
# what a new instance is stamped out of; keep these neutral, anything
# specific to one server belongs in that server's copy
TEMPLATES_DIR=templates

usage() {
	cat <<'EOF'
usage:
  lsdctl <instance> <command> [args]   act on one instance
  lsdctl <global-command> [args]       act on the whole instance set

instances
  ls                  list instances (name, port, gamemode, listing, state)
  new <name> [-p N]   create instances/<name>.env, <name>.config.lua
                      and <name>.map/ from templates/ (maps seeded from
                      an existing instance)
  rm  <name>          stop and delete an instance

scripts
  promote <module>... move a module from scripts.dev/ to scripts.local/
                      (released); takes its companion directory along

all instances (every per-instance command below has an All twin)
  <command>All [args] run that per-instance command on every instance,
                      e.g. upAll downAll restartAll reloadAll statusAll
                      logsAll loadAll unloadAll lsmodAll mapAll ...
  all <command> [a]   same thing, spelled with a space
  update              pull upstream source, rebuild, restart every instance

per-instance (first arg is the instance name)
  up                  build if needed and start the instance
  down                stop the instance
  restart             restart the instance (applies config/.env changes)
  reload [msg]        warn players in-game, then restart (reloads scripts)
  status              show container state and published ports
  logs [-f]           show server logs (-f to follow)
  console             attach to the in-game admin console (Ctrl-C to leave)
  shell               open a shell inside the container

  map list            list this instance's installed maps
  map add <src>...    install maps from local files or http(s) URLs
  map rm <name>...    remove maps
  map load <name>     switch this instance's live map now (no restart)
  gamemode [name]     show or set the gamemode (ctf, arena, babel, ...)
  set KEY VALUE       set any .env setting (LSD_PORT, LSD_NAME, LSD_MAPS, ...)

  load [module...]    sync the script layers and hot-(re)load modules
  unload <module>...  unload modules from the running server
  lsmod               list modules loaded in the running server
  edit [on|off]       enter/leave world_editor edit mode (console-only gate)
  dev [on|off]        show/set whether this instance runs the scripts.dev/
                      layer on top of the released scripts.local/ one
  masterlist [on|off] show/set whether this instance is announced to the
                      public server lists (off = unlisted, not private)

Each instance owns its maps in instances/<name>.map/ -- editing a map on
one server never touches another's. Override with LSD_MAPS_DIR in its .env.

Instance config lives in instances/<name>.config.lua; custom/overriding
scripts go in scripts.local/ (released) and scripts.dev/ (in development,
wins over both scripts.local/ and the upstream script of the same name).
EOF
	exit "${1:-0}"
}

# the per-instance subcommands -- the set that also gets an All twin
is_instance_command() {
	case "$1" in
	up|down|restart|reload|status|logs|console|shell|load|unload|lsmod|edit|map|gamemode|set|dev|masterlist) return 0 ;;
	*) return 1 ;;
	esac
}

# names that would shadow a global verb or a <command>All fan-out
reserved_name() {
	case "$1" in
	ls|list|new|rm|update|promote|help|-h|--help|all) return 0 ;;
	esac
	case "$1" in
	*All) is_instance_command "${1%All}" && return 0 ;;
	*all) is_instance_command "${1%all}" && return 0 ;;
	esac
	return 1
}

envf_for() { printf '%s/%s.env' "$INSTANCES_DIR" "$1"; }
cfgf_for() { printf '%s/%s.config.lua' "$INSTANCES_DIR" "$1"; }
# Maps belong to one server, not to all of them. An instance owns
# instances/<name>.map/ and nothing else reads or writes it, so editing a
# map on one server cannot change what another is playing. The container
# always mounts it at /lsd/maps whatever the host path is, so nothing
# inside the server -- world_editor's layouts included -- has to care.
mapsd_for() { printf '%s/%s.map' "$INSTANCES_DIR" "$1"; }

# read a key from an env file, empty if unset
env_get_file() {
	[ -f "$2" ] && sed -n "s/^$1=//p" "$2" | tail -1 || true
}

# on/off settings: anything but an explicit off value counts as on, so an
# unset key means on (matching the compose defaults)
flag_on() {
	case "${1:-}" in
	0|false|no|off|FALSE|NO|OFF) return 1 ;;
	*) return 0 ;;
	esac
}

# ports already claimed by any instance's env file
used_ports() {
	for f in "$INSTANCES_DIR"/*.env; do
		[ -f "$f" ] || continue
		env_get_file LSD_PORT "$f"
	done
}

list_instances() {
	[ -d "$INSTANCES_DIR" ] || { echo "no instances (lsdctl new <name>)"; return 0; }
	found=
	printf '%-16s %-7s %-10s %-8s %-4s %s\n' NAME PORT GAMEMODE LISTING DEV STATE
	for f in "$INSTANCES_DIR"/*.env; do
		[ -f "$f" ] || continue
		found=1
		name=$(basename "$f" .env)
		port=$(env_get_file LSD_PORT "$f")
		mode=$(env_get_file LSD_GAMEMODE "$f")
		if flag_on "$(env_get_file LSD_MASTERLIST "$f")"; then
			listing=public
		else
			listing=private
		fi
		if flag_on "$(env_get_file LSD_SCRIPTS_DEV "$f")"; then
			dev=on
		else
			dev=off
		fi
		if [ -n "$(docker compose -p "lsd-$name" ps -q lsd 2>/dev/null)" ]; then
			state=running
		else
			state=stopped
		fi
		printf '%-16s %-7s %-10s %-8s %-4s %s\n' \
			"$name" "${port:--}" "${mode:--}" "$listing" "$dev" "$state"
	done
	[ -n "$found" ] || echo "no instances (lsdctl new <name>)"
}

new_instance() {
	name=${1:-}; [ -n "$name" ] || usage 1
	shift || true
	port=
	while [ $# -gt 0 ]; do
		case "$1" in
		-p|--port) port=${2:-}; shift 2 ;;
		*) echo "unknown option: $1" >&2; usage 1 ;;
		esac
	done

	case "$name" in
	*[!a-zA-Z0-9_-]*) echo "error: instance name may only contain letters, digits, - and _" >&2; exit 1 ;;
	esac
	if reserved_name "$name"; then
		echo "error: '$name' is a reserved command, pick another name" >&2; exit 1
	fi
	[ ! -f "$(envf_for "$name")" ] || { echo "error: instance '$name' already exists" >&2; exit 1; }

	# auto-pick the next free port after the highest one in use
	if [ -z "$port" ]; then
		max=$(used_ports | sort -n | tail -1)
		port=$(( ${max:-32886} + 1 ))
	fi
	case "$port" in *[!0-9]*|'') echo "error: port must be a number" >&2; exit 1 ;; esac
	if used_ports | grep -qx "$port"; then
		echo "error: port $port is already used by another instance (lsdctl ls)" >&2; exit 1
	fi

	cp "$TEMPLATES_DIR/config.lua" "$(cfgf_for "$name")"

	# Every server gets its own maps. Seed the new folder by copying an
	# existing one, so a fresh instance can actually boot -- LSD_MAPS names
	# maps that have to exist somewhere. Preference goes to the legacy
	# shared pool if it is still around, else any other instance's folder.
	maps=$(mapsd_for "$name")
	mkdir -p "$maps"
	seed=
	if [ -d maps ] && ls maps/*.vxl >/dev/null 2>&1; then
		seed=maps
	else
		for other in "$INSTANCES_DIR"/*.map; do
			[ -d "$other" ] || continue
			[ "$other" = "$maps" ] && continue
			if ls "$other"/*.vxl >/dev/null 2>&1; then seed=$other; break; fi
		done
	fi
	maplist="hallway bridgewars pinpoint"
	if [ -n "$seed" ]; then
		cp -R "$seed/." "$maps/"
		# queue what was actually seeded: the stock default names maps
		# that may not exist here, and the server cannot rotate onto a
		# map that is not in its folder
		found=$(ls "$maps"/*.vxl 2>/dev/null | sed 's|.*/||; s|\.vxl$||' | tr '\n' ' ')
		[ -z "${found% }" ] || maplist=${found% }
		echo "seeded $maps from $seed: $maplist"
	else
		echo "note: $maps is empty -- add maps with: ./lsdctl $name map add <file|url>"
	fi

	# the env is a template too, so a new setting is added in one place
	# rather than buried in this script
	sed -e '/^#T#/d' \
	    -e "s|@NAME@|$name|g" \
	    -e "s|@PORT@|$port|g" \
	    -e "s|@MAPS@|$maplist|g" \
	    -e "s|@CONFIG@|$(cfgf_for "$name")|g" \
	    -e "s|@MAPSDIR@|$(mapsd_for "$name")|g" \
	    "$TEMPLATES_DIR/instance.env" > "$(envf_for "$name")"
	echo "created instance '$name' on port $port:"
	echo "  $(envf_for "$name")"
	echo "  $(cfgf_for "$name")"
	echo "  $maps/"
	echo "next: edit $(cfgf_for "$name"), then  ./lsdctl $name up"
}

rm_instance() {
	name=${1:-}; [ -n "$name" ] || usage 1
	envf=$(envf_for "$name")
	[ -f "$envf" ] || { echo "error: no instance '$name' (lsdctl ls)" >&2; exit 1; }
	vol=$(env_get_file LSD_RW_VOLUME "$envf")
	docker compose -p "lsd-$name" --env-file "$envf" down || true
	rm -f "$envf" "$(cfgf_for "$name")"
	echo "removed instance '$name' (config + env deleted)"
	maps=$(mapsd_for "$name")
	if [ -d "$maps" ]; then
		printf "also delete its maps '%s' (%s files)? [y/N] " \
		       "$maps" "$(ls -1 "$maps" 2>/dev/null | wc -l)"
		read -r ans || ans=n
		case "$ans" in
		y|Y) rm -rf "$maps"; echo "$maps removed" ;;
		*) echo "kept $maps" ;;
		esac
	fi
	if [ -n "$vol" ]; then
		printf "also delete its data volume '%s'? [y/N] " "$vol"
		read -r ans || ans=n
		case "$ans" in
		y|Y) docker volume rm "$vol" >/dev/null 2>&1 && echo "volume $vol removed" || echo "volume $vol not found" ;;
		*) echo "kept volume $vol (delete later: docker volume rm $vol)" ;;
		esac
	fi
}

# graduate a module from the in-development layer to the released one.
# A module is a <name>.lua plus, optionally, a <name>/ directory of its
# own submodules -- they move together or the module breaks.
promote_module() {
	[ $# -gt 0 ] || usage 1
	# git mv keeps the file staged as a rename; outside a work tree (or
	# for a file git doesn't know yet) a plain mv is all that's wanted
	if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
		tracked=1
	else
		tracked=
	fi
	for m in "$@"; do
		name=$(module_name "$m")
		[ -f "scripts.dev/$name.lua" ] || {
			echo "error: no scripts.dev/$name.lua to promote" >&2; exit 1; }
		[ ! -e "scripts.local/$name" ] || [ -d "scripts.dev/$name" ] || {
			echo "error: scripts.local/$name exists but scripts.dev/$name does not;" >&2
			echo "       move it out of the way first" >&2; exit 1; }

		for src in "scripts.dev/$name.lua" "scripts.dev/$name"; do
			[ -e "$src" ] || continue
			dst="scripts.local/${src#scripts.dev/}"
			[ ! -e "$dst" ] || rm -rf "$dst"
			if [ -n "$tracked" ] && git ls-files --error-unmatch "$src" >/dev/null 2>&1; then
				git mv -f "$src" "$dst"
			else
				mv "$src" "$dst"
			fi
			echo "promoted $src -> $dst"
		done
	done
	echo "released; instances running with the dev layer off pick it up on their next load"
}

# ---- per-instance helpers (operate on the current $INSTANCE / $ENVF) -----

# every docker compose call for the current instance goes through here
compose() { docker compose -p "lsd-$INSTANCE" --env-file "$ENVF" "$@"; }

# read/set a key in the current instance's env file
env_get() { env_get_file "$1" "$ENVF"; }
env_set() {
	grep -v "^$1=" "$ENVF" > "$ENVF.tmp" 2>/dev/null || true
	printf '%s=%s\n' "$1" "$2" >> "$ENVF.tmp"
	mv "$ENVF.tmp" "$ENVF"
	echo "$1=$2"
}

# pipe stdin into the current instance's in-game admin console, relaying replies
console_pipe() { compose exec -T lsd socat - UNIX-CONNECT:rw/console.sock; }

# on/off settings of the current instance, read from its .env
# this instance's map directory: an explicit LSD_MAPS_DIR wins, else the
# per-instance default. Instances created before maps were split have no
# LSD_MAPS_DIR and fall back to the old shared pool.
mapsd() {
	d=$(env_get LSD_MAPS_DIR)
	[ -n "$d" ] || d=$(mapsd_for "$INSTANCE")
	printf '%s' "${d#./}"
}

dev_on() { flag_on "$(env_get LSD_SCRIPTS_DEV)"; }
masterlist_on() { flag_on "$(env_get LSD_MASTERLIST)"; }

# container id of the running instance, empty when it isn't up
container_id() { compose ps -q lsd 2>/dev/null || true; }

# value the running container was created with (empty if not running or unset)
container_env() {
	cid=$(container_id)
	[ -n "$cid" ] || return 0
	docker inspect -f '{{range .Config.Env}}{{println .}}{{end}}' "$cid" \
		| sed -n "s/^$1=//p" | tail -1
}

# keys compose bakes into the container at create time: if the .env has
# moved on since, restarting in place would quietly run the old values.
# Prints the drifted keys and succeeds when there are any.
env_drifted() {
	drift=
	for k in LSD_PORT LSD_NAME LSD_GAMEMODE LSD_MAPS LSD_SCRIPTS_DEV LSD_MASTERLIST; do
		want=$(env_get "$k")
		[ -n "$want" ] || continue	# unset: the compose default applies
		got=$(container_env "$k")
		[ -n "$got" ] || continue	# not running: nothing to drift from
		[ "$want" = "$got" ] || drift="$drift $k"
	done
	[ -n "$drift" ] || return 1
	echo "${drift# }"
}

# reassemble the running container's scripts/ dir (same recipe as the
# entrypoint) so hotloads pick up the current script layers. The dev
# layer follows the .env, not the container's stale copy of it.
scripts_sync() {
	if dev_on; then dev=1; else dev=0; fi
	compose exec -T -e LSD_SCRIPTS_DEV="$dev" lsd sh -c \
		'find scripts -mindepth 1 -delete
		 cp -R scripts.dist/. scripts/
		 [ ! -d scripts.local ] || cp -R scripts.local/. scripts/
		 case "$LSD_SCRIPTS_DEV" in
		 0) ;;
		 *) [ ! -d scripts.dev ] || cp -R scripts.dev/. scripts/ ;;
		 esac'
}

module_name() { basename "$1" .lua; }

# which layer a module resolves from, in the order the entrypoint stacks
# them (last one copied wins). Fails with "!scripts.dev" when the only
# copy is one this instance's dev layer is switched off from.
module_layer() {
	if dev_on && [ -f "scripts.dev/$1.lua" ]; then
		echo scripts.dev
	elif [ -f "scripts.local/$1.lua" ]; then
		echo scripts.local
	elif [ -f "lsd/scripts/$1.lua" ]; then
		echo lsd/scripts
	elif [ -f "scripts.dev/$1.lua" ]; then
		echo '!scripts.dev'
		return 1
	else
		return 1
	fi
}

# run one per-instance subcommand against the current $INSTANCE / $ENVF
dispatch() {
	sub=$1; shift
	case "$sub" in
	up)
		compose up -d --build "$@"
		;;
	down)
		compose down "$@"
		;;
	restart)
		compose up -d --force-recreate
		;;
	reload)
		notice=${1:-"server reboots in 5 seconds to reload scripts, hold on..."}
		# announce, wait, then have the server exit itself: its clean shutdown
		# hooks run and the container's restart policy brings it back up (and
		# reassembles scripts/) without any docker call here. The dying server
		# breaks the console pipe, so success is checked by the container's
		# start timestamp, not the pipe status.
		cid=$(compose ps -q lsd)
		born=$(docker inspect -f '{{.State.StartedAt}}' "$cid")
		# a restart in place reuses the environment the container was
		# created with, so settings changed since then would silently
		# revert -- recreate in that case instead
		drifted=$(env_drifted) || drifted=
		{
			printf 'say %s\n' "$notice"
			sleep 5
			[ -n "$drifted" ] || printf 'exec os.exit(0)\n'
			sleep 1
		} | console_pipe >/dev/null 2>&1 || true
		if [ -n "$drifted" ]; then
			echo "$(basename "$ENVF") changed since the container started ($drifted),"
			echo "recreating it so the new values apply"
			compose up -d --force-recreate
		else
			sleep 2
			if [ "$(docker inspect -f '{{.State.StartedAt}}' "$cid")" = "$born" ]; then
				echo "console did not take the server down, restarting the hard way" >&2
				compose restart lsd
			fi
		fi
		compose ps --format 'table {{.Name}}\t{{.State}}\t{{.Status}}'
		;;
	status)
		compose ps --format 'table {{.Name}}\t{{.State}}\t{{.Status}}\t{{.Publishers}}'
		;;
	logs)
		compose logs "$@"
		;;
	console)
		compose exec lsd socat READLINE UNIX-CONNECT:rw/console.sock
		;;
	shell)
		compose exec lsd ash
		;;
	load)
		# catch typos before touching the server, and say which layer
		# each module comes from -- a dev copy shadowing a released one
		# is the whole point of the split, but it should never surprise
		for name in "$@"; do
			name=$(module_name "$name")
			if layer=$(module_layer "$name"); then
				if [ "$layer" = scripts.dev ]; then
					if [ -f "scripts.local/$name.lua" ]; then
						echo "note: $name comes from scripts.dev/ (shadows scripts.local/$name.lua)"
					else
						echo "note: $name comes from scripts.dev/"
					fi
				fi
				continue
			fi
			if [ "$layer" = '!scripts.dev' ]; then
				echo "error: '$name' only exists in scripts.dev/ and the dev layer is off on '$INSTANCE'" >&2
				echo "       turn it on with: ./lsdctl $INSTANCE dev on" >&2
			else
				echo "error: no module '$name' (no $name.lua in lsd/scripts/, scripts.local/ or scripts.dev/)" >&2
			fi
			exit 1
		done
		scripts_sync
		{
			if [ $# -eq 0 ]; then
				echo reloadall
			else
				for name in "$@"; do
					printf 'load %s\n' "$(module_name "$name")"
				done
			fi
			sleep 1
		} | console_pipe
		;;
	unload)
		[ $# -gt 0 ] || usage 1
		{
			for name in "$@"; do
				printf 'unload %s\n' "$(module_name "$name")"
			done
			sleep 1
		} | console_pipe
		;;
	lsmod)
		{ echo lsmod; sleep 1; } | console_pipe
		;;
	edit)
		# world_editor's edit mode is deliberately console-only, so this
		# is the sanctioned way in. Nothing to do if the script isn't
		# loaded -- say so instead of leaving a silent no-op.
		what=${1:-status}
		case "$what" in
		on|off|status) ;;
		*) echo "usage: lsdctl <instance> edit [on|off|status]" >&2; exit 1 ;;
		esac
		if ! { echo lsmod; sleep 1; } | console_pipe 2>/dev/null | grep -q world_editor; then
			echo "error: world_editor is not loaded on '$INSTANCE'" >&2
			echo "       load it with: ./lsdctl $INSTANCE load world_editor" >&2
			echo "       (and add \`load \"world_editor\"\` to instances/$INSTANCE.config.lua to persist)" >&2
			exit 1
		fi
		{ printf 'worldedit %s\n' "$what"; sleep 1; } | console_pipe
		;;
	dev)
		# whether this instance stacks scripts.dev/ on scripts.local/.
		# Toggling reassembles scripts/ and reloads every module, which
		# is a script-level change only: nobody gets disconnected.
		what=${1:-status}
		case "$what" in
		on) env_set LSD_SCRIPTS_DEV 1 >/dev/null ;;
		off) env_set LSD_SCRIPTS_DEV 0 >/dev/null ;;
		status) ;;
		*) echo "usage: lsdctl <instance> dev [on|off|status]" >&2; exit 1 ;;
		esac
		if dev_on; then setting=on; else setting=off; fi
		if [ -z "$(container_id)" ]; then
			echo "dev layer: $setting (applies at next start)"
		elif [ "$what" = status ]; then
			echo "dev layer: $setting"
			live=$(container_env LSD_SCRIPTS_DEV)
			if [ -n "$live" ] && ! flag_on "$live" && [ "$setting" = on ]; then
				echo "           (the container was created without it;" \
				     "load/reload applies it anyway)"
			fi
		else
			scripts_sync
			{ echo reloadall; sleep 1; } | console_pipe
			echo "dev layer $setting on '$INSTANCE' (scripts reassembled and reloaded)"
		fi
		;;
	masterlist)
		# public listing on/off. Applied live over the console so an
		# instance can go quiet mid-game without dropping its players;
		# the .env keeps it across restarts.
		what=${1:-status}
		case "$what" in
		on) env_set LSD_MASTERLIST 1 >/dev/null ;;
		off) env_set LSD_MASTERLIST 0 >/dev/null ;;
		status) ;;
		*) echo "usage: lsdctl <instance> masterlist [on|off|status]" >&2; exit 1 ;;
		esac
		if masterlist_on; then setting="on (public)"; else setting="off (unlisted)"; fi
		if [ -z "$(container_id)" ]; then
			echo "masterlist: $setting (applies at next start)"
		elif [ "$what" = status ]; then
			echo "masterlist: $setting"
			if { echo lsmod; sleep 1; } | console_pipe 2>/dev/null | grep -q masterlist; then
				echo "live:       announcing"
			else
				echo "live:       not announcing"
			fi
		else
			# the console's load unloads first, so both ways are idempotent
			if [ "$what" = on ]; then verb=load; else verb=unload; fi
			{ printf '%s masterlist\n' "$verb"; sleep 1; } | console_pipe
			echo "masterlist $setting on '$INSTANCE' (applied live, nobody disconnected)"
			if [ "$what" = off ]; then
				echo "note: unlisted is not private -- ip:port still lets anyone join"
			fi
		fi
		;;
	map)
		# every path here is this instance's own map folder; another
		# server's maps are none of its business
		md=$(mapsd)
		msub=${1:-list}; [ $# -gt 0 ] && shift
		case "$msub" in
		list)
			echo "$md:"
			ls -lh "$md"/*.vxl 2>/dev/null || echo "  no maps installed"
			;;
		add)
			[ $# -gt 0 ] || usage 1
			mkdir -p "$md"
			for src in "$@"; do
				case "$src" in
				http://*|https://*)
					curl -fSL -o "$md/$(basename "$src")" "$src";;
				*)
					cp -v "$src" "$md/";;
				esac
			done
			echo "installed into $md; maps are picked up at the next rotation," \
			     "add them to LSD_MAPS to queue them: ./lsdctl $INSTANCE set LSD_MAPS '...'"
			;;
		rm)
			[ $# -gt 0 ] || usage 1
			for name in "$@"; do
				rm -v "$md/${name%.vxl}.vxl"
			done
			;;
		load)
			[ $# -eq 1 ] || usage 1
			name=${1%.vxl}
			if [ ! -f "$md/$name.vxl" ]; then
				echo "error: no map '$md/$name.vxl' (see ./lsdctl $INSTANCE map list)" >&2
				exit 1
			fi
			# switch the running server's map now -- no restart, nobody
			# disconnects; the in-game loadmap takes the name, not the path
			{ printf 'loadmap %s\n' "$name"; sleep 1; } | console_pipe
			;;
		*)
			usage 1;;
		esac
		;;
	gamemode)
		if [ $# -eq 0 ]; then
			mode=${LSD_GAMEMODE:-$(env_get LSD_GAMEMODE)}
			echo "${mode:-ctf}"
		else
			if ! module_layer "$1" >/dev/null; then
				echo "error: no gamemode '$1' (no $1.lua in lsd/scripts/, scripts.local/ or scripts.dev/)" >&2
				exit 1
			fi
			env_set LSD_GAMEMODE "$1"
			compose up -d --force-recreate
		fi
		;;
	set)
		[ $# -eq 2 ] || usage 1
		# guard against giving two instances the same port
		if [ "$1" = LSD_PORT ]; then
			if used_ports | grep -vx "$(env_get LSD_PORT)" | grep -qx "$2"; then
				echo "error: port $2 is already used by another instance (lsdctl ls)" >&2; exit 1
			fi
		fi
		env_set "$1" "$2"
		compose up -d --force-recreate
		;;
	help|-h|--help)
		usage
		;;
	*)
		usage 1
		;;
	esac
}

# fan a per-instance subcommand out over every instance
for_all() {
	sub=${1:-}; [ -n "$sub" ] || usage 1
	shift
	any= rc=0
	for f in "$INSTANCES_DIR"/*.env; do
		[ -f "$f" ] || continue
		any=1
		INSTANCE=$(basename "$f" .env)
		ENVF=$f
		printf '\n== %s ==\n' "$INSTANCE"
		dispatch "$sub" "$@" || { rc=1; echo "  ($INSTANCE: '$sub' exited nonzero)" >&2; }
	done
	[ -n "$any" ] || { echo "no instances (lsdctl new <name>)"; return 0; }
	return "$rc"
}

# ---- top-level dispatch --------------------------------------------------

cmd=${1:-}
[ -n "$cmd" ] || usage 1

case "$cmd" in
ls|list) list_instances; exit 0 ;;
new) shift; new_instance "$@"; exit 0 ;;
rm) shift; rm_instance "$@"; exit 0 ;;
promote) shift; promote_module "$@"; exit 0 ;;
update) exec ./update.sh ;;
all) shift; for_all "$@"; exit 0 ;;
help|-h|--help) usage ;;
esac

# <command>All / <command>all: fan the base per-instance command out over
# every instance (guarded so an instance whose name ends in "all" is safe)
base=
case "$cmd" in
*All) base=${cmd%All} ;;
*all) base=${cmd%all} ;;
esac
if [ -n "$base" ] && is_instance_command "$base"; then
	shift; for_all "$base" "$@"; exit 0
fi

# everything else: <instance> <subcommand> [args]
INSTANCE=$cmd
ENVF=$(envf_for "$INSTANCE")
[ -f "$ENVF" ] || { echo "error: no instance '$INSTANCE' (lsdctl ls)" >&2; exit 1; }
shift
sub=${1:-}; [ -n "$sub" ] || usage 1
shift
dispatch "$sub" "$@"
