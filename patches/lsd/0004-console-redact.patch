+-- A command line as it may be logged: a sensitive command's arguments
+-- (passwords) replaced. Consoles that log a line themselves log this.
+function command_log_text(msg)
+	local argv = unquote_to_table(msg);
+	local cmd = argv[0] and commands[string.lower(argv[0])];
+	if (cmd and cmd.sensitive) then
+		return argv[0].." [REDACTED]";
+	end
+	return msg;
+end
