+-- Accounts administered by someone else: an admin, or the server's own
+-- console, creates, resets and deletes them without the player present.
+-- TODO: a deleted or reset account stays logged in where it is until logout
+
+local cmd = {name="useradd", caps="useradd", fakepid=true, sensitive=true, usage="name password [caps...]", desc="Create an account, with its capabilities."};
+function cmd.func(pid, argv)
+	cmd_assert(pid, cmd, #argv >= 2);
+
+	local name = argv[1];
+	if (getpasswd(name) ~= nil) then
+		l10n_send_chat(pid, name_taken_msg);
+		return;
+	end
+
+	assert(useradd(name, hash_pass(pid, name, argv[2])) == 1, "useradd: rows inserted != 1");
+	if (#argv > 2) then
+		setcaps(table.concat(argv, " ", 3), name);
+	end
+	l10n_send_chat(pid, account_created_msg, {name=name});
+end
+register_command(cmd, mod);
+
+local cmd = {name="userpasswd", caps="userpasswd", fakepid=true, sensitive=true, usage="name password", desc="Set an account's password."};
+function cmd.func(pid, argv)
+	cmd_assert(pid, cmd, #argv == 2);
+
+	local name = argv[1];
+	if (getpasswd(name) == nil) then
+		l10n_send_chat(pid, no_user_msg);
+		return;
+	end
+
+	assert(setpasswd(hash_pass(pid, name, argv[2]), name) == 1, "userpasswd: rows updated != 1");
+	l10n_send_chat(pid, password_set_msg, {name=name});
+end
+register_command(cmd, mod);
+
+local cmd = {name="userdel", caps="userdel", fakepid=true, usage="name", desc="Delete an account."};
+function cmd.func(pid, argv)
+	cmd_assert(pid, cmd, #argv == 1);
+
+	if (userdel(argv[1]) ~= 1) then
+		l10n_send_chat(pid, no_user_msg);
+		return;
+	end
+	l10n_send_chat(pid, account_deleted_msg, {name=argv[1]});
+end
+register_command(cmd, mod);
+
+-- An account's name and capabilities, or nil.
+function mod.impl.auth_account(name)
+	local vals = getpasswd(name);
+	if (vals == nil) then
+		return nil;
+	end
+	return {name=vals[1], caps=vals[2]};
+end
+
+-- Every account, by name: {name=, caps=}.
+function mod.impl.auth_accounts()
+	local list = {};
+	for name, caps in userlist() do
+		list[#list+1] = {name=name, caps=caps};
+	end
+	return list;
+end
+
