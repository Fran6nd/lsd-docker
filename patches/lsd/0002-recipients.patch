+/* Use this for iterating over the RECIPIENTS of a BROADCAST_* pid: the slots
+ * pid_matches() accepts that have a client to send to. A bot is a player
+ * with no network peer; it is still a subject (damage, positions, piditer)
+ * but never a recipient, so a loop that sends or asks has_quirk() on behalf
+ * of a recipient must not visit it. */
+extern int pid_recipient(plid broadcast, plid pid, struct State *st) {
+	return st->p[pid].peer != NULL && pid_matches(broadcast, pid, st);
+}
