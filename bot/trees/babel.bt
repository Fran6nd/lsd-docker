# babel.bt -- babel: build your team's stair to the platform in the sky,
# take the intel there and bring it home; break theirs, shoot their
# builders.
#
# The engine knows no tower. The gamemode's script (catalog/gamemodes/
# babel/babel_plus.lua) lays each team's stair out and tells each team,
# through the bridge (bot/TREES.md section 13; the world's "<name>@<team>",
# which a bot reads under the bare name):
#   @stair       the next step of its team's stair to build (build_at):
#                from the ground up, so a stair cut is built again from
#                the cut
#   @stair_top   the highest step built, to stand on and watch from
#   @stair_foot  the ground at the stair's foot
#   @widen       the next block of the second row beside it (put_at)
#   @prop        the next block of a pillar beside its weakest stretch,
#                from the ground up to the step (build_at: stood on as it
#                rises)
#   @breach      the OTHER team's stair where it is weakest (dig_weakest:
#                the block there whose removal drops the most)
#   @intel       the intel: where it lies, or the man who carries it
#   fact stair_done  1 when its team's stair reaches the platform
#   fact stair_high  how far up its team's stair is, 0 to 1
#   fact widen, fact prop   1 while there is such a block to put
#   fact breach      1 when the other team's stair is worth breaking
# and sends edit=all (a tower is built), and these only when engine bots
# are playing. Who carries the intel the engine reads from the world:
# babel's one intel is the one both teams go for (`carrying_intel`,
# `their_intel_carried` -- a mate has it --, `our_intel_taken` -- one of
# theirs has it).
#
# The top `pick` is a priority list looked at every second; `babel_role`
# under it is a ROLE drawn once for each bot and kept in every life
# (`pick roll=once`): builders, masons, guards, snipers, raiders, runners
# -- by character.

tree babel:
select
	pick every=1 sticky=0.2 noise=0
		option none fact peace x1000          # the players voted peace: nobody fights
			tree babel_peace
		option none grenade_near x100         # a grenade at its feet: run
			do evade
		option none harmful_water x60         # wading in water that hurts: out, first
			do leave_water
		option none has_order x30             # the server said so
			do obey
		option none carrying_intel x40        # it has the intel: home with it, wide of the enemies it knows
			do carry_home
		option none stranded x20              # no way from here: hold and watch, shoot from there
			tree babel_stranded
		option none under_fire x10            # being shot at
			tree babel_under_fire
		option none enemy_visible 3 x5        # somebody in sight, or just gone behind something: the fight it is in
			tree babel_contact
		option teamwork their_intel_carried x1.5   # a mate carries it home: with him
			do escort
		option aggression our_intel_taken x1.5     # one of theirs carries it: cut him off
			do intercept
		option none always                    # the game
			tree babel_role
	limit 1
		do seek                               # the net: the enemy's base

# Peace (the server's `fact peace`): no bot starts a fight, throws a
# grenade, breaks the other stair or answers a shot -- everybody builds:
# the stair, then its second row and props, and the intel once the way is
# there, brought home shooting nobody. Looked at every second: the war is
# back within one of the peace's end.
tree babel_peace:
pick every=1 sticky=0.2 noise=0
	option none harmful_water x60             # wading in water that hurts: out, first
		do leave_water
	option none has_order x30                 # the server said so
		do obey
	option none carrying_intel x40            # it has the intel: home with it, shooting nobody
		do carry_home 0
	option none always
		tree babel_peace_duty

tree babel_peace_duty:
select
	seq
		unless fact stair_done
		do build_at @stair
	pick every=10 sticky=0.5 noise=0.1
		option none their_intel_home x3       # the way is there: the intel
			do fetch
		option none their_intel_dropped x4
			do fetch
		option none fact widen x2             # the second row, a block at a time
			do put_at @widen
		option none fact prop                 # a prop, from the ground up
			do build_at @prop
		option none always x0.1               # all done: watch from the top
			do hold @stair_top 30

# A role for good, by character: most build (the builder trait, which
# nothing else used) -- the stair, then making it hold --, the careful
# guard their stair's foot, rifles with an eye for it snipe from the
# stair, the bold break the other stair, the keen on the game build until
# the way is there and then run for the intel.
tree babel_role:
pick roll=once
	option builder always x1.2                # a builder: the stair, then the intel or the stair made to hold
		tree babel_builder
	option builder always x0.6                # a mason: the stair made to hold, and mended
		tree babel_mason
	option objective always x0.8              # a runner: builds, then goes for the intel
		tree babel_runner
	option marksman gun_is rifle x0.6         # a sniper: up its stair, shooting their builders
		tree babel_sniper
	option caution always x0.5                # a guard: the stair's foot, where it can be broken
		tree babel_guard
	option aggression always x0.5             # a raider: their stair, where it is weakest
		tree babel_raider

# The stair first -- up, or mended where it was cut.
tree babel_builder:
select
	seq
		unless fact stair_done
		do build_at @stair
	pick every=10 sticky=0.5 noise=0.1
		option objective their_intel_home x0.8    # the way is there: the intel
			do fetch
		option objective their_intel_dropped x2   # lying where a carrier fell
			do fetch
		option builder always                     # or the stair made to hold
			tree babel_mason

# Mended first; then a second row beside it, so that a block dug leaves
# the other holding it; then props under its weakest stretch. Nothing to
# do: watching from its top.
tree babel_mason:
select
	seq
		unless fact stair_done
		do build_at @stair
	pick every=10 sticky=0.5 noise=0.1
		option none fact widen x2                 # the second row, a block at a time
			do put_at @widen
		option none fact prop                     # a prop, from the ground up
			do build_at @prop
		option none always x0.1                   # all done: watch from the top
			do guard @stair_top 30

tree babel_runner:
select
	seq
		unless fact stair_done
		do build_at @stair
	pick every=5 sticky=0.5 noise=0.1
		option none their_intel_home x3           # the way is there: the intel
			do fetch
		option none their_intel_dropped x4
			do fetch
		option none always x0.3                   # somebody has it: near the top, ready
			do guard @stair_top 20

tree babel_sniper:
pick every=20 sticky=0.5 noise=0
	option none fact stair_high x3            # its stair up a third of the way or more: climb it, watch from there
		seq
			do go_to @stair_top 2
			do camp 40
	option none always                        # not yet: watch from the foot
		do guard @stair_foot 30

tree babel_guard:
pick every=20 sticky=0.5 noise=0
	option none always
		do guard @stair_foot 40

# Their stair, where it is weakest; a cut made, a while before the next
# (what fell must be built again: the cut is the point). Nothing to break:
# the intel, or their base.
tree babel_raider:
pick every=10 sticky=0.5 noise=0.1
	option none fact breach x3
		select
			cooldown 15
				tree babel_cut
			do seek
	option none their_intel_home x1           # nothing to break: the intel
		do fetch
	option none always                        # their base: whoever is about
		do seek

# The cut, at their stair's weakest block (dig_weakest chooses it): with a
# weapon it holds that breaks blocks, from where it stands -- the greedy
# use what they have -- else its grenades if one lands there, else the
# spade.
tree babel_cut:
pick every=10 sticky=0.5 noise=0
	option greed has_item rocket x2
		do dig_weakest @breach 6 rocket
	option greed has_item missile x2
		do dig_weakest @breach 6 missile
	option greed has_item grenade_launcher x1.5
		do dig_weakest @breach 6 grenade_launcher
	option greed has_item airstrike x1.5
		do dig_weakest @breach 6 airstrike
	option none always
		do dig_weakest @breach

# Shot at: down, then cover in view or face him; or fight back.
tree babel_under_fire:
seq
	do crouch                                 # the flinch, facing the shot
	pick every=2.5 sticky=0.5 noise=0.2
		option aggression enemy_visible       # fight back from where it stands
			do fight
		option builder under_fire x0.6        # no cover in view: a wall where it stands, then down behind it
			tree babel_wall_up
		option caution under_fire x1.1        # to cover it can see, facing him; none: face him
			select
				seq
					if cover_in_view
					do take_cover in_view
				do crouch 3
		option caution pressed x0.6           # hurt AND outnumbered, or no round left: back, from cover to cover, facing them
			do fall_back_by_cover
		option builder always x0.4            # a builder goes on building under fire
			do build_at @stair

# An enemy in sight.
tree babel_contact:
pick every=1.5 sticky=0.3 noise=0.15
	option caution pressed x0.8               # hurt AND outnumbered, or no round left: break off, facing them
		do fall_back_by_cover
	option aggression enemy_visible           # fight him
		do fight
	option marksman standoff x1.1             # in reach and far enough: stand and shoot
		do hold self 4
	option builder enemy_far 60 x0.8          # far off: the stair matters more
		do build_at @stair
	option greed grenade_worth x0.8
		do throw_grenade
	option none enemy_visible 3 x0.5          # he has just gone behind something: here, watching for him
		do hold self 3

tree babel_stranded:
select
	seq
		if enemy_visible
		do fight
	seq
		if under_fire
		do crouch 3
	pick every=30 sticky=0.5 noise=0
		option marksman always                # its height a vantage: a walkway toward their base, and camp there
			select
				seq
					do build_perch enemy_base
					do camp 60
				do hold self 10
		option aggression always x0.8
			select
				seq
					do build_perch enemy_base
					do camp 60
				do hold self 10
		option caution always x0.6
			do hold self 10

tree babel_also:
seq
	always
		tree extras                           # what the server's scripts add (night and lamps, if it has them)
	always
		select
			if fact peace                     # at peace nothing is used on anyone
			tree items                            # whatever it holds, used as each item says

# Shot at with no cover in view, building allowed: a wall put up where
# it stands toward the man (two high, one to three wide), then down
# behind it; at its next choice, it is cover in view to fight from. With
# cover in view already: to it.
tree babel_wall_up:
select
	seq
		unless cover_in_view
		do build_cover
		do crouch 3
	do take_cover in_view
