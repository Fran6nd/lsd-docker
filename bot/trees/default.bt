# default.bt -- what a bot does in a mode that brought no tree of its own:
# go and find the other team, fight what it meets, take cover when shot
# at, look into what it hears.
#
# The words are core/vocab.h's, the grammar core/bt.h's. To know before
# copying this:
#   - `pick` chooses again every `every` seconds, by score x the bot's own
#     trait x a little luck. It is how a bot changes its mind: seq and select
#     remember where they were. Give an option a score that is 0 when its
#     action cannot be done, or the pick fails on it.
#   - "<name>_also" is ticked beside "<name>" at every decision: items,
#     pings, the server's extras -- actions that end at once.
#   - Nothing here knows of night or flashlights: a server that has them
#     sends that part itself (`tree extras`).
#   - `seek` is the last resort: to the enemy's base where the world has
#     bases, roaming where it has none.

tree default:
select
	pick every=1.5 sticky=0.3 noise=0.15
		option none grenade_near x100         # a grenade at its feet: run
			do evade
		option none harmful_water x60         # wading in water that hurts: out, first
			do leave_water
		option none has_order x30             # the server said so
			do obey
		option caution under_fire x1.5        # shot at: to cover, and fight from it
			tree default_cover
		option aggression enemy_visible x1.2  # fight him
			do fight
		option curiosity search x0.6          # a noise, a man lost, a hit from somewhere
			do investigate
		option flank flank_open x0.2          # round to the enemy's base, now and then
			do flank
		option none always x0.3               # never stand without a reason
			do seek
	limit 1
		do seek

tree default_cover:
seq
	do crouch                                 # the flinch, facing the shot
	select
		seq
			if cover_in_view              # cover it can see as it faces him
			do take_cover in_view         # there, its eyes on him all the way
		do crouch 3                       # none: down where it stands, facing him

tree default_also:
seq
	always
		tree extras                           # what the server's scripts add (night and lamps, if it has them)
	always
		tree items                            # whatever it holds, used as each item says
