.env

# maps are content, not source: heavy binary .vxl files stay out of git.
# Each instance owns instances/<name>.map/; the layouts world_editor
# writes beside them are small text and are kept.
maps/*.vxl
instances/*.map/*.vxl
# world_editor's component layouts sit beside the .vxl they belong to and
# are map content in the same way -- authored per server, not source
maps/*.editor.json
instances/*.map/*.editor.json

# patches exported for upstream (regenerate: git -C lsd format-patch -1)
/*.patch

# local tooling / scratch
.claude/
tmp-bot-script-advanced.py
