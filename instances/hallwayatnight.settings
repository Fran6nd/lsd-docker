# instances/hallwayatnight.settings -- Fran6nd's Hallway At Night
#
# A real config: values and comments, no code. Read by lib_settings,
# which config.lua loads first; every module then keeps whatever this
# file set and defaults only what it left alone.
#
# Portable on purpose. Unlike instances/hallwayatnight.env this is read by Lua
# rather than by docker, so a natively run `./server -c config.lua`
# honours it too.
#
# Syntax is the one LSd already reads out of map sidecars:
#   name = 'text'        name = "text with an apostrophe's"
#   flag = True          flag = False
#   number = 300         hex = 0x33
#   tuple = (128, 232, 255)
#   list  = ['a', 'b']
#   map   = {key: value}     # may span lines
# Anything after an unquoted # or ; is a comment.

# Server name shown in the server lists.
masterlist_name = "Fran6nd's Hallway At Night"

# Announce this server to the public server lists.
masterlist_enabled = True

# Gamemode module: ctf, arena, babel, ffa, dd, or hostage.
gamemode = 'ctf'

# Maps to play, space separated, in order. Empty plays every .vxl in the
# instance's map folder.
map_rotation = 'hallway'

# Night instead of day. The client draws full darkness: nothing lights
# the world and the sky is black, so a flashlight is the only light.
daytime_night = True

# How many players this server will seat. 255 is every id the protocol
# has, handed out as 0-254 with 255 left to the server. A client that
# cannot handle a large id may be handed one, so drop to 32 if old
# clients fall over.
player_limit_max = 255

# What a MISSING extension costs a client, and whether it is offered at
# all. Every extension this server registers is listed below -- the
# whole picture, not a list of exceptions -- so there is nothing to look
# up and nothing hiding behind a default.
#
#   'disabled'     not offered. The module stays loaded but the
#                  extension is left out of the handshake, so no client
#                  can use it. This is the off switch.
#   'applied'      offered and used, silently. A client without it is
#                  never told and never hindered.
#   'recommended'  as applied, plus the client is told what it is
#                  missing, and told again periodically.
#   'required'     the client is held in spectator until it updates.
#
# Every extension the server registers is named below, so there
# is no default to set: one would be a second place for the answer
# to live, and an invisible one. A registered extension missing
# from the table is reported in the log and runs as 'applied'.

# Flashlight and Daytime and Weather are the price of entry here:
# without them a client sees a black sky over a fully lit world, which
# is the easy version of this map.
ext_policy = {
	0x33: 'required',      # Daytime and Weather -- the dark itself
	0x32: 'required',      # Flashlight -- the only light there is
	0x20: 'recommended',   # Damage Markers -- hit numbers
	  48: 'recommended',   # Teamplay -- team ESP, pings, north
	 192: 'recommended',   # Player Limit -- the full player id range
	 193: 'recommended',   # Message Types -- warnings and notices
}

# Guard bots kept alive per team: 50 a side is 100 in all.
guard_count = 50

# Guards keep their flashlight lit while alive, so they are seen coming.
guard_flashlight = True

# A grenade going off nearby shakes every flashlight in reach into a
# flicker that settles over a few seconds.
flashlight_blast = True

# Advertise humans only: keep bots out of the published player count.
bot_hide_from_masterlist = True

# Message of the day, shown on join. A list of lines.
motd = [
	"Welcome to Fran6nd's Hallway At Night, running [LSd].",
	"It is night here, and it does not get light. Press F for your torch.",
	"Your client must support the Flashlight and Daytime extensions.",
]

# Tips shown in rotation.
tips = [
	"Press F for your flashlight. It is the only light there is.",
	"Ping what you cannot describe: your team sees the marker.",
	"Use /kill to die.",
]

# Everything this server loads, in order -- and the order is not a
# preference, it is a set of constraints. lib_ext must precede the
# extensions that register with it; the gamemode must precede tentspawns
# and lib_bot; a rider like hostage must follow lib_bot so lib_bot's own
# spawn_at stays outermost.
#
# Two entries are positions rather than modules:
#   @gamemode        the base mode, from `gamemode` above
#   @gamemode_extra  its rider, if the mode has one (hostage on ctf)
#
# `masterlist` is loaded only when masterlist_enabled is true.
#
# Named load_order and not `modules`: core.lua already uses a global
# called `modules` for its registry of loaded module tables
# (core.lua:55), and a settings key of that name overwrote it with a
# list of strings -- which broke register/unregister and threw on
# every shutdown.
load_order = [
	'group_deps',
	'group_commands',
	'group_moderation',
	'group_feature',
	'masterlist',
	'sock_console',
	'trashheap',
	'motd',
	'tip_spam',
	'lib_ext',
	'lib_player_limit',
	'lib_message_types',
	'lib_ext_policy',
	'lib_daytime',
	'lib_flashlight',
	'lib_teamplay',
	'lib_damage_markers',
	'votekick',
	'group_world_editor',
	'@gamemode',
	'tentspawns',
	'lib_bot',
	'@gamemode_extra',
	'bot_standard',
]
