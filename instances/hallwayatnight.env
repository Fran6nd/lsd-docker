# hallwayatnight instance
LSD_PORT=32891
LSD_CONFIG_FILE=./instances/hallwayatnight.config.lua
# this server's own maps; nothing else reads or writes them
LSD_MAPS_DIR=./instances/hallwayatnight.map
LSD_RW_VOLUME=lsd-hallwayatnight-rw
# run the in-development scripts.dev/ layer (0 = released scripts only)
LSD_SCRIPTS_DEV=1
# the declarative settings file lib_settings reads (portable; unlike
# this .env, it works for a natively run LSd too)
LSD_SETTINGS_FILE=./instances/hallwayatnight.settings

# LSD_NAME, LSD_GAMEMODE, LSD_MAPS and LSD_MASTERLIST are NOT here:
# this instance reads them from instances/hallwayatnight.settings instead, as
# masterlist_name, gamemode, map_rotation and masterlist_enabled. That
# file is read by Lua, so it works for a natively run LSd too -- which
# nothing in this .env does.
