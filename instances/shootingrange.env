# shootingrange instance
LSD_PORT=32890
# Rotation follows this server's map folder: add a .vxl and it plays,
# delete it and it stops. Uncomment to pin the order or play a subset.
# the ONE shared config, used by every instance: it decides only the
# order things load in. Everything else is in the .settings file.
LSD_CONFIG_FILE=./config.lua
# this server's own maps; nothing else reads or writes them
LSD_MAPS_DIR=./instances/shootingrange.map
LSD_RW_VOLUME=lsd-shootingrange-rw
# run the in-development scripts.dev/ layer (0 = released scripts only)
LSD_SCRIPTS_DEV=1
# announce this instance to the public server lists (0 = unlisted)

# the declarative settings file lib_settings reads (portable; unlike
# this .env, it works for a natively run LSd too)
LSD_SETTINGS_FILE=./instances/shootingrange.settings

# LSD_NAME, LSD_GAMEMODE, LSD_MAPS and LSD_MASTERLIST are NOT here:
# this instance reads them from instances/shootingrange.settings instead, as
# masterlist_name, gamemode, map_rotation and masterlist_enabled.
