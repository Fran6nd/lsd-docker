# shootingrange instance
LSD_PORT=32890
LSD_NAME=Fran6nd's Shooting Range
LSD_GAMEMODE=ctf
# Rotation follows this server's map folder: add a .vxl and it plays,
# delete it and it stops. Uncomment to pin the order or play a subset.
LSD_MAPS=Range
LSD_CONFIG_FILE=./instances/shootingrange.config.lua
# this server's own maps; nothing else reads or writes them
LSD_MAPS_DIR=./instances/shootingrange.map
LSD_RW_VOLUME=lsd-shootingrange-rw
# run the in-development scripts.dev/ layer (0 = released scripts only)
LSD_SCRIPTS_DEV=1
# announce this instance to the public server lists (0 = unlisted)
LSD_MASTERLIST=1
