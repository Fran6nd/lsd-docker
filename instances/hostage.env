# hostage instance -- the original single-instance server, migrated as-is.
# Keeps LSD_RW_VOLUME=lsd-rw so it re-adopts the existing bans/auth data.
LSD_PORT=32887
LSD_NAME=Fran6nd's Hostage server
LSD_GAMEMODE=hostage
# rotation follows instances/hostage.map/ -- uncomment to pin the order
#LSD_MAPS=hallway Penthouse Prauda Remus
LSD_CONFIG_FILE=./instances/hostage.config.lua
LSD_RW_VOLUME=lsd-rw
# run the in-development scripts.dev/ layer (0 = released scripts only)
LSD_SCRIPTS_DEV=1
# announce this instance to the public server lists (0 = unlisted)
LSD_MASTERLIST=1
# this server's own maps; nothing else reads or writes them
LSD_MAPS_DIR=./instances/hostage.map
