# instances/shootingrange.settings -- Fran6nd's Shooting Range
#
# A real config: values and comments, no code. Read by lib_settings,
# which config.lua loads first; every module then keeps whatever this
# file set and defaults only what it left alone.
#
# Portable on purpose. Unlike instances/shootingrange.env this is read by Lua
# rather than by docker, so a natively run `./server -c config.lua`
# honours it too.
#
# Syntax is the one LSd already reads out of map sidecars:
#   name = 'text'        name = "text with an apostrophe's"
#   flag = True          flag = False
#   number = 300         hex = 0x33
#   tuple = (128, 232, 255)   list = ['a', 'b']   map = {key: value}
# Anything after an unquoted # or ; is a comment.
#
# Everything the loaded modules support:
#   ./lsdctl shootingrange settings --template
# Apply an edit without restarting:
#   ./lsdctl shootingrange settings reload

# Server name shown in the server lists.
masterlist_name = "Fran6nd's Shooting Range"

# Announce this server to the public server lists.
masterlist_enabled = True

# Advertise humans only. The aosbot fleet pointed at this server dials
# in over UDP and completes the handshake like any client, so without
# this it would be advertised as a hundred players who are not there --
# which is indistinguishable from padding the count to climb the list,
# and is what a list operator delists a server for. lib_headless reads
# the ident out of the version handshake; lib_bot keeps the count.
bot_hide_from_masterlist = True
headless_idents = ['AosBot']

# Gamemode module: ctf, arena, babel, ffa, dd, or hostage.
gamemode = 'ctf'

# Maps to play, space separated, in order. Empty plays every .vxl
# in the instance's map folder.
map_rotation = 'Range'

# How many players this server will seat, 1 to 255. 32 is the value
# every client copes with.
player_limit_max = 255

# Night instead of day. By night nothing lights the world and the sky
# is black; only flashlights light it.
daytime_night = False

# What a MISSING extension costs a client, and whether it is offered at
# all. Every extension this server registers is listed below -- the
# whole picture, not a list of exceptions.
#
#   'disabled'     not offered; the module stays loaded but the
#                  extension is left out of the handshake
#   'applied'      offered and used, silently
#   'recommended'  as applied, plus the client is told what it misses
#   'required'     the client is held in spectator until it updates
#
# This is the level for anything somehow not listed below.
ext_policy_default = 'recommended'

ext_policy = {
	  0x20: 'recommended',  # Damage Markers
	    48: 'recommended',  # Teamplay
	  0x32: 'recommended',  # Flashlight
	  0x33: 'recommended',  # Daytime and Weather
	   192: 'recommended',  # Player Limit
	   193: 'recommended',  # Message Types
}

# Message of the day, shown on join. A list of lines.
motd = [
	"Welcome to Fran6nd's Shooting Range, running [LSd].",
	"One flat plain, 512 by 512, and nothing to hide behind.",
	"Shoot things and watch the damage numbers come back.",
]

# Tips shown in rotation.
tips = [
	"Flat map, no cover, damage numbers on. Sight your guns in.",
	"Damage numbers need a client that speaks the extension.",
	"Use /kill to die.",
]

# Everything this server loads, in order -- and the order is not a
# preference, it is a set of constraints. lib_ext must precede the
# extensions that register with it; the gamemode must precede tentspawns
# and lib_bot; a rider like hostage must follow lib_bot so lib_bot's own
# spawn_at stays outermost.
#
# Two entries are positions rather than modules:
#   @gamemode        the base mode, from `gamemode` above
#   @gamemode_extra  its rider, if the mode has one (hostage on ctf)
#
# `masterlist` is loaded only when masterlist_enabled is true.
#
# Named load_order and not `modules`: core.lua already uses a global
# called `modules` for its registry of loaded module tables
# (core.lua:55), and a settings key of that name overwrote it with a
# list of strings -- which broke register/unregister and threw on
# every shutdown.
load_order = [
	'group_deps',
	'group_commands',
	'group_moderation',
	'group_feature',
	'masterlist',
	'sock_console',
	'trashheap',
	'motd',
	'tip_spam',
	'lib_ext',
	'lib_player_limit',
	'lib_message_types',
	'lib_ext_policy',
	'lib_daytime',
	'lib_flashlight',
	'lib_teamplay',
	'lib_damage_markers',
	'votekick',
	'group_world_editor',
	'@gamemode',
	'tentspawns',
	'lib_bot',
	'lib_headless',
	'@gamemode_extra',
]
