#: catalog/core/lib_update_notice.lua
msgid "lsd-docker %(latest) is available; this server runs %(running). Update from the host: lsd update"
msgstr "Доступен lsd-docker %(latest); на сервере работает %(running). Обнови на хосте: lsd update"

#: catalog/overrides/afkick.lua
#: lsd/scripts/afkick.lua
msgid "%(name) was kicked: AFK"
msgstr "Игрок %(name) кикнут: AFK"

#: catalog/overrides/afkick.lua
#: lsd/scripts/afkick.lua
msgid "You will be automatically AFK-kicked in %(time) s"
msgstr "Ты будешь автоматически кикнут за AFK через %(time) с"

#: catalog/overrides/command_cmds.lua
#: lsd/scripts/command_cmds.lua
msgid "Command not found."
msgstr "Команда не найдена."

#: catalog/overrides/command_cmds.lua
#: lsd/scripts/command_cmds.lua
msgid "Were you looking for /commands?"
msgstr "Может, ты искал /commands?"

#: catalog/overrides/command_cmds.lua
#: lsd/scripts/command_cmds.lua
msgctxt "command"
msgid "Print an alphabetically ordered list of all commands."
msgstr "Вывести список всех команд по алфавиту."

#: catalog/overrides/command_cmds.lua
#: lsd/scripts/command_cmds.lua
msgctxt "command"
msgid "Filter through the list of commands. Does not parse arguments."
msgstr "Отфильтровать список команд. Аргументы не разбираются."

#: catalog/overrides/command_cmds.lua
#: lsd/scripts/command_cmds.lua
msgctxt "command"
msgid "Display the invocation and description of a command."
msgstr "Показать синтаксис и описание команды."

#: catalog/overrides/command_ignore.lua
#: lsd/scripts/command_ignore.lua
msgctxt "command"
msgid "Silence a player."
msgstr "Заглушить игрока."

#: catalog/overrides/command_secspec.lua
#: lsd/scripts/command_secspec.lua
msgctxt "command"
msgid "Stick yourself into spectator without anybody else knowing."
msgstr "Незаметно для всех перейти в наблюдатели."

#: catalog/overrides/command_ups.lua
#: lsd/scripts/command_ups.lua
msgid "%(arg) should be one of {%(freqs)} (Hz)"
msgstr "%(arg) должен быть одним из {%(freqs)} (Hz)"

#: catalog/overrides/command_ups.lua
#: lsd/scripts/command_ups.lua
msgid "Current update rate: %(freq) Hz"
msgstr "Текущая частота обновления: %(freq) Hz"

#: catalog/overrides/command_ups.lua
#: lsd/scripts/command_ups.lua
msgctxt "command"
msgid "Get/set the rate your client receives player position/orientation."
msgstr "Узнать/задать частоту, с которой клиент получает позиции/направления игроков."

#: catalog/overrides/lib_l10n.lua
msgid "usage: %(cmd)"
msgstr "использование: %(cmd)"

#: catalog/overrides/lib_l10n.lua
msgid "usage: %(cmd) %(args)"
msgstr "использование: %(cmd) %(args)"

#: catalog/overrides/lib_l10n.lua
msgid "Your language: %(lang). Available: %(list). Use /lang <code>, or /lang auto for your client's."
msgstr "Твой язык: %(lang). Доступны: %(list). Введи /lang <код> или /lang auto для языка клиента."

#: catalog/overrides/lib_l10n.lua
msgid "Language set to %(lang)."
msgstr "Язык изменён: %(lang)."

#: catalog/overrides/lib_l10n.lua
msgid "Language follows your client again: %(lang)."
msgstr "Язык снова как в клиенте: %(lang)."

#: catalog/overrides/lib_l10n.lua
msgid "No translations for %(lang) here; some messages stay in English."
msgstr "Переводов на %(lang) здесь нет; часть сообщений останется на английском."

#: catalog/overrides/lib_l10n.lua
msgid "%(lang) is not a language code (en, fr, pt_br, ...)."
msgstr "%(lang) -- не код языка (en, fr, pt_br, ...)."

#: catalog/overrides/lib_l10n.lua
msgid "Translations need %(clients); this server speaks %(lang) to your client."
msgstr "Для переводов нужен %(clients); этот сервер говорит с твоим клиентом на %(lang)."

#: catalog/overrides/lib_l10n.lua
msgctxt "command"
msgid "Show or choose the language the server speaks to you."
msgstr "Показать или выбрать язык, на котором сервер с тобой говорит."

#: catalog/overrides/lib_l10n.lua
msgid "Language"
msgstr "Язык"

#: catalog/overrides/lib_l10n.lua
msgid "Show or change the language you read"
msgstr "Показать или сменить язык сообщений"

#: catalog/overrides/map_meta.lua
#: lsd/scripts/map_meta.lua
msgid "Next up: %(name)"
msgstr "Далее: %(name)"

#: catalog/overrides/map_meta.lua
#: lsd/scripts/map_meta.lua
msgid "Next up: %(name) by %(author)"
msgstr "Далее: %(name), автор %(author)"

#: catalog/overrides/map_meta.lua
#: lsd/scripts/map_meta.lua
msgctxt "command"
msgid "Dump the current map's metadata."
msgstr "Вывести метаданные текущей карты."

#: catalog/overrides/sel.lua
#: lsd/scripts/sel.lua
msgid "Beginning selection."
msgstr "Начало выделения."

#: catalog/overrides/sel.lua
#: lsd/scripts/sel.lua
msgid "Beginning selection start."
msgstr "Начало выделения: старт."

#: catalog/overrides/sel.lua
#: lsd/scripts/sel.lua
msgid "Beginning selection end."
msgstr "Начало выделения: конец."

#: catalog/overrides/sel.lua
#: lsd/scripts/sel.lua
msgid "Selection started at {x=%(x), y=%(y), z=%(z)}."
msgstr "Выделение начато в {x=%(x), y=%(y), z=%(z)}."

#: catalog/overrides/sel.lua
#: lsd/scripts/sel.lua
msgid "Selection ended at {x=%(x), y=%(y), z=%(z)}."
msgstr "Выделение закончено в {x=%(x), y=%(y), z=%(z)}."

#: catalog/overrides/sel.lua
#: lsd/scripts/sel.lua
msgid "Begin a selection first."
msgstr "Сначала начни выделение."

#: catalog/overrides/sel.lua
#: lsd/scripts/sel.lua
msgid "Start the selection first."
msgstr "Сначала задай начало выделения."

#: catalog/overrides/sel.lua
#: lsd/scripts/sel.lua
msgid "End the selection first."
msgstr "Сначала задай конец выделения."

#: catalog/overrides/sel.lua
#: lsd/scripts/sel.lua
msgid "shape should be one of the following: cube, box, sphere, cylinderx, cylindery, cylinderz, fn"
msgstr "форма должна быть одной из: cube, box, sphere, cylinderx, cylindery, cylinderz, fn"

#: catalog/overrides/sel.lua
#: lsd/scripts/sel.lua
msgid "%(arg) should be one of the following: x, -x, +x, y, -y, +y, z, -z, +z"
msgstr "%(arg) должен быть одним из: x, -x, +x, y, -y, +y, z, -z, +z"

#: catalog/overrides/sel.lua
#: lsd/scripts/sel.lua
msgid "Swizzle must map all of x, y and z"
msgstr "Перестановка должна задействовать все оси x, y и z"

#: catalog/overrides/sel.lua
msgid "Nothing that way to pick. Aim at a block."
msgstr "В том направлении нечего выбрать. Наведись на блок."

#: catalog/overrides/sel.lua
#: lsd/scripts/sel.lua
msgid "Couldn't find any block in that cast. You're certain you're not looking at the sky?"
msgstr "Луч не нашёл ни одного блока. Ты точно не смотришь в небо?"

#: catalog/overrides/sel.lua
msgctxt "command"
msgid "Select a box, by aiming at its corners or by naming them."
msgstr "Выделить область, наведясь на её углы или задав их."

#: catalog/overrides/sel.lua
#: lsd/scripts/sel.lua
msgctxt "command"
msgid "Set the start of a selection."
msgstr "Задать начало выделения."

#: catalog/overrides/sel.lua
#: lsd/scripts/sel.lua
msgctxt "command"
msgid "Raycast the start of a selection."
msgstr "Задать начало выделения лучом."

#: catalog/overrides/sel.lua
#: lsd/scripts/sel.lua
msgctxt "command"
msgid "Set the start of a selection to your head's position."
msgstr "Задать начало выделения по положению твоей головы."

#: catalog/overrides/sel.lua
#: lsd/scripts/sel.lua
msgctxt "command"
msgid "Set the end of a selection."
msgstr "Задать конец выделения."

#: catalog/overrides/sel.lua
#: lsd/scripts/sel.lua
msgctxt "command"
msgid "Raycast the end of a selection."
msgstr "Задать конец выделения лучом."

#: catalog/overrides/sel.lua
#: lsd/scripts/sel.lua
msgctxt "command"
msgid "Set the end of a selection to your head's position."
msgstr "Задать конец выделения по положению твоей головы."

#: catalog/overrides/sel.lua
#: lsd/scripts/sel.lua
msgctxt "command"
msgid "Stop a selection."
msgstr "Остановить выделение."

#: catalog/overrides/sel.lua
#: lsd/scripts/sel.lua
msgctxt "command"
msgid "Change selection shape."
msgstr "Сменить форму выделения."

#: catalog/overrides/sel.lua
#: lsd/scripts/sel.lua
msgctxt "command"
msgid "Change \"fn\" selection shape. Does not parse args."
msgstr "Сменить форму выделения \"fn\". Аргументы не разбираются."

#: catalog/overrides/sel.lua
#: lsd/scripts/sel.lua
msgctxt "command"
msgid "Change selection noise."
msgstr "Сменить шум выделения."

#: catalog/overrides/sel.lua
#: lsd/scripts/sel.lua
msgctxt "command"
msgid "Fill and replace a box."
msgstr "Заполнить область с заменой."

#: catalog/overrides/sel.lua
#: lsd/scripts/sel.lua
msgctxt "command"
msgid "Clobber over everything in your selection to match the current shape."
msgstr "Перезаписать всё в выделении по текущей форме."

#: catalog/overrides/sel.lua
#: lsd/scripts/sel.lua
msgctxt "command"
msgid "Fill and do not replace a box."
msgstr "Заполнить область без замены."

#: catalog/overrides/sel.lua
#: lsd/scripts/sel.lua
msgctxt "command"
msgid "Destroy a box."
msgstr "Разрушить область."

#: catalog/overrides/sel.lua
#: lsd/scripts/sel.lua
msgctxt "command"
msgid "Set color of all blocks in a box."
msgstr "Задать цвет всех блоков в области."

#: catalog/overrides/sel.lua
#: lsd/scripts/sel.lua
msgctxt "command"
msgid "Duplicate the selection in a direction a certain number of times."
msgstr "Скопировать выделение в заданном направлении несколько раз."

#: catalog/overrides/sel.lua
#: lsd/scripts/sel.lua
msgctxt "command"
msgid "Duplicate the selection in a direction a certain number of times, then select the duplicated area."
msgstr "Скопировать выделение в заданном направлении несколько раз, затем выделить копию."

#: catalog/overrides/sel.lua
#: lsd/scripts/sel.lua
msgctxt "command"
msgid "Move the selection, then select the moved area."
msgstr "Сдвинуть выделение, затем выделить сдвинутую область."

#: catalog/overrides/sel.lua
#: lsd/scripts/sel.lua
msgctxt "command"
msgid "Move the selection dist blocks in the direction you're facing, then select the moved area."
msgstr "Сдвинуть выделение на dist блоков туда, куда ты смотришь, затем выделить сдвинутую область."

#: catalog/overrides/sel.lua
#: lsd/scripts/sel.lua
msgctxt "command"
msgid "Swizzle the dimensions of the selection around to flip and rotate."
msgstr "Переставить оси выделения, чтобы отразить и повернуть его."

#: image/config.lua
msgid "Use /kill to die."
msgstr "Введи /kill, чтобы умереть."

#: image/config.lua
msgid "Press the %(key) key to change team/gun."
msgstr "Нажми %(key), чтобы сменить команду/оружие."

#: image/config.lua
msgid "Block color won't change? Try the arrow keys and E."
msgstr "Цвет блока не меняется? Попробуй стрелки и E."

#: image/config.lua
msgid "This is not Build and Shoot. This is ACE OF SPADES."
msgstr "Это не Build and Shoot. Это ACE OF SPADES."

#: image/config.lua
msgid "Type /lang to read the server in another language."
msgstr "Введи /lang, чтобы читать сервер на другом языке."

#: image/config.lua
msgid "Welcome to %(server), running [LSd]."
msgstr "Добро пожаловать на %(server), работает на [LSd]."

#: lsd/scripts/apoc.lua
msgid "%(originname)'s apocs have been given to %(destname)"
msgstr "Апоки игрока %(originname) переданы игроку %(destname)"

#: lsd/scripts/apoc.lua
msgid "%(name) can now use /apoc. . ."
msgstr "%(name) теперь может использовать /apoc. . ."

#: lsd/scripts/apoc.lua
msgid "You need a %(needstreak) killstreak to use apoc! Current streak: %(curstreak)"
msgstr "Для апока нужна серия убийств %(needstreak)! Текущая серия: %(curstreak)"

#: lsd/scripts/apoc.lua
msgid "Don't be so hasty!"
msgstr "Не торопись!"

#: lsd/scripts/apoc.lua
msgctxt "command"
msgid "Attempt to summon an apoc."
msgstr "Попытаться вызвать апок."

#: lsd/scripts/apoc.lua
msgctxt "command"
msgid "Bombs away!"
msgstr "Бомбы пошли!"

#: lsd/scripts/arena.lua
msgid "Starting round in %(time) s."
msgstr "Раунд начнётся через %(time) с."

#: lsd/scripts/auth.lua
msgid "You need to login to run that command."
msgstr "Чтобы выполнить эту команду, нужно войти в аккаунт."

#: lsd/scripts/auth.lua
msgid "Don't make the password that long or you might not be able to change it! Try <= %(max) chars."
msgstr "Не делай пароль таким длинным, а то не сможешь его сменить! Попробуй <= %(max) символов."

#: lsd/scripts/auth.lua
msgid "Can't register; are you sure that name isn't taken?"
msgstr "Не удалось зарегистрироваться; ты уверен, что это имя не занято?"

#: lsd/scripts/auth.lua
msgid "User not found."
msgstr "Пользователь не найден."

#: lsd/scripts/auth.lua
msgid "Try logging in again in %(timeleft) s."
msgstr "Попробуй войти снова через %(timeleft) с."

#: lsd/scripts/auth.lua
msgid "Bad password or TOTP."
msgstr "Неверный пароль или TOTP."

#: lsd/scripts/auth.lua
msgid "algorithm should be one of the following: SHA1, SHA256, SHA512"
msgstr "алгоритм должен быть одним из: SHA1, SHA256, SHA512"

#: lsd/scripts/auth.lua
msgid "Your password is too short and hard to remember. Try using a couple of actual, *random* words instead."
msgstr "Пароль слишком короткий и плохо запоминается. Лучше возьми пару настоящих, *случайных* слов."

#: lsd/scripts/auth.lua
msgid "Pass your code to /totpverify to set up TOTP."
msgstr "Передай свой код в /totpverify, чтобы настроить TOTP."

#: lsd/scripts/auth.lua
msgid "Your account's TOTP configuration has been set."
msgstr "Настройка TOTP для твоего аккаунта сохранена."

#: lsd/scripts/auth.lua
msgid "Bad TOTP."
msgstr "Неверный TOTP."

#: lsd/scripts/auth.lua
msgctxt "command"
msgid "Create an account."
msgstr "Создать аккаунт."

#: lsd/scripts/auth.lua
msgctxt "command"
msgid "Setup TOTP for your account."
msgstr "Настроить TOTP для своего аккаунта."

#: lsd/scripts/auth.lua
msgctxt "command"
msgid "Remove TOTP from your account."
msgstr "Убрать TOTP из своего аккаунта."

#: lsd/scripts/auth.lua
msgctxt "command"
msgid "Finish setting up TOTP for your account."
msgstr "Завершить настройку TOTP для своего аккаунта."

#: lsd/scripts/auth.lua
msgctxt "command"
msgid "Set an account's capabilities."
msgstr "Задать права аккаунта."

#: lsd/scripts/auth.lua
msgctxt "command"
msgid "Change your account's password."
msgstr "Сменить пароль своего аккаунта."

#: lsd/scripts/auth.lua
msgctxt "command"
msgid "Login to an account."
msgstr "Войти в аккаунт."

#: lsd/scripts/auth.lua
msgctxt "command"
msgid "Barge into an account."
msgstr "Ворваться в чужой аккаунт."

#: lsd/scripts/auth.lua
msgctxt "command"
msgid "Log out of your account."
msgstr "Выйти из аккаунта."

#: lsd/scripts/auth.lua
msgctxt "command"
msgid "Print your account name and groups."
msgstr "Вывести имя своего аккаунта и группы."

#: lsd/scripts/babel.lua
msgid ">:("
msgstr ">:("

#: lsd/scripts/babel.lua
#: lsd/scripts/babel_protect.lua
msgid "Can't do that there!"
msgstr "Тут так нельзя!"

#: lsd/scripts/babel.lua
#: lsd/scripts/ctf.lua
#: lsd/scripts/onectf.lua
msgid "You're not holding the intel!"
msgstr "У тебя нет разведданных!"

#: lsd/scripts/babel.lua
#: lsd/scripts/ctf.lua
#: lsd/scripts/onectf.lua
msgctxt "command"
msgid "Drop the intel if you're holding it."
msgstr "Сбросить разведданные, если они у тебя."

#: lsd/scripts/babel_heaven.lua
msgid "Cannot find image; try /heavenlist."
msgstr "Изображение не найдено; попробуй /heavenlist."

#: lsd/scripts/babel_heaven.lua
msgid "You can list images with /heavenlist."
msgstr "Список изображений -- /heavenlist."

#: lsd/scripts/babel_heaven.lua
msgid "You must wait %(timeuntil) s to paint over the platform again."
msgstr "Подожди %(timeuntil) с, прежде чем снова рисовать на платформе."

#: lsd/scripts/babel_heaven.lua
msgctxt "command"
msgid "Paint an image on the babel platform."
msgstr "Нарисовать изображение на платформе Вавилона."

#: lsd/scripts/babel_heaven.lua
msgctxt "command"
msgid "Paint an image on the babel platform regardless of the timer's opinion."
msgstr "Нарисовать изображение на платформе Вавилона, не считаясь с таймером."

#: lsd/scripts/babel_heaven.lua
msgctxt "command"
msgid "List images available to paint on the babel platform."
msgstr "Показать изображения, которые можно нарисовать на платформе Вавилона."

#: lsd/scripts/babel_unlocks.lua
msgid "%(name) has placed %(blocks) blocks, /heaven unlocked!"
msgstr "%(name) поставил блоков: %(blocks), /heaven открыт!"

#: lsd/scripts/babel_unlocks.lua
msgid "%(name) has placed %(blocks) tower blocks."
msgstr "%(name) поставил блоков башни: %(blocks)."

#: lsd/scripts/babel_unlocks.lua
msgid "Congratulations on placing 0 blocks today!"
msgstr "Поздравляем: сегодня поставлено 0 блоков!"

#: lsd/scripts/babel_unlocks.lua
msgid "You need a %(needstreak) killstreak and 1 capture to use apoc! Current streak: %(curstreak)"
msgstr "Для апока нужна серия убийств %(needstreak) и 1 захват! Текущая серия: %(curstreak)"

#: lsd/scripts/babel_unlocks.lua
msgid "You have a %(streak) streak! Capture an intel for /apoc."
msgstr "У тебя серия %(streak)! Захвати разведданные ради /apoc."

#: lsd/scripts/babel_unlocks.lua
msgctxt "command"
msgid "Print the number of blocks placed by another player or yourself."
msgstr "Вывести число блоков, поставленных другим игроком или тобой."

#: lsd/scripts/bans.lua
msgid "%(name) was banned"
msgstr "Игрок %(name) забанен"

#: lsd/scripts/bans.lua
msgid "#%(id): <%(name)>, %(addr), %(start_date) -> %(end_date) by %(banner): %(comment) (caps: %(caps))"
msgstr "#%(id): <%(name)>, %(addr), %(start_date) -> %(end_date), выдал %(banner): %(comment) (права: %(caps))"

#: lsd/scripts/bans.lua
msgid "#%(id): <%(name)>, %(addr), expired, %(start_date) -> %(end_date) by %(banner): %(comment) (caps: %(caps))"
msgstr "#%(id): <%(name)>, %(addr), истёк, %(start_date) -> %(end_date), выдал %(banner): %(comment) (права: %(caps))"

#: lsd/scripts/bans.lua
msgid "#%(id): <%(name)>, %(addr), revoked, %(start_date) -> %(end_date) by %(banner): %(comment) (caps: %(caps))"
msgstr "#%(id): <%(name)>, %(addr), отозван, %(start_date) -> %(end_date), выдал %(banner): %(comment) (права: %(caps))"

#: lsd/scripts/bans.lua
msgid "Ban ID: #%(id)"
msgstr "ID бана: #%(id)"

#: lsd/scripts/bans.lua
msgid "Invalid ban ID."
msgstr "Неверный ID бана."

#: lsd/scripts/bans.lua
msgctxt "command"
msgid "Ban a naughty player."
msgstr "Забанить нехорошего игрока."

#: lsd/scripts/bans.lua
msgctxt "command"
msgid "Ban a naughty player with custom badcaps."
msgstr "Забанить нехорошего игрока с особыми запретами (badcaps)."

#: lsd/scripts/bans.lua
msgctxt "command"
msgid "Ban a naughty (nice?) player with custom caps."
msgstr "Забанить нехорошего (хорошего?) игрока с особыми правами."

#: lsd/scripts/bans.lua
msgctxt "command"
msgid "Ban a naughty IPv4 address or CIDR range."
msgstr "Забанить нехороший адрес IPv4 или диапазон CIDR."

#: lsd/scripts/bans.lua
msgctxt "command"
msgid "Ban a naughty IPv4 address or CIDR range with custom badcaps."
msgstr "Забанить нехороший адрес IPv4 или диапазон CIDR с особыми запретами (badcaps)."

#: lsd/scripts/bans.lua
msgctxt "command"
msgid "Ban a naughty (nice?) IPv4 address or CIDR range with custom caps."
msgstr "Забанить нехороший (хороший?) адрес IPv4 или диапазон CIDR с особыми правами."

#: lsd/scripts/bans.lua
msgctxt "command"
msgid "Revoke a given ban ID."
msgstr "Отозвать бан с указанным ID."

#: lsd/scripts/bans.lua
msgctxt "command"
msgid "Unrevoke a given ban ID."
msgstr "Отменить отзыв бана с указанным ID."

#: lsd/scripts/bans.lua
msgctxt "command"
msgid "Query all unexpired, unrevoked bans matching a given IPv4 address or CIDR range."
msgstr "Найти все действующие, неотозванные баны по адресу IPv4 или диапазону CIDR."

#: lsd/scripts/bans.lua
msgctxt "command"
msgid "Query all unexpired, unrevoked bans matching a given player name (case-insensitive glob)."
msgstr "Найти все действующие, неотозванные баны по имени игрока (glob, без учёта регистра)."

#: lsd/scripts/bans.lua
