msgstr "Debes esperar %(timeuntil) s para volver a pintar sobre la plataforma."

#: lsd/scripts/babel_heaven.lua
msgctxt "command"
msgid "Paint an image on the babel platform."
msgstr "Pintar una imagen en la plataforma de Babel."

#: lsd/scripts/babel_heaven.lua
msgctxt "command"
msgid "Paint an image on the babel platform regardless of the timer's opinion."
msgstr "Pintar una imagen en la plataforma de Babel sin importar lo que diga el temporizador."

#: lsd/scripts/babel_heaven.lua
msgctxt "command"
msgid "List images available to paint on the babel platform."
msgstr "Listar las imágenes disponibles para pintar en la plataforma de Babel."

#: lsd/scripts/babel_unlocks.lua
msgid "%(name) has placed %(blocks) blocks, /heaven unlocked!"
msgstr "¡%(name) ha colocado %(blocks) bloques, /heaven desbloqueado!"

#: lsd/scripts/babel_unlocks.lua
msgid "%(name) has placed %(blocks) tower blocks."
msgstr "%(name) ha colocado %(blocks) bloques de la torre."

#: lsd/scripts/babel_unlocks.lua
msgid "Congratulations on placing 0 blocks today!"
msgstr "¡Enhorabuena por colocar 0 bloques hoy!"

#: lsd/scripts/babel_unlocks.lua
msgid "You need a %(needstreak) killstreak and 1 capture to use apoc! Current streak: %(curstreak)"
msgstr "¡Necesitas una racha de bajas de %(needstreak) y 1 captura para usar apoc! Racha actual: %(curstreak)"

#: lsd/scripts/babel_unlocks.lua
msgid "You have a %(streak) streak! Capture an intel for /apoc."
msgstr "¡Tienes una racha de %(streak)! Captura una inteligencia para /apoc."

#: lsd/scripts/babel_unlocks.lua
msgctxt "command"
msgid "Print the number of blocks placed by another player or yourself."
msgstr "Mostrar el número de bloques colocados por otro jugador o por ti."

#: lsd/scripts/bans.lua
msgid "%(name) was banned"
msgstr "%(name) fue baneado"

#: lsd/scripts/bans.lua
msgid "#%(id): <%(name)>, %(addr), %(start_date) -> %(end_date) by %(banner): %(comment) (caps: %(caps))"
msgstr "#%(id): <%(name)>, %(addr), %(start_date) -> %(end_date) por %(banner): %(comment) (permisos: %(caps))"

#: lsd/scripts/bans.lua
msgid "#%(id): <%(name)>, %(addr), expired, %(start_date) -> %(end_date) by %(banner): %(comment) (caps: %(caps))"
msgstr "#%(id): <%(name)>, %(addr), expirado, %(start_date) -> %(end_date) por %(banner): %(comment) (permisos: %(caps))"

