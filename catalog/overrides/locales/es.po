msgid "Stick yourself into spectator without anybody else knowing."
msgstr "Pasar a espectador sin que nadie más lo sepa."

#: catalog/overrides/command_ups.lua
#: lsd/scripts/command_ups.lua
msgid "%(arg) should be one of {%(freqs)} (Hz)"
msgstr "%(arg) debe ser uno de {%(freqs)} (Hz)"

#: catalog/overrides/command_ups.lua
#: lsd/scripts/command_ups.lua
msgid "Current update rate: %(freq) Hz"
msgstr "Frecuencia de actualización actual: %(freq) Hz"

#: catalog/overrides/command_ups.lua
#: lsd/scripts/command_ups.lua
msgctxt "command"
msgid "Get/set the rate your client receives player position/orientation."
msgstr "Ver/cambiar la frecuencia con que tu cliente recibe la posición/orientación de los jugadores."

#: catalog/overrides/lib_l10n.lua
msgid "usage: %(cmd)"
msgstr "uso: %(cmd)"

#: catalog/overrides/lib_l10n.lua
msgid "usage: %(cmd) %(args)"
msgstr "uso: %(cmd) %(args)"

#: catalog/overrides/lib_l10n.lua
msgid "Your language: %(lang). Available: %(list). Use /lang <code>, or /lang auto for your client's."
msgstr "Tu idioma: %(lang). Disponibles: %(list). Usa /lang <código>, o /lang auto para el de tu cliente."

#: catalog/overrides/lib_l10n.lua
msgid "Language set to %(lang)."
msgstr "Idioma cambiado a %(lang)."

#: catalog/overrides/lib_l10n.lua
msgid "Language follows your client again: %(lang)."
msgstr "El idioma vuelve a seguir a tu cliente: %(lang)."

#: catalog/overrides/lib_l10n.lua
msgid "No translations for %(lang) here; some messages stay in English."
msgstr "No hay traducciones a %(lang) aquí; algunos mensajes quedan en inglés."

