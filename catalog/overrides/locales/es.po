msgid "Ban a naughty player with custom badcaps."
msgstr "Banear a un jugador travieso con badcaps personalizados."

#: lsd/scripts/bans.lua
msgctxt "command"
msgid "Ban a naughty (nice?) player with custom caps."
msgstr "Banear a un jugador travieso (¿bueno?) con permisos personalizados."

#: lsd/scripts/bans.lua
msgctxt "command"
msgid "Ban a naughty IPv4 address or CIDR range."
msgstr "Banear una dirección IPv4 o rango CIDR travieso."

#: lsd/scripts/bans.lua
msgctxt "command"
msgid "Ban a naughty IPv4 address or CIDR range with custom badcaps."
msgstr "Banear una dirección IPv4 o rango CIDR travieso con badcaps personalizados."

#: lsd/scripts/bans.lua
