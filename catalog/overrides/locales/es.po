msgid "%(lang) is not a language code (en, fr, pt_br, ...)."
msgstr "%(lang) no es un código de idioma (en, fr, pt_br, ...)."

#: catalog/overrides/lib_l10n.lua
msgid "Translations need %(clients); this server speaks %(lang) to your client."
msgstr "Las traducciones requieren %(clients); este servidor le habla a tu cliente en %(lang)."

#: catalog/overrides/lib_l10n.lua
msgctxt "command"
msgid "Show or choose the language the server speaks to you."
msgstr "Mostrar o elegir el idioma en que te habla el servidor."

#: catalog/overrides/lib_l10n.lua
msgid "Language"
msgstr "Idioma"

#: catalog/overrides/lib_l10n.lua
msgid "Show or change the language you read"
msgstr "Ver o cambiar el idioma en que lees"

#: catalog/overrides/sel.lua
#: lsd/scripts/sel.lua
msgid "Beginning selection."
msgstr "Iniciando selección."

#: catalog/overrides/sel.lua
#: lsd/scripts/sel.lua
msgid "Beginning selection start."
msgstr "Fijando el inicio de la selección."

#: catalog/overrides/sel.lua
#: lsd/scripts/sel.lua
msgid "Beginning selection end."
msgstr "Fijando el final de la selección."

#: catalog/overrides/sel.lua
#: lsd/scripts/sel.lua
msgid "Selection started at {x=%(x), y=%(y), z=%(z)}."
msgstr "Selección iniciada en {x=%(x), y=%(y), z=%(z)}."

#: catalog/overrides/sel.lua
#: lsd/scripts/sel.lua
msgid "Selection ended at {x=%(x), y=%(y), z=%(z)}."
msgstr "Selección terminada en {x=%(x), y=%(y), z=%(z)}."

#: catalog/overrides/sel.lua
#: lsd/scripts/sel.lua
msgid "Begin a selection first."
msgstr "Primero inicia una selección."

#: catalog/overrides/sel.lua
#: lsd/scripts/sel.lua
msgid "Start the selection first."
msgstr "Primero fija el inicio de la selección."

#: catalog/overrides/sel.lua
#: lsd/scripts/sel.lua
msgid "End the selection first."
msgstr "Primero fija el final de la selección."

#: catalog/overrides/sel.lua
#: lsd/scripts/sel.lua
msgid "shape should be one of the following: cube, box, sphere, cylinderx, cylindery, cylinderz, fn"
msgstr "la forma debe ser una de las siguientes: cube, box, sphere, cylinderx, cylindery, cylinderz, fn"

#: catalog/overrides/sel.lua
#: lsd/scripts/sel.lua
msgid "%(arg) should be one of the following: x, -x, +x, y, -y, +y, z, -z, +z"
msgstr "%(arg) debe ser uno de los siguientes: x, -x, +x, y, -y, +y, z, -z, +z"

#: catalog/overrides/sel.lua
#: lsd/scripts/sel.lua
msgid "Swizzle must map all of x, y and z"
msgstr "El swizzle debe asignar x, y y z"

#: catalog/overrides/sel.lua
msgid "Nothing that way to pick. Aim at a block."
msgstr "No hay nada que elegir en esa dirección. Apunta a un bloque."

#: catalog/overrides/sel.lua
#: lsd/scripts/sel.lua
msgid "Couldn't find any block in that cast. You're certain you're not looking at the sky?"
msgstr "No se encontró ningún bloque en esa trayectoria. ¿Seguro que no estás mirando al cielo?"

#: catalog/overrides/sel.lua
msgctxt "command"
msgid "Select a box, by aiming at its corners or by naming them."
msgstr "Seleccionar una caja, apuntando a sus esquinas o indicándolas."

#: catalog/overrides/sel.lua
#: lsd/scripts/sel.lua
msgctxt "command"
msgid "Set the start of a selection."
msgstr "Fijar el inicio de una selección."

#: catalog/overrides/sel.lua
#: lsd/scripts/sel.lua
msgctxt "command"
msgid "Raycast the start of a selection."
msgstr "Fijar el inicio de una selección apuntando (raycast)."

#: catalog/overrides/sel.lua
#: lsd/scripts/sel.lua
msgctxt "command"
msgid "Set the start of a selection to your head's position."
msgstr "Fijar el inicio de una selección en la posición de tu cabeza."

#: catalog/overrides/sel.lua
#: lsd/scripts/sel.lua
msgctxt "command"
msgid "Set the end of a selection."
msgstr "Fijar el final de una selección."

#: catalog/overrides/sel.lua
#: lsd/scripts/sel.lua
msgctxt "command"
msgid "Raycast the end of a selection."
msgstr "Fijar el final de una selección apuntando (raycast)."

#: catalog/overrides/sel.lua
#: lsd/scripts/sel.lua
msgctxt "command"
msgid "Set the end of a selection to your head's position."
msgstr "Fijar el final de una selección en la posición de tu cabeza."

#: catalog/overrides/sel.lua
#: lsd/scripts/sel.lua
msgctxt "command"
msgid "Stop a selection."
msgstr "Detener una selección."

#: catalog/overrides/sel.lua
#: lsd/scripts/sel.lua
msgctxt "command"
msgid "Change selection shape."
msgstr "Cambiar la forma de la selección."

#: catalog/overrides/sel.lua
#: lsd/scripts/sel.lua
msgctxt "command"
msgid "Change \"fn\" selection shape. Does not parse args."
msgstr "Cambiar la forma de selección \"fn\". No analiza argumentos."

#: catalog/overrides/sel.lua
#: lsd/scripts/sel.lua
msgctxt "command"
msgid "Change selection noise."
msgstr "Cambiar el ruido de la selección."

#: catalog/overrides/sel.lua
#: lsd/scripts/sel.lua
msgctxt "command"
msgid "Fill and replace a box."
msgstr "Rellenar una caja, reemplazando lo que haya."

#: catalog/overrides/sel.lua
#: lsd/scripts/sel.lua
msgctxt "command"
msgid "Clobber over everything in your selection to match the current shape."
msgstr "Sobrescribir todo lo que haya en tu selección para que coincida con la forma actual."

#: catalog/overrides/sel.lua
#: lsd/scripts/sel.lua
msgctxt "command"
msgid "Fill and do not replace a box."
msgstr "Rellenar una caja sin reemplazar lo que haya."

#: catalog/overrides/sel.lua
#: lsd/scripts/sel.lua
msgctxt "command"
msgid "Destroy a box."
msgstr "Destruir una caja."

#: catalog/overrides/sel.lua
#: lsd/scripts/sel.lua
msgctxt "command"
msgid "Set color of all blocks in a box."
msgstr "Cambiar el color de todos los bloques de una caja."

#: catalog/overrides/sel.lua
#: lsd/scripts/sel.lua
msgctxt "command"
msgid "Duplicate the selection in a direction a certain number of times."
msgstr "Duplicar la selección en una dirección un número dado de veces."

#: catalog/overrides/sel.lua
#: lsd/scripts/sel.lua
msgctxt "command"
msgid "Duplicate the selection in a direction a certain number of times, then select the duplicated area."
msgstr "Duplicar la selección en una dirección un número dado de veces, y luego seleccionar el área duplicada."

#: catalog/overrides/sel.lua
#: lsd/scripts/sel.lua
msgctxt "command"
msgid "Move the selection, then select the moved area."
msgstr "Mover la selección, y luego seleccionar el área movida."

#: catalog/overrides/sel.lua
#: lsd/scripts/sel.lua
msgctxt "command"
msgid "Move the selection dist blocks in the direction you're facing, then select the moved area."
msgstr "Mover la selección dist bloques en la dirección a la que miras, y luego seleccionar el área movida."

#: catalog/overrides/sel.lua
#: lsd/scripts/sel.lua
msgctxt "command"
msgid "Swizzle the dimensions of the selection around to flip and rotate."
msgstr "Intercambiar las dimensiones de la selección para voltearla y rotarla."

#: image/config.lua
msgid "Use /kill to die."
msgstr "Usa /kill para morir."

#: image/config.lua
msgid "Press the %(key) key to change team/gun."
msgstr "Pulsa la tecla %(key) para cambiar de equipo/arma."

#: image/config.lua
msgid "Block color won't change? Try the arrow keys and E."
msgstr "¿El color del bloque no cambia? Prueba las flechas y E."

#: image/config.lua
msgid "This is not Build and Shoot. This is ACE OF SPADES."
msgstr "Esto no es Build and Shoot. Esto es ACE OF SPADES."

#: image/config.lua
msgid "Type /lang to read the server in another language."
msgstr "Escribe /lang para leer el servidor en otro idioma."

#: image/config.lua
msgid "Welcome to %(server), running [LSd]."
msgstr "Bienvenido a %(server), que funciona con [LSd]."

#: lsd/scripts/apoc.lua
msgid "%(originname)'s apocs have been given to %(destname)"
msgstr "Los apocs de %(originname) se han dado a %(destname)"

#: lsd/scripts/apoc.lua
msgid "%(name) can now use /apoc. . ."
msgstr "%(name) ya puede usar /apoc. . ."

#: lsd/scripts/apoc.lua
msgid "You need a %(needstreak) killstreak to use apoc! Current streak: %(curstreak)"
msgstr "¡Necesitas una racha de bajas de %(needstreak) para usar apoc! Racha actual: %(curstreak)"

#: lsd/scripts/apoc.lua
msgid "Don't be so hasty!"
msgstr "¡No tengas tanta prisa!"

#: lsd/scripts/apoc.lua
msgctxt "command"
msgid "Attempt to summon an apoc."
msgstr "Intentar invocar un apoc."

#: lsd/scripts/apoc.lua
msgctxt "command"
msgid "Bombs away!"
msgstr "¡Bombas fuera!"

#: lsd/scripts/arena.lua
msgid "Starting round in %(time) s."
msgstr "La ronda empieza en %(time) s."

#: lsd/scripts/auth.lua
msgid "You need to login to run that command."
msgstr "Necesitas iniciar sesión para ejecutar ese comando."

#: lsd/scripts/auth.lua
msgid "Don't make the password that long or you might not be able to change it! Try <= %(max) chars."
msgstr "¡No pongas una contraseña tan larga o puede que no puedas cambiarla! Prueba con <= %(max) caracteres."

#: lsd/scripts/auth.lua
msgid "Can't register; are you sure that name isn't taken?"
msgstr "No se pudo registrar; ¿seguro que ese nombre no está ocupado?"

#: lsd/scripts/auth.lua
msgid "User not found."
msgstr "Usuario no encontrado."

#: lsd/scripts/auth.lua
msgid "Try logging in again in %(timeleft) s."
msgstr "Vuelve a intentar iniciar sesión en %(timeleft) s."

#: lsd/scripts/auth.lua
msgid "Bad password or TOTP."
msgstr "Contraseña o TOTP incorrectos."

#: lsd/scripts/auth.lua
msgid "algorithm should be one of the following: SHA1, SHA256, SHA512"
msgstr "el algoritmo debe ser uno de los siguientes: SHA1, SHA256, SHA512"

#: lsd/scripts/auth.lua
msgid "Your password is too short and hard to remember. Try using a couple of actual, *random* words instead."
msgstr "Tu contraseña es demasiado corta y difícil de recordar. Prueba con un par de palabras reales, *aleatorias*."

#: lsd/scripts/auth.lua
msgid "Pass your code to /totpverify to set up TOTP."
msgstr "Pasa tu código a /totpverify para configurar TOTP."

#: lsd/scripts/auth.lua
msgid "Your account's TOTP configuration has been set."
msgstr "Se ha establecido la configuración TOTP de tu cuenta."

#: lsd/scripts/auth.lua
msgid "Bad TOTP."
msgstr "TOTP incorrecto."

#: lsd/scripts/auth.lua
msgctxt "command"
msgid "Create an account."
msgstr "Crear una cuenta."

#: lsd/scripts/auth.lua
msgctxt "command"
msgid "Setup TOTP for your account."
msgstr "Configurar TOTP para tu cuenta."

#: lsd/scripts/auth.lua
msgctxt "command"
msgid "Remove TOTP from your account."
msgstr "Quitar TOTP de tu cuenta."

#: lsd/scripts/auth.lua
msgctxt "command"
msgid "Finish setting up TOTP for your account."
msgstr "Terminar de configurar TOTP para tu cuenta."

#: lsd/scripts/auth.lua
msgctxt "command"
msgid "Set an account's capabilities."
msgstr "Establecer los permisos de una cuenta."

#: lsd/scripts/auth.lua
msgctxt "command"
msgid "Change your account's password."
msgstr "Cambiar la contraseña de tu cuenta."

#: lsd/scripts/auth.lua
msgctxt "command"
msgid "Login to an account."
msgstr "Iniciar sesión en una cuenta."

#: lsd/scripts/auth.lua
msgctxt "command"
msgid "Barge into an account."
msgstr "Entrar a la fuerza en una cuenta."

#: lsd/scripts/auth.lua
msgctxt "command"
msgid "Log out of your account."
msgstr "Cerrar la sesión de tu cuenta."

#: lsd/scripts/auth.lua
msgctxt "command"
msgid "Print your account name and groups."
msgstr "Mostrar el nombre de tu cuenta y tus grupos."

#: lsd/scripts/babel.lua
msgid ">:("
msgstr ">:("

#: lsd/scripts/babel.lua
