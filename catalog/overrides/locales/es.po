msgid "Query all unexpired, unrevoked bans matching a given comment (case-insensitive glob)."
msgstr "Buscar todos los baneos vigentes y no revocados que coincidan con un comentario (patrón glob, sin distinguir mayúsculas)."

#: lsd/scripts/bans.lua
msgctxt "command"
msgid "Query all bans matching a given IPv4 address or CIDR range."
msgstr "Buscar todos los baneos que coincidan con una dirección IPv4 o rango CIDR."

#: lsd/scripts/bans.lua
msgctxt "command"
msgid "Query all bans matching a given player name (case-insensitive glob)."
msgstr "Buscar todos los baneos que coincidan con un nombre de jugador (patrón glob, sin distinguir mayúsculas)."

#: lsd/scripts/bans.lua
msgctxt "command"
msgid "Query all bans matching a given comment (case-insensitive glob)."
msgstr "Buscar todos los baneos que coincidan con un comentario (patrón glob, sin distinguir mayúsculas)."

