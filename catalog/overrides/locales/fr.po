#: catalog/core/lib_update_notice.lua
msgid "lsd-docker %(latest) is available; this server runs %(running). Update from the host: lsd update"
msgstr "lsd-docker %(latest) est disponible ; ce serveur tourne en %(running). Mise à jour depuis l'hôte : lsd update"

#: catalog/overrides/command_cmds.lua
#: lsd/scripts/command_cmds.lua
msgid "Command not found."
msgstr "Commande introuvable."

#: catalog/overrides/command_cmds.lua
#: lsd/scripts/command_cmds.lua
msgid "Were you looking for /commands?"
msgstr "Tu cherchais /commands ?"

#: catalog/overrides/command_cmds.lua
#: lsd/scripts/command_cmds.lua
msgctxt "command"
msgid "Print an alphabetically ordered list of all commands."
msgstr "Afficher la liste alphabétique de toutes les commandes."

#: catalog/overrides/command_cmds.lua
#: lsd/scripts/command_cmds.lua
msgctxt "command"
msgid "Filter through the list of commands. Does not parse arguments."
msgstr "Filtrer la liste des commandes. N'analyse pas les arguments."

#: catalog/overrides/command_cmds.lua
#: lsd/scripts/command_cmds.lua
msgctxt "command"
msgid "Display the invocation and description of a command."
msgstr "Afficher l'utilisation et la description d'une commande."

#: catalog/overrides/lib_l10n.lua
msgid "usage: %(cmd)"
msgstr "utilisation : %(cmd)"

#: catalog/overrides/lib_l10n.lua
msgid "usage: %(cmd) %(args)"
msgstr "utilisation : %(cmd) %(args)"

#: catalog/overrides/lib_l10n.lua
msgid "Your language: %(lang). Available: %(list). Use /lang <code>, or /lang auto for your client's."
msgstr "Ta langue : %(lang). Disponibles : %(list). Utilise /lang <code>, ou /lang auto pour celle de ton client."

#: catalog/overrides/lib_l10n.lua
msgid "Language set to %(lang)."
msgstr "Langue réglée sur %(lang)."

#: catalog/overrides/lib_l10n.lua
msgid "Language follows your client again: %(lang)."
msgstr "La langue suit de nouveau ton client : %(lang)."

#: catalog/overrides/lib_l10n.lua
msgid "No translations for %(lang) here; some messages stay in English."
msgstr "Pas de traduction en %(lang) ici ; certains messages restent en anglais."

#: catalog/overrides/lib_l10n.lua
msgid "%(lang) is not a language code (en, fr, pt_br, ...)."
msgstr "%(lang) n'est pas un code de langue (en, fr, pt_br, ...)."

#: catalog/overrides/lib_l10n.lua
msgid "Translations need %(clients); this server speaks %(lang) to your client."
msgstr "Les traductions demandent %(clients) ; ce serveur parle %(lang) à ton client."

#: catalog/overrides/lib_l10n.lua
msgctxt "command"
msgid "Show or choose the language the server speaks to you."
msgstr "Voir ou choisir la langue dans laquelle le serveur te parle."

#: catalog/overrides/lib_l10n.lua
msgid "Language"
msgstr "Langue"

#: catalog/overrides/lib_l10n.lua
msgid "Show or change the language you read"
msgstr "Voir ou changer la langue du serveur"

#: catalog/overrides/sel.lua
#: lsd/scripts/sel.lua
msgid "Beginning selection."
msgstr "Début de la sélection."

#: catalog/overrides/sel.lua
#: lsd/scripts/sel.lua
msgid "Beginning selection start."
msgstr "Début du point de départ de la sélection."

#: catalog/overrides/sel.lua
#: lsd/scripts/sel.lua
msgid "Beginning selection end."
msgstr "Début du point d'arrivée de la sélection."

#: catalog/overrides/sel.lua
#: lsd/scripts/sel.lua
msgid "Selection started at {x=%(x), y=%(y), z=%(z)}."
msgstr "Sélection commencée en {x=%(x), y=%(y), z=%(z)}."

#: catalog/overrides/sel.lua
#: lsd/scripts/sel.lua
msgid "Selection ended at {x=%(x), y=%(y), z=%(z)}."
msgstr "Sélection terminée en {x=%(x), y=%(y), z=%(z)}."

#: catalog/overrides/sel.lua
#: lsd/scripts/sel.lua
msgid "Begin a selection first."
msgstr "Commence d'abord une sélection."

#: catalog/overrides/sel.lua
#: lsd/scripts/sel.lua
msgid "Start the selection first."
msgstr "Pose d'abord le début de la sélection."

#: catalog/overrides/sel.lua
#: lsd/scripts/sel.lua
msgid "End the selection first."
msgstr "Pose d'abord la fin de la sélection."

#: catalog/overrides/sel.lua
#: lsd/scripts/sel.lua
msgid "shape should be one of the following: cube, box, sphere, cylinderx, cylindery, cylinderz, fn"
msgstr "la forme doit être l'une des suivantes : cube, box, sphere, cylinderx, cylindery, cylinderz, fn"

#: catalog/overrides/sel.lua
#: lsd/scripts/sel.lua
msgid "%(arg) should be one of the following: x, -x, +x, y, -y, +y, z, -z, +z"
msgstr "%(arg) doit être l'un des suivants : x, -x, +x, y, -y, +y, z, -z, +z"

#: catalog/overrides/sel.lua
#: lsd/scripts/sel.lua
msgid "Swizzle must map all of x, y and z"
msgstr "La permutation doit couvrir x, y et z"

#: catalog/overrides/sel.lua
msgid "Nothing that way to pick. Aim at a block."
msgstr "Rien à choisir par là. Vise un bloc."

#: catalog/overrides/sel.lua
#: lsd/scripts/sel.lua
msgid "Couldn't find any block in that cast. You're certain you're not looking at the sky?"
msgstr "Aucun bloc trouvé dans cette direction. Tu es sûr de ne pas viser le ciel ?"

#: catalog/overrides/sel.lua
msgctxt "command"
msgid "Select a box, by aiming at its corners or by naming them."
msgstr "Sélectionner une boîte, en visant ses coins ou en les nommant."

#: catalog/overrides/sel.lua
#: lsd/scripts/sel.lua
msgctxt "command"
msgid "Set the start of a selection."
msgstr "Poser le début d'une sélection."

#: catalog/overrides/sel.lua
#: lsd/scripts/sel.lua
msgctxt "command"
msgid "Raycast the start of a selection."
msgstr "Viser le début d'une sélection."

#: catalog/overrides/sel.lua
#: lsd/scripts/sel.lua
msgctxt "command"
msgid "Set the start of a selection to your head's position."
msgstr "Poser le début d'une sélection à la position de ta tête."

#: catalog/overrides/sel.lua
#: lsd/scripts/sel.lua
msgctxt "command"
msgid "Set the end of a selection."
msgstr "Poser la fin d'une sélection."

#: catalog/overrides/sel.lua
#: lsd/scripts/sel.lua
msgctxt "command"
msgid "Raycast the end of a selection."
msgstr "Viser la fin d'une sélection."

#: catalog/overrides/sel.lua
#: lsd/scripts/sel.lua
msgctxt "command"
msgid "Set the end of a selection to your head's position."
msgstr "Poser la fin d'une sélection à la position de ta tête."

#: catalog/overrides/sel.lua
#: lsd/scripts/sel.lua
msgctxt "command"
msgid "Stop a selection."
msgstr "Arrêter une sélection."

#: catalog/overrides/sel.lua
#: lsd/scripts/sel.lua
msgctxt "command"
msgid "Change selection shape."
msgstr "Changer la forme de la sélection."

#: catalog/overrides/sel.lua
#: lsd/scripts/sel.lua
msgctxt "command"
msgid "Change \"fn\" selection shape. Does not parse args."
msgstr "Changer la forme de sélection \"fn\". N'analyse pas les arguments."

#: catalog/overrides/sel.lua
#: lsd/scripts/sel.lua
msgctxt "command"
msgid "Change selection noise."
msgstr "Changer le bruit de la sélection."

#: catalog/overrides/sel.lua
#: lsd/scripts/sel.lua
msgctxt "command"
msgid "Fill and replace a box."
msgstr "Remplir une boîte en remplaçant."

#: catalog/overrides/sel.lua
#: lsd/scripts/sel.lua
msgctxt "command"
msgid "Clobber over everything in your selection to match the current shape."
msgstr "Écraser tout le contenu de la sélection pour suivre la forme actuelle."

#: catalog/overrides/sel.lua
#: lsd/scripts/sel.lua
msgctxt "command"
msgid "Fill and do not replace a box."
msgstr "Remplir une boîte sans remplacer."

#: catalog/overrides/sel.lua
#: lsd/scripts/sel.lua
msgctxt "command"
msgid "Destroy a box."
msgstr "Détruire une boîte."

#: catalog/overrides/sel.lua
#: lsd/scripts/sel.lua
msgctxt "command"
msgid "Set color of all blocks in a box."
msgstr "Changer la couleur de tous les blocs d'une boîte."

#: catalog/overrides/sel.lua
#: lsd/scripts/sel.lua
msgctxt "command"
msgid "Duplicate the selection in a direction a certain number of times."
msgstr "Dupliquer la sélection dans une direction un certain nombre de fois."

#: catalog/overrides/sel.lua
#: lsd/scripts/sel.lua
msgctxt "command"
msgid "Duplicate the selection in a direction a certain number of times, then select the duplicated area."
msgstr "Dupliquer la sélection dans une direction un certain nombre de fois, puis sélectionner la zone dupliquée."

#: catalog/overrides/sel.lua
#: lsd/scripts/sel.lua
msgctxt "command"
msgid "Move the selection, then select the moved area."
msgstr "Déplacer la sélection, puis sélectionner la zone déplacée."

#: catalog/overrides/sel.lua
#: lsd/scripts/sel.lua
msgctxt "command"
msgid "Move the selection dist blocks in the direction you're facing, then select the moved area."
msgstr "Déplacer la sélection de dist blocs dans la direction où tu regardes, puis sélectionner la zone déplacée."

#: catalog/overrides/sel.lua
#: lsd/scripts/sel.lua
msgctxt "command"
msgid "Swizzle the dimensions of the selection around to flip and rotate."
msgstr "Permuter les dimensions de la sélection pour la retourner et la faire pivoter."

#: image/config.lua
msgid "Use /kill to die."
msgstr "Tape /kill pour mourir."

#: image/config.lua
msgid "Press the %(key) key to change team/gun."
msgstr "Appuie sur la touche %(key) pour changer d'équipe ou d'arme."

#: image/config.lua
msgid "Block color won't change? Try the arrow keys and E."
msgstr "La couleur des blocs ne change pas ? Essaie les flèches et E."

#: image/config.lua
msgid "This is not Build and Shoot. This is ACE OF SPADES."
msgstr "Ce n'est pas Build and Shoot. C'est ACE OF SPADES."

#: image/config.lua
msgid "Type /lang to read the server in another language."
msgstr "Tape /lang pour lire le serveur dans une autre langue."

#: image/config.lua
msgid "Welcome to %(server), running [LSd]."
msgstr "Bienvenue sur %(server), propulsé par [LSd]."

#: lsd/scripts/afkick.lua
msgid "%(name) was kicked: AFK"
msgstr "%(name) a été expulsé : AFK"

#: lsd/scripts/afkick.lua
msgid "You will be automatically AFK-kicked in %(time) s"
msgstr "Tu seras automatiquement expulsé pour inactivité dans %(time) s"

#: lsd/scripts/apoc.lua
msgid "%(originname)'s apocs have been given to %(destname)"
msgstr "Les apocs de %(originname) ont été donnés à %(destname)"

#: lsd/scripts/apoc.lua
msgid "%(name) can now use /apoc. . ."
msgstr "%(name) peut maintenant utiliser /apoc. . ."

#: lsd/scripts/apoc.lua
msgid "You need a %(needstreak) killstreak to use apoc! Current streak: %(curstreak)"
msgstr "Il te faut une série de %(needstreak) éliminations pour utiliser apoc ! Série actuelle : %(curstreak)"

#: lsd/scripts/apoc.lua
msgid "Don't be so hasty!"
msgstr "Pas si vite !"

#: lsd/scripts/apoc.lua
msgctxt "command"
msgid "Attempt to summon an apoc."
msgstr "Tenter d'invoquer un apoc."

#: lsd/scripts/apoc.lua
msgctxt "command"
msgid "Bombs away!"
msgstr "Bombes larguées !"

#: lsd/scripts/arena.lua
msgid "Starting round in %(time) s."
msgstr "La manche commence dans %(time) s."

#: lsd/scripts/auth.lua
msgid "You need to login to run that command."
msgstr "Tu dois te connecter pour lancer cette commande."

#: lsd/scripts/auth.lua
msgid "Don't make the password that long or you might not be able to change it! Try <= %(max) chars."
msgstr "Ne fais pas un mot de passe aussi long, tu risquerais de ne plus pouvoir le changer ! Essaie <= %(max) caractères."

#: lsd/scripts/auth.lua
msgid "Can't register; are you sure that name isn't taken?"
msgstr "Inscription impossible ; tu es sûr que ce nom n'est pas déjà pris ?"

#: lsd/scripts/auth.lua
msgid "User not found."
msgstr "Utilisateur introuvable."

#: lsd/scripts/auth.lua
msgid "Try logging in again in %(timeleft) s."
msgstr "Réessaie de te connecter dans %(timeleft) s."

#: lsd/scripts/auth.lua
msgid "Bad password or TOTP."
msgstr "Mauvais mot de passe ou code TOTP."

#: lsd/scripts/auth.lua
msgid "algorithm should be one of the following: SHA1, SHA256, SHA512"
msgstr "l'algorithme doit être l'un des suivants : SHA1, SHA256, SHA512"

#: lsd/scripts/auth.lua
msgid "Your password is too short and hard to remember. Try using a couple of actual, *random* words instead."
msgstr "Ton mot de passe est trop court et difficile à retenir. Essaie plutôt quelques vrais mots, choisis *au hasard*."

#: lsd/scripts/auth.lua
msgid "Pass your code to /totpverify to set up TOTP."
msgstr "Passe ton code à /totpverify pour configurer le TOTP."

#: lsd/scripts/auth.lua
msgid "Your account's TOTP configuration has been set."
msgstr "La configuration TOTP de ton compte est en place."

#: lsd/scripts/auth.lua
msgid "Bad TOTP."
msgstr "Mauvais code TOTP."

#: lsd/scripts/auth.lua
msgctxt "command"
msgid "Create an account."
msgstr "Créer un compte."

#: lsd/scripts/auth.lua
msgctxt "command"
msgid "Setup TOTP for your account."
msgstr "Configurer le TOTP de ton compte."

#: lsd/scripts/auth.lua
msgctxt "command"
msgid "Remove TOTP from your account."
msgstr "Retirer le TOTP de ton compte."

#: lsd/scripts/auth.lua
msgctxt "command"
msgid "Finish setting up TOTP for your account."
msgstr "Terminer la configuration du TOTP de ton compte."

#: lsd/scripts/auth.lua
msgctxt "command"
msgid "Set an account's capabilities."
msgstr "Définir les droits d'un compte."

#: lsd/scripts/auth.lua
msgctxt "command"
msgid "Change your account's password."
msgstr "Changer le mot de passe de ton compte."

#: lsd/scripts/auth.lua
msgctxt "command"
msgid "Login to an account."
msgstr "Se connecter à un compte."

#: lsd/scripts/auth.lua
msgctxt "command"
msgid "Barge into an account."
msgstr "Entrer de force dans un compte."

#: lsd/scripts/auth.lua
msgctxt "command"
msgid "Log out of your account."
msgstr "Se déconnecter de son compte."

#: lsd/scripts/auth.lua
msgctxt "command"
msgid "Print your account name and groups."
msgstr "Afficher le nom et les groupes de ton compte."

