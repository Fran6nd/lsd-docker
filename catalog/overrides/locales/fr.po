msgstr "Tu dois attendre %(timeuntil) s avant de repeindre la plateforme."

#: lsd/scripts/babel_heaven.lua
msgctxt "command"
msgid "Paint an image on the babel platform."
msgstr "Peindre une image sur la plateforme de Babel."

#: lsd/scripts/babel_heaven.lua
