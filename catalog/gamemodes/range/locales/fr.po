#: catalog/gamemodes/range/range.lua
msgid "Shooting range: step into a lane's firing position and hit every target of the lane as fast as you can; /ipsc queues you for the IPSC course, one shooter at a time. /best lists the best times."
msgstr "Stand de tir : entre sur la position de tir d'une ligne et touche toutes les cibles de la ligne le plus vite possible ; /ipsc t'inscrit dans la file du parcours IPSC, un tireur à la fois. /best affiche les meilleurs temps."

#: catalog/gamemodes/range/range.lua
msgid "Lane %(lane): %(total) targets. The clock starts in %(secs) s."
msgstr "Ligne %(lane) : %(total) cibles. Le chrono démarre dans %(secs) s."

#: catalog/gamemodes/range/range.lua
msgid "Go!"
msgstr "C'est parti !"

#: catalog/gamemodes/range/range.lua
msgid "Lane %(lane) is in use."
msgstr "La ligne %(lane) est occupée."

#: catalog/gamemodes/range/range.lua
msgid "Hit: %(n)/%(total)"
msgstr "Touchées : %(n)/%(total)"

#: catalog/gamemodes/range/range.lua
msgid "Run void: you left the firing position."
msgstr "Essai annulé : tu as quitté la position de tir."

#: catalog/gamemodes/range/range.lua
msgid "Run void: you died."
msgstr "Essai annulé : tu es mort."

#: catalog/gamemodes/range/range.lua
msgid "Every target down in %(time) s: your best on the static range!"
msgstr "Toutes les cibles tombées en %(time) s : ton record sur le stand statique !"

#: catalog/gamemodes/range/range.lua
msgid "Every target down in %(time) s. Your best on the static range is %(best) s."
msgstr "Toutes les cibles tombées en %(time) s. Ton meilleur temps sur le stand statique est de %(best) s."

#: catalog/gamemodes/range/range.lua
msgid "IPSC course in %(time) s: your best!"
msgstr "Parcours IPSC en %(time) s : ton meilleur temps !"

#: catalog/gamemodes/range/range.lua
msgid "IPSC course in %(time) s. Your best is %(best) s."
msgstr "Parcours IPSC en %(time) s. Ton meilleur temps est de %(best) s."

#: catalog/gamemodes/range/range.lua
msgid "%(name) holds the static range record: %(time) s"
msgstr "%(name) détient le record du stand statique : %(time) s"

#: catalog/gamemodes/range/range.lua
msgid "%(name) holds the IPSC record: %(time) s"
msgstr "%(name) détient le record IPSC : %(time) s"

#: catalog/gamemodes/range/range.lua
msgid "You are number %(n) in the IPSC queue."
msgstr "Tu es numéro %(n) dans la file IPSC."

#: catalog/gamemodes/range/range.lua
msgid "You left the IPSC queue."
msgstr "Tu as quitté la file IPSC."

#: catalog/gamemodes/range/range.lua
msgid "You are on the IPSC course."
msgstr "Tu es sur le parcours IPSC."

#: catalog/gamemodes/range/range.lua
msgid "The IPSC course is in use: you are number %(n) in the queue."
msgstr "Le parcours IPSC est occupé : tu es numéro %(n) dans la file."

#: catalog/gamemodes/range/range.lua
msgid "Your turn on the IPSC course: the wall in front of you comes down when the course is ready, and the clock starts then. Every target down, then to the blue end box; each hit on a no-shoot (your own team) costs %(penalty) s. %(limit) s at most."
msgstr "C'est ton tour sur le parcours IPSC : le mur devant toi tombe quand le parcours est prêt, et le chrono démarre à ce moment-là. Abats toutes les cibles, puis va à la case d'arrivée bleue ; chaque tir sur un no-shoot (ton équipe) coûte %(penalty) s. %(limit) s maximum."

#: catalog/gamemodes/range/range.lua
msgid "Every target hit: to the blue end box!"
msgstr "Toutes les cibles touchées : direction la case d'arrivée bleue !"

#: catalog/gamemodes/range/range.lua
msgid "No-shoot hit: +%(penalty) s"
msgstr "No-shoot touché : +%(penalty) s"

#: catalog/gamemodes/range/range.lua
msgid "%(raw) s + %(penalty) s penalty = %(time) s"
msgstr "%(raw) s + %(penalty) s de pénalité = %(time) s"

#: catalog/gamemodes/range/range.lua
msgid "range: this map's range was generated by an older version; lsdctl map course generates a new one."
msgstr "range : le stand de cette carte a été généré par une version plus ancienne ; lsdctl map course en génère un nouveau."

#: catalog/gamemodes/range/range.lua
msgid "Targets still standing: %(n)"
msgstr "Cibles encore debout : %(n)"

#: catalog/gamemodes/range/range.lua
msgid "IPSC run abandoned: you left the course."
msgstr "Parcours IPSC abandonné : tu as quitté le parcours."

#: catalog/gamemodes/range/range.lua
msgid "IPSC run abandoned: over %(limit) s."
msgstr "Parcours IPSC abandonné : plus de %(limit) s."

#: catalog/gamemodes/range/range.lua
msgid "IPSC run abandoned: you died."
msgstr "Parcours IPSC abandonné : tu es mort."

#: catalog/gamemodes/range/range.lua
msgid "This map has no IPSC course."
msgstr "Cette carte n'a pas de parcours IPSC."

#: catalog/gamemodes/range/range.lua
msgid "No building or digging on the range."
msgstr "Pas de construction ni de creusage sur le stand."

#: catalog/gamemodes/range/range.lua
msgid "%(team) is the targets' team: every player is on %(own) here."
msgstr "%(team) est l'équipe des cibles : ici, tous les joueurs sont dans %(own)."

#: catalog/gamemodes/range/range.lua
msgid "Static range:"
msgstr "Stand statique :"

#: catalog/gamemodes/range/range.lua
msgid "IPSC course:"
msgstr "Parcours IPSC :"

#: catalog/gamemodes/range/range.lua
msgid "%(rank). %(name): %(time) s"
msgstr "%(rank). %(name) : %(time) s"

#: catalog/gamemodes/range/range.lua
msgid "Your best on the static range: %(time) s"
msgstr "Ton meilleur temps sur le stand statique : %(time) s"

#: catalog/gamemodes/range/range.lua
msgid "Your best on the IPSC course: %(time) s"
msgstr "Ton meilleur temps sur le parcours IPSC : %(time) s"

#: catalog/gamemodes/range/range.lua
msgid "No times yet."
msgstr "Pas encore de temps."

#: catalog/gamemodes/range/range.lua
msgctxt "command"
msgid "Join the IPSC course's queue, or leave it."
msgstr "Rejoindre ou quitter la file du parcours IPSC."

#: catalog/gamemodes/range/range.lua
msgctxt "command"
msgid "List the best times on the range and the IPSC course."
msgstr "Lister les meilleurs temps du stand et du parcours IPSC."
