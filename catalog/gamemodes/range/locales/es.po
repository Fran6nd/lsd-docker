#: catalog/gamemodes/range/range.lua
msgid "Shooting range: step into a lane's firing position and hit every target of the lane as fast as you can; /ipsc queues you for the IPSC course, one shooter at a time. /best lists the best times."
msgstr "Campo de tiro: colócate en la posición de tiro de un carril y derriba todos sus objetivos lo más rápido que puedas; /ipsc te mete en la cola del recorrido IPSC, de uno en uno. /best muestra los mejores tiempos."

#: catalog/gamemodes/range/range.lua
msgid "Lane %(lane): %(total) targets. The clock starts in %(secs) s."
msgstr "Carril %(lane): %(total) objetivos. El cronómetro empieza en %(secs) s."

#: catalog/gamemodes/range/range.lua
msgid "Go!"
msgstr "¡Ya!"

#: catalog/gamemodes/range/range.lua
msgid "Lane %(lane) is in use."
msgstr "El carril %(lane) está ocupado."

#: catalog/gamemodes/range/range.lua
msgid "Hit: %(n)/%(total)"
msgstr "Aciertos: %(n)/%(total)"

#: catalog/gamemodes/range/range.lua
msgid "Run void: you left the firing position."
msgstr "Intento anulado: has salido de la posición de tiro."

#: catalog/gamemodes/range/range.lua
msgid "Run void: you died."
msgstr "Intento anulado: has muerto."

#: catalog/gamemodes/range/range.lua
msgid "Every target down in %(time) s: your best on the static range!"
msgstr "Todos los objetivos derribados en %(time) s: ¡tu mejor marca en el campo estático!"

#: catalog/gamemodes/range/range.lua
msgid "Every target down in %(time) s. Your best on the static range is %(best) s."
msgstr "Todos los objetivos derribados en %(time) s. Tu mejor marca en el campo estático es %(best) s."

#: catalog/gamemodes/range/range.lua
msgid "IPSC course in %(time) s: your best!"
msgstr "Recorrido IPSC en %(time) s: ¡tu mejor marca!"

#: catalog/gamemodes/range/range.lua
msgid "IPSC course in %(time) s. Your best is %(best) s."
msgstr "Recorrido IPSC en %(time) s. Tu mejor marca es %(best) s."

#: catalog/gamemodes/range/range.lua
msgid "%(name) holds the static range record: %(time) s"
msgstr "%(name) tiene el récord del campo estático: %(time) s"

#: catalog/gamemodes/range/range.lua
msgid "%(name) holds the IPSC record: %(time) s"
msgstr "%(name) tiene el récord del IPSC: %(time) s"

#: catalog/gamemodes/range/range.lua
msgid "You are number %(n) in the IPSC queue."
msgstr "Eres el número %(n) en la cola del IPSC."

#: catalog/gamemodes/range/range.lua
msgid "You left the IPSC queue."
msgstr "Has salido de la cola del IPSC."

#: catalog/gamemodes/range/range.lua
msgid "You are on the IPSC course."
msgstr "Estás en el recorrido IPSC."

#: catalog/gamemodes/range/range.lua
msgid "The IPSC course is in use: you are number %(n) in the queue."
msgstr "El recorrido IPSC está ocupado: eres el número %(n) en la cola."

#: catalog/gamemodes/range/range.lua
msgid "Your turn on the IPSC course: the clock starts when you leave the green start box and stops in the blue end box once every target is hit. %(limit) s at most."
msgstr "Tu turno en el recorrido IPSC: el cronómetro arranca al salir de la casilla verde de inicio y se detiene en la casilla azul de llegada cuando hayas acertado todos los objetivos. %(limit) s como máximo."

#: catalog/gamemodes/range/range.lua
msgid "Every target hit: to the blue end box!"
msgstr "¡Todos los objetivos alcanzados: a la casilla azul!"

#: catalog/gamemodes/range/range.lua
msgid "Targets still standing: %(n)"
msgstr "Objetivos en pie: %(n)"

#: catalog/gamemodes/range/range.lua
msgid "IPSC run abandoned: you left the course."
msgstr "Recorrido IPSC cancelado: has salido del recorrido."

#: catalog/gamemodes/range/range.lua
msgid "IPSC run abandoned: over %(limit) s."
msgstr "Recorrido IPSC cancelado: más de %(limit) s."

#: catalog/gamemodes/range/range.lua
msgid "IPSC run abandoned: you died."
msgstr "Recorrido IPSC cancelado: has muerto."

#: catalog/gamemodes/range/range.lua
msgid "This map has no IPSC course."
msgstr "Este mapa no tiene recorrido IPSC."

#: catalog/gamemodes/range/range.lua
msgid "No building or digging on the range."
msgstr "Prohibido construir o cavar en el campo de tiro."

#: catalog/gamemodes/range/range.lua
msgid "Everybody is on the same team here."
msgstr "Aquí todos juegan en el mismo equipo."

#: catalog/gamemodes/range/range.lua
msgid "Static range:"
msgstr "Campo estático:"

#: catalog/gamemodes/range/range.lua
msgid "IPSC course:"
msgstr "Recorrido IPSC:"

#: catalog/gamemodes/range/range.lua
msgid "%(rank). %(name): %(time) s"
msgstr "%(rank). %(name): %(time) s"

#: catalog/gamemodes/range/range.lua
msgid "Your best on the static range: %(time) s"
msgstr "Tu mejor marca en el campo estático: %(time) s"

#: catalog/gamemodes/range/range.lua
msgid "Your best on the IPSC course: %(time) s"
msgstr "Tu mejor marca en el recorrido IPSC: %(time) s"

#: catalog/gamemodes/range/range.lua
msgid "No times yet."
msgstr "Aún no hay tiempos."

#: catalog/gamemodes/range/range.lua
msgctxt "command"
msgid "Join the IPSC course's queue, or leave it."
msgstr "Unirse a la cola del recorrido IPSC, o salir de ella."

#: catalog/gamemodes/range/range.lua
msgctxt "command"
msgid "List the best times on the range and the IPSC course."
msgstr "Listar los mejores tiempos del campo de tiro y del recorrido IPSC."
