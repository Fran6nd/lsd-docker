#: catalog/gamemodes/hostage/hostage.lua
msgid "This is HOSTAGE mode: free the hostage held at the enemy tent. Get close and it follows; walk it home to score."
msgstr "Este es el modo REHÉN: libera al rehén retenido en la tienda enemiga. Acércate y te seguirá; llévalo a casa para puntuar."

#: catalog/gamemodes/hostage/hostage.lua
msgid "Thanks for picking me up!"
msgstr "¡Gracias por recogerme!"

#: catalog/gamemodes/hostage/hostage.lua
msgid "%(hero) brought the %(team) hostage home! +1 %(team)"
msgstr "¡%(hero) trajo a casa al rehén de %(team)! +1 %(team)"

#: catalog/gamemodes/hostage/hostage.lua
msgid "%(killer) executed the %(team) hostage! +1 %(team)"
msgstr "¡%(killer) ejecutó al rehén de %(team)! +1 %(team)"

#: catalog/gamemodes/hostage/hostage.lua
msgid "%(escort) is freeing your hostage -- go support!"
msgstr "¡%(escort) está liberando a tu rehén -- ve a apoyar!"

#: catalog/gamemodes/hostage/hostage.lua
msgid "A %(team) hostage is loose -- hunt it down and drag it back!"
msgstr "¡Un rehén de %(team) anda suelto -- búscalo y arrástralo de vuelta!"

#: catalog/gamemodes/hostage/hostage.lua
msgid "The %(team) hostage was dragged back to captivity."
msgstr "El rehén de %(team) fue arrastrado de vuelta al cautiverio."

#: catalog/gamemodes/hostage/hostage.lua
msgid "Get me out of here!"
msgstr "¡Sácame de aquí!"

#: catalog/gamemodes/hostage/hostage.lua
msgid "I'm a prisoner -- someone free me!"
msgstr "¡Soy prisionero -- que alguien me libere!"

#: catalog/gamemodes/hostage/hostage.lua
msgid "Psst! Come spring me from their tent!"
msgstr "¡Psst! ¡Ven a sacarme de su tienda!"

#: catalog/gamemodes/hostage/hostage.lua
msgid "I'm lost! Somebody come get me!"
msgstr "¡Estoy perdido! ¡Que alguien venga a buscarme!"

#: catalog/gamemodes/hostage/hostage.lua
msgid "Hello? Anyone? I'm stranded out here!"
msgstr "¿Hola? ¿Hay alguien? ¡Me he quedado tirado aquí!"

#: catalog/gamemodes/hostage/hostage.lua
msgid "Help, I don't know the way home!"
msgstr "¡Socorro, no sé volver a casa!"

#: catalog/gamemodes/hostage/hostage.lua
msgid "Home at last -- thank you!"
msgstr "¡Por fin en casa -- gracias!"

#: catalog/gamemodes/hostage/hostage.lua
msgid "Argh -- they got me!"
msgstr "¡Argh -- me atraparon!"

#: catalog/gamemodes/hostage/hostage.lua
msgid "They're right behind us!"
msgstr "¡Los tenemos justo detrás!"

#: catalog/gamemodes/hostage/hostage.lua
msgid "Hurry, enemies close!"
msgstr "¡Rápido, enemigos cerca!"

#: catalog/gamemodes/hostage/hostage.lua
msgid "Watch out -- keepers!"
msgstr "¡Cuidado -- carceleros!"

#: catalog/gamemodes/hostage/hostage.lua
msgid "This way, we're almost there!"
msgstr "¡Por aquí, ya casi llegamos!"

#: catalog/gamemodes/hostage/hostage.lua
msgid "Keep going, take me home!"
msgstr "¡Sigue, llévame a casa!"

#: catalog/gamemodes/hostage/hostage.lua
msgid "Don't leave me behind!"
msgstr "¡No me dejes atrás!"

#: catalog/gamemodes/hostage/hostage.lua
msgid "They've caught me -- help!"
msgstr "¡Me han atrapado -- socorro!"

#: catalog/gamemodes/hostage/hostage.lua
msgid "I'm being dragged back!"
msgstr "¡Me están arrastrando de vuelta!"

#: catalog/gamemodes/hostage/hostage.lua
msgid "No -- not back to the cage!"
msgstr "¡No -- a la jaula no!"

#: catalog/gamemodes/hostage/hostage.lua
msgid "%(team) hostage: not spawned (no tents?)"
msgstr "Rehén de %(team): no ha aparecido (¿no hay tiendas?)"

#: catalog/gamemodes/hostage/hostage.lua
msgid "%(team) hostage: down, respawning"
msgstr "Rehén de %(team): caído, reapareciendo"

#: catalog/gamemodes/hostage/hostage.lua
msgid "following %(name)"
msgstr "siguiendo a %(name)"

#: catalog/gamemodes/hostage/hostage.lua
msgid "being recaptured by %(name)"
msgstr "siendo recapturado por %(name)"

#: catalog/gamemodes/hostage/hostage.lua
msgid "waiting at a tent"
msgstr "esperando en una tienda"

#: catalog/gamemodes/hostage/hostage.lua
msgid "stranded"
msgstr "perdido"

#: catalog/gamemodes/hostage/hostage.lua
msgid "%(team) hostage: %(state) (%(dist) blocks from home)"
msgstr "Rehén de %(team): %(state) (a %(dist) bloques de casa)"

#: catalog/gamemodes/hostage/hostage.lua
msgctxt "command"
msgid "Show hostage status, or 'reset' them (needs the hostage cap)."
msgstr "Mostrar el estado de los rehenes, o reiniciarlos con 'reset' (requiere el permiso hostage)."

#: catalog/gamemodes/hostage/hostage.lua
msgid "You lack the 'hostage' cap."
msgstr "No tienes el permiso 'hostage'."

#: catalog/gamemodes/hostage/hostage.lua
msgid "Hostages reset."
msgstr "Rehenes reiniciados."
