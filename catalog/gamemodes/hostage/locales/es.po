# machine-translated (LibreTranslate)
#: catalog/gamemodes/hostage/hostage.lua
#, fuzzy
msgid "This is HOSTAGE mode: free the hostage held at the enemy tent. Get close and it follows; walk it home to score."
msgstr "Este es el modo HOSTAGE: liberar al rehén retenido en el enemigo tienda. Acércate y sigue; camina en casa para anotar."

# machine-translated (LibreTranslate)
#: catalog/gamemodes/hostage/hostage.lua
#, fuzzy
msgid "Thanks for picking me up!"
msgstr "¡Gracias por recogerme!"

# machine-translated (LibreTranslate)
#: catalog/gamemodes/hostage/hostage.lua
#, fuzzy
msgid "%(hero) brought the %(team) hostage home! +1 %(team)"
msgstr "%(hero) trajo a la %(team) rehén a casa! +1 %(team)"

# machine-translated (LibreTranslate)
#: catalog/gamemodes/hostage/hostage.lua
#, fuzzy
msgid "%(killer) executed the %(team) hostage! +1 %(team)"
msgstr "¡%(killer) ejecutó al rehén %(team)! +1 %(team)"

# machine-translated (LibreTranslate)
#: catalog/gamemodes/hostage/hostage.lua
#, fuzzy
msgid "%(escort) is freeing your hostage -- go support!"
msgstr "%(escort) está liberando a su rehén... ¡Apoye!"

# machine-translated (LibreTranslate)
#: catalog/gamemodes/hostage/hostage.lua
#, fuzzy
msgid "A %(team) hostage is loose -- hunt it down and drag it back!"
msgstr "Un rehén %(team) está suelto... ¡Atrápalo y arrástrelo!"

# machine-translated (LibreTranslate)
#: catalog/gamemodes/hostage/hostage.lua
#, fuzzy
msgid "The %(team) hostage was dragged back to captivity."
msgstr "El rehén %(team) fue arrastrado de regreso a cautiverio."

# machine-translated (LibreTranslate)
#: catalog/gamemodes/hostage/hostage.lua
#, fuzzy
msgid "Get me out of here!"
msgstr "¡Sácame de aquí!"

# machine-translated (LibreTranslate)
#: catalog/gamemodes/hostage/hostage.lua
#, fuzzy
msgid "I'm a prisoner -- someone free me!"
msgstr "¡Soy un prisionero... alguien me libre!"

# machine-translated (LibreTranslate)
#: catalog/gamemodes/hostage/hostage.lua
#, fuzzy
msgid "Psst! Come spring me from their tent!"
msgstr "¡Psst! ¡Ven a sacarme de su tienda!"

# machine-translated (LibreTranslate)
#: catalog/gamemodes/hostage/hostage.lua
#, fuzzy
msgid "I'm lost! Somebody come get me!"
msgstr "¡Estoy perdido! ¡Alguien venga a buscarme!"

# machine-translated (LibreTranslate)
#: catalog/gamemodes/hostage/hostage.lua
#, fuzzy
msgid "Hello? Anyone? I'm stranded out here!"
msgstr "¿Hola? ¿Alguien? ¡Estoy varado aquí!"

# machine-translated (LibreTranslate)
#: catalog/gamemodes/hostage/hostage.lua
#, fuzzy
msgid "Help, I don't know the way home!"
msgstr "¡Ayuda, no sé el camino a casa!"

# machine-translated (LibreTranslate)
#: catalog/gamemodes/hostage/hostage.lua
#, fuzzy
msgid "Home at last -- thank you!"
msgstr "Por fin... ¡Gracias!"

# machine-translated (LibreTranslate)
#: catalog/gamemodes/hostage/hostage.lua
#, fuzzy
msgid "Argh -- they got me!"
msgstr "Argh... ¡Me atraparon!"

# machine-translated (LibreTranslate)
#: catalog/gamemodes/hostage/hostage.lua
#, fuzzy
msgid "They're right behind us!"
msgstr "¡Están detrás de nosotros!"

# machine-translated (LibreTranslate)
#: catalog/gamemodes/hostage/hostage.lua
#, fuzzy
msgid "Hurry, enemies close!"
msgstr "¡Deprisa, enemigos cerca!"

# machine-translated (LibreTranslate)
#: catalog/gamemodes/hostage/hostage.lua
#, fuzzy
msgid "Watch out -- keepers!"
msgstr "¡Cuidado, guardianes!"

# machine-translated (LibreTranslate)
#: catalog/gamemodes/hostage/hostage.lua
#, fuzzy
msgid "This way, we're almost there!"
msgstr "¡Por aquí, ya casi llegamos!"

# machine-translated (LibreTranslate)
#: catalog/gamemodes/hostage/hostage.lua
#, fuzzy
msgid "Keep going, take me home!"
msgstr "¡Sigue, llévame a casa!"

# machine-translated (LibreTranslate)
#: catalog/gamemodes/hostage/hostage.lua
#, fuzzy
msgid "Don't leave me behind!"
msgstr "¡No me dejes atrás!"

# machine-translated (LibreTranslate)
#: catalog/gamemodes/hostage/hostage.lua
#, fuzzy
msgid "They've caught me -- help!"
msgstr "Me han atrapado... ¡Ayuda!"

# machine-translated (LibreTranslate)
#: catalog/gamemodes/hostage/hostage.lua
#, fuzzy
msgid "I'm being dragged back!"
msgstr "¡Estoy siendo arrastrado!"

# machine-translated (LibreTranslate)
#: catalog/gamemodes/hostage/hostage.lua
#, fuzzy
msgid "No -- not back to the cage!"
msgstr "No... ¡no de vuelta a la jaula!"

# machine-translated (LibreTranslate)
#: catalog/gamemodes/hostage/hostage.lua
#, fuzzy
msgid "%(team) hostage: not spawned (no tents?)"
msgstr "Rehén %(team): no desove (no hay tiendas?)"

# machine-translated (LibreTranslate)
#: catalog/gamemodes/hostage/hostage.lua
#, fuzzy
