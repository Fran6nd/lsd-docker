msgstr "siendo recapturado por %(name)"

# machine-translated (LibreTranslate)
#: catalog/gamemodes/hostage/hostage.lua
#, fuzzy
msgid "waiting at a tent"
msgstr "esperando a un tienda"

# machine-translated (LibreTranslate)
#: catalog/gamemodes/hostage/hostage.lua
#, fuzzy
msgid "stranded"
msgstr "varado"

# machine-translated (LibreTranslate)
#: catalog/gamemodes/hostage/hostage.lua
