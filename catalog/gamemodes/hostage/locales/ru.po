#: catalog/gamemodes/hostage/hostage.lua
msgid "This is HOSTAGE mode: free the hostage held at the enemy tent. Get close and it follows; walk it home to score."
msgstr "Это режим HOSTAGE: освободи заложника из вражеской палатки. Подойди ближе -- он пойдёт за тобой; доведи его домой, чтобы заработать очко."

#: catalog/gamemodes/hostage/hostage.lua
msgid "Thanks for picking me up!"
msgstr "Спасибо, что забрал меня!"

#: catalog/gamemodes/hostage/hostage.lua
msgid "%(hero) brought the %(team) hostage home! +1 %(team)"
msgstr "%(hero) привёл заложника команды %(team) домой! +1 %(team)"

#: catalog/gamemodes/hostage/hostage.lua
msgid "%(killer) executed the %(team) hostage! +1 %(team)"
msgstr "%(killer) казнил заложника команды %(team)! +1 %(team)"

#: catalog/gamemodes/hostage/hostage.lua
msgid "%(escort) is freeing your hostage -- go support!"
msgstr "%(escort) освобождает твоего заложника -- иди на помощь!"

#: catalog/gamemodes/hostage/hostage.lua
msgid "A %(team) hostage is loose -- hunt it down and drag it back!"
msgstr "Заложник команды %(team) на свободе -- найди его и притащи обратно!"

#: catalog/gamemodes/hostage/hostage.lua
msgid "The %(team) hostage was dragged back to captivity."
msgstr "Заложника команды %(team) вернули в плен."

#: catalog/gamemodes/hostage/hostage.lua
msgid "Get me out of here!"
msgstr "Вытащите меня отсюда!"

#: catalog/gamemodes/hostage/hostage.lua
msgid "I'm a prisoner -- someone free me!"
msgstr "Я в плену -- освободите меня!"

#: catalog/gamemodes/hostage/hostage.lua
msgid "Psst! Come spring me from their tent!"
msgstr "Псст! Вытащи меня из их палатки!"

#: catalog/gamemodes/hostage/hostage.lua
msgid "I'm lost! Somebody come get me!"
msgstr "Я потерялся! Кто-нибудь, заберите меня!"

#: catalog/gamemodes/hostage/hostage.lua
msgid "Hello? Anyone? I'm stranded out here!"
msgstr "Эй? Есть кто? Я тут застрял!"

#: catalog/gamemodes/hostage/hostage.lua
msgid "Help, I don't know the way home!"
msgstr "Помогите, я не знаю дорогу домой!"

#: catalog/gamemodes/hostage/hostage.lua
msgid "Home at last -- thank you!"
msgstr "Наконец-то дома -- спасибо!"

#: catalog/gamemodes/hostage/hostage.lua
msgid "Argh -- they got me!"
msgstr "Ааа -- меня схватили!"

#: catalog/gamemodes/hostage/hostage.lua
msgid "They're right behind us!"
msgstr "Они прямо за нами!"

#: catalog/gamemodes/hostage/hostage.lua
msgid "Hurry, enemies close!"
msgstr "Скорее, враги рядом!"

#: catalog/gamemodes/hostage/hostage.lua
msgid "Watch out -- keepers!"
msgstr "Осторожно -- охрана!"

#: catalog/gamemodes/hostage/hostage.lua
msgid "This way, we're almost there!"
msgstr "Сюда, мы почти пришли!"

#: catalog/gamemodes/hostage/hostage.lua
msgid "Keep going, take me home!"
msgstr "Не останавливайся, веди меня домой!"

#: catalog/gamemodes/hostage/hostage.lua
msgid "Don't leave me behind!"
msgstr "Не бросай меня!"

#: catalog/gamemodes/hostage/hostage.lua
msgid "They've caught me -- help!"
msgstr "Меня поймали -- помогите!"

#: catalog/gamemodes/hostage/hostage.lua
msgid "I'm being dragged back!"
msgstr "Меня тащат обратно!"

#: catalog/gamemodes/hostage/hostage.lua
msgid "No -- not back to the cage!"
msgstr "Нет -- только не обратно в клетку!"

#: catalog/gamemodes/hostage/hostage.lua
msgid "%(team) hostage: not spawned (no tents?)"
msgstr "Заложник команды %(team): не появился (нет палаток?)"

#: catalog/gamemodes/hostage/hostage.lua
msgid "%(team) hostage: down, respawning"
msgstr "Заложник команды %(team): убит, возрождается"

#: catalog/gamemodes/hostage/hostage.lua
msgid "following %(name)"
msgstr "идёт за %(name)"

#: catalog/gamemodes/hostage/hostage.lua
msgid "being recaptured by %(name)"
msgstr "его отбивает %(name)"

#: catalog/gamemodes/hostage/hostage.lua
msgid "waiting at a tent"
msgstr "ждёт у палатки"

#: catalog/gamemodes/hostage/hostage.lua
msgid "stranded"
msgstr "потерялся"

#: catalog/gamemodes/hostage/hostage.lua
msgid "%(team) hostage: %(state) (%(dist) blocks from home)"
msgstr "Заложник команды %(team): %(state) (%(dist) блоков до дома)"

#: catalog/gamemodes/hostage/hostage.lua
msgctxt "command"
msgid "Show hostage status, or 'reset' them (needs the hostage cap)."
msgstr "Показать состояние заложников или сбросить их ('reset'; нужно право hostage)."

#: catalog/gamemodes/hostage/hostage.lua
msgid "You lack the 'hostage' cap."
msgstr "У тебя нет права 'hostage'."

#: catalog/gamemodes/hostage/hostage.lua
msgid "Hostages reset."
msgstr "Заложники сброшены."
