# machine-translated (LibreTranslate)
#: catalog/gamemodes/hostage/hostage.lua
#, fuzzy
msgid "This is HOSTAGE mode: free the hostage held at the enemy tent. Get close and it follows; walk it home to score."
msgstr "Это режим HOSTAGE: освободить заложника, удерживаемого у противника палатка. Подойдите ближе, и он следует; пройдите его домой, чтобы забить."

# machine-translated (LibreTranslate)
#: catalog/gamemodes/hostage/hostage.lua
#, fuzzy
msgid "Thanks for picking me up!"
msgstr "Спасибо, что забрал меня!"

# machine-translated (LibreTranslate)
#: catalog/gamemodes/hostage/hostage.lua
#, fuzzy
msgid "%(hero) brought the %(team) hostage home! +1 %(team)"
msgstr "%(hero) привез домой заложника %(team)! +1 %(team)"

# machine-translated (LibreTranslate)
#: catalog/gamemodes/hostage/hostage.lua
#, fuzzy
msgid "%(killer) executed the %(team) hostage! +1 %(team)"
msgstr "%(killer) казнил заложника %(team)! +1 %(team)"

# machine-translated (LibreTranslate)
#: catalog/gamemodes/hostage/hostage.lua
#, fuzzy
msgid "%(escort) is freeing your hostage -- go support!"
msgstr "%(escort) освобождает заложников - иди поддержи!"

# machine-translated (LibreTranslate)
#: catalog/gamemodes/hostage/hostage.lua
#, fuzzy
msgid "A %(team) hostage is loose -- hunt it down and drag it back!"
msgstr "Заложник %(team) свободен - выследите его и оттащите назад!"

# machine-translated (LibreTranslate)
#: catalog/gamemodes/hostage/hostage.lua
#, fuzzy
msgid "The %(team) hostage was dragged back to captivity."
msgstr "Заложник %(team) был возвращен в плен."

# machine-translated (LibreTranslate)
#: catalog/gamemodes/hostage/hostage.lua
#, fuzzy
msgid "Get me out of here!"
msgstr "Вытащи меня отсюда!"

# machine-translated (LibreTranslate)
#: catalog/gamemodes/hostage/hostage.lua
#, fuzzy
msgid "I'm a prisoner -- someone free me!"
msgstr "Я заключенный, кто-то освободит меня!"

# machine-translated (LibreTranslate)
#: catalog/gamemodes/hostage/hostage.lua
#, fuzzy
msgid "Psst! Come spring me from their tent!"
msgstr "Псс! Приезжайте ко мне из палатка!"

# machine-translated (LibreTranslate)
#: catalog/gamemodes/hostage/hostage.lua
#, fuzzy
msgid "I'm lost! Somebody come get me!"
msgstr "Я заблудился! Кто-нибудь, возьмите меня!"

# machine-translated (LibreTranslate)
#: catalog/gamemodes/hostage/hostage.lua
#, fuzzy
msgid "Hello? Anyone? I'm stranded out here!"
msgstr "Алло? Кто-нибудь? Я застрял здесь!"

# machine-translated (LibreTranslate)
#: catalog/gamemodes/hostage/hostage.lua
#, fuzzy
msgid "Help, I don't know the way home!"
msgstr "Помогите, я не знаю дорогу домой!"

# machine-translated (LibreTranslate)
#: catalog/gamemodes/hostage/hostage.lua
#, fuzzy
msgid "Home at last -- thank you!"
msgstr "Наконец-то домой - спасибо!"

# machine-translated (LibreTranslate)
#: catalog/gamemodes/hostage/hostage.lua
#, fuzzy
msgid "Argh -- they got me!"
msgstr "Арг - они поймали меня!"

# machine-translated (LibreTranslate)
#: catalog/gamemodes/hostage/hostage.lua
#, fuzzy
msgid "They're right behind us!"
msgstr "Они прямо за нами!"

# machine-translated (LibreTranslate)
#: catalog/gamemodes/hostage/hostage.lua
#, fuzzy
