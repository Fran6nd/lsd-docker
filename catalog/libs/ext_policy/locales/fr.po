#: catalog/libs/ext_policy/lib_ext_policy.lua
msgid "Your client is outdated, please update"
msgstr "Ton client est obsolète, mets-le à jour"

#: catalog/libs/ext_policy/lib_ext_policy.lua
msgid "Your client is outdated: you can only watch. Install ZeroSpades (or update your client), then reconnect."
msgstr "Ton client est obsolète : tu ne peux que regarder. Installe ZeroSpades (ou mets ton client à jour), puis reconnecte-toi."

#: catalog/libs/ext_policy/lib_ext_policy.lua
msgid "Your client is outdated (it lacks %(list)): you can only watch. Install ZeroSpades (or update your client), then reconnect."
msgstr "Ton client est obsolète (il lui manque %(list)) : tu ne peux que regarder. Installe ZeroSpades (ou mets ton client à jour), puis reconnecte-toi."

#: catalog/libs/ext_policy/lib_ext_policy.lua
msgid "Missing: %(list). You can play, but you will not see everything other players do."
msgstr "Manquant : %(list). Tu peux jouer, mais tu ne verras pas tout ce que voient les autres joueurs."
