#: catalog/libs/ext_policy/lib_ext_policy.lua
msgid "Your client is outdated, please update"
msgstr "Tu cliente está desactualizado, actualízalo"

#: catalog/libs/ext_policy/lib_ext_policy.lua
msgid "Your client is outdated: you can only watch. Install ZeroSpades (or update your client), then reconnect."
msgstr "Tu cliente está desactualizado: solo puedes mirar. Instala ZeroSpades (o actualiza tu cliente) y vuelve a conectarte."

#: catalog/libs/ext_policy/lib_ext_policy.lua
msgid "Your client is outdated (it lacks %(list)): you can only watch. Install ZeroSpades (or update your client), then reconnect."
msgstr "Tu cliente está desactualizado (le falta %(list)): solo puedes mirar. Instala ZeroSpades (o actualiza tu cliente) y vuelve a conectarte."

#: catalog/libs/ext_policy/lib_ext_policy.lua
msgid "Missing: %(list). You can play, but you will not see everything other players do."
msgstr "Faltan: %(list). Puedes jugar, pero no verás todo lo que hacen los demás jugadores."
