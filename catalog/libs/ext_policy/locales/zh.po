#: catalog/libs/ext_policy/lib_ext_policy.lua
msgid "Your client is outdated, please update"
msgstr "你的客户端已过时，请更新"

#: catalog/libs/ext_policy/lib_ext_policy.lua
msgid "Your client never answered the extension handshake, so it cannot leave spectator. Update it, or use ZeroSpades."
msgstr "你的客户端未响应扩展握手，因此无法离开观战。请更新客户端，或使用 ZeroSpades。"

#: catalog/libs/ext_policy/lib_ext_policy.lua
msgid "Missing: %(list). You cannot leave spectator without it -- update your client, then reconnect."
msgstr "缺少：%(list)。没有它你无法离开观战——请更新客户端后重新连接。"

#: catalog/libs/ext_policy/lib_ext_policy.lua
msgid "Missing: %(list). You cannot leave spectator without them -- update your client, then reconnect."
msgstr "缺少：%(list)。没有它们你无法离开观战——请更新客户端后重新连接。"

#: catalog/libs/ext_policy/lib_ext_policy.lua
msgid "Missing: %(list). You can play, but you will not see everything other players do."
msgstr "缺少：%(list)。你可以游戏，但无法看到其他玩家的所有动作。"
