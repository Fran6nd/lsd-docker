#: catalog/effects/world/the_fall/the_fall.lua
msgid "You can't build in the Fall."
msgstr "No puedes construir en la Caída."

#: catalog/effects/world/the_fall/the_fall.lua
msgid "You killed your way out. Back in the game."
msgstr "Te has abierto paso a base de bajas. De vuelta al juego."

#: catalog/effects/world/the_fall/the_fall.lua
msgid "You're going into the Fall. Kill someone to get out."
msgstr "Vas a la Caída. Mata a alguien para salir."

#: catalog/effects/world/the_fall/the_fall.lua
msgid "warning: here your first death drops you into the Fall, and only a kill gets you out."
msgstr "aviso: aquí tu primera muerte te manda a la Caída, y solo una baja te saca de ella."
