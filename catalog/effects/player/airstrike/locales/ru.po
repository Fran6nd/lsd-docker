#: catalog/effects/player/airstrike/airstrike.lua
msgid "warning: here airstrikes can be called in on you."
msgstr "внимание: здесь по тебе могут вызвать авиаудар."

#: catalog/effects/player/airstrike/airstrike.lua
msgid "An airstrike comes three seconds after the warning: run."
msgstr "Авиаудар придёт через три секунды после предупреждения: беги."

#: catalog/effects/player/airstrike/airstrike.lua
msgid "%(name) called in an airstrike! Get out of there!"
msgstr "%(name) вызвал авиаудар! Уходи оттуда!"

#: catalog/effects/player/airstrike/airstrike.lua
msgid "Aim at something to call an airstrike on it."
msgstr "Прицелься в цель, чтобы вызвать на неё авиаудар."

#: catalog/effects/player/airstrike/airstrike.lua
msgid "Airstrike!"
msgstr "Авиаудар!"

#: catalog/effects/player/airstrike/airstrike.lua
msgid "AIRSTRIKE INCOMING -- TAKE COVER!"
msgstr "АВИАУДАР -- В УКРЫТИЕ!"
