#: catalog/effects/player/airstrike/airstrike.lua
msgid "warning: here airstrikes can be called in on you."
msgstr "attention : ici, des frappes aériennes peuvent être appelées sur toi."

#: catalog/effects/player/airstrike/airstrike.lua
msgid "An airstrike comes three seconds after the warning: run."
msgstr "Une frappe aérienne tombe trois secondes après l'avertissement : cours !"

#: catalog/effects/player/airstrike/airstrike.lua
msgid "%(name) called in an airstrike! Get out of there!"
msgstr "%(name) a appelé une frappe aérienne ! Dégage de là !"

#: catalog/effects/player/airstrike/airstrike.lua
msgid "Aim at something to call an airstrike on it."
msgstr "Vise quelque chose pour y appeler une frappe aérienne."

#: catalog/effects/player/airstrike/airstrike.lua
msgid "Airstrike!"
msgstr "Frappe aérienne !"

#: catalog/effects/player/airstrike/airstrike.lua
msgid "AIRSTRIKE INCOMING -- TAKE COVER!"
msgstr "FRAPPE AÉRIENNE IMMINENTE -- METS-TOI À COUVERT !"
