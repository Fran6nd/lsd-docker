#: catalog/effects/player/medkit/medkit.lua
msgid "Type /m to use a medkit."
msgstr "Escribe /m para usar un botiquín."

#: catalog/effects/player/medkit/medkit.lua
msgid "Hurt? Type /m to use a medkit; restock at your tent."
msgstr "¿Herido? Escribe /m para usar un botiquín; reabastécete en tu tienda."

#: catalog/effects/player/medkit/medkit.lua
msgid "The medkit cannot bring you back from the dead."
msgstr "El botiquín no puede devolverte de entre los muertos."

#: catalog/effects/player/medkit/medkit.lua
msgid "You've already used all your medkits! Restock at the tent."
msgstr "¡Ya has usado todos tus botiquines! Reabastécete en la tienda."

#: catalog/effects/player/medkit/medkit.lua
msgid "The medkit only heals physical wounds."
msgstr "El botiquín solo cura heridas físicas."

#: catalog/effects/player/medkit/medkit.lua
msgctxt "command"
msgid "Use a medkit."
msgstr "Usar un botiquín."

#: catalog/effects/player/medkit/medkit.lua
msgid "You have no medkit here."
msgstr "Aquí no tienes botiquín."
