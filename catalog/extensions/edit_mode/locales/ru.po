#: catalog/extensions/edit_mode/lib_edit_mode.lua
msgctxt "command"
msgid "Switch a player's Edit Mode: no block limits, Block Batch."
msgstr "Переключить режим редактирования игрока: без лимита блоков, Block Batch."

#: catalog/extensions/edit_mode/lib_edit_mode.lua
msgid "Edit mode on for %(name)."
msgstr "Режим редактирования включён для %(name)."

#: catalog/extensions/edit_mode/lib_edit_mode.lua
msgid "Edit mode off for %(name)."
msgstr "Режим редактирования выключен для %(name)."

#: catalog/extensions/edit_mode/lib_edit_mode.lua
msgid "Edit mode on."
msgstr "Режим редактирования включён."

#: catalog/extensions/edit_mode/lib_edit_mode.lua
msgid "Edit mode off."
msgstr "Режим редактирования выключен."

#: catalog/extensions/edit_mode/lib_edit_mode.lua
msgid "%(name) is still connecting; edit mode goes on once their client has negotiated."
msgstr "%(name) ещё подключается; режим редактирования включится, когда клиент завершит согласование."

#: catalog/extensions/edit_mode/lib_edit_mode.lua
msgid "%(name)'s client does not support the Edit Mode extension."
msgstr "Клиент игрока %(name) не поддерживает расширение Edit Mode."

#: catalog/extensions/edit_mode/lib_edit_mode.lua
msgid "Edit mode: %(why)."
msgstr "Режим редактирования: %(why)."
