#: catalog/extensions/edit_mode/lib_edit_mode.lua
msgctxt "command"
msgid "Switch a player's Edit Mode: no block limits, Block Batch."
msgstr "Activar o desactivar el Modo Edición de un jugador: sin límite de bloques, Block Batch."

#: catalog/extensions/edit_mode/lib_edit_mode.lua
msgid "Edit mode on for %(name)."
msgstr "Modo edición activado para %(name)."

#: catalog/extensions/edit_mode/lib_edit_mode.lua
msgid "Edit mode off for %(name)."
msgstr "Modo edición desactivado para %(name)."

#: catalog/extensions/edit_mode/lib_edit_mode.lua
msgid "Edit mode on."
msgstr "Modo edición activado."

#: catalog/extensions/edit_mode/lib_edit_mode.lua
msgid "Edit mode off."
msgstr "Modo edición desactivado."

#: catalog/extensions/edit_mode/lib_edit_mode.lua
msgid "%(name) is still connecting; edit mode goes on once their client has negotiated."
msgstr "%(name) aún se está conectando; el modo edición se activará cuando su cliente termine la negociación."

#: catalog/extensions/edit_mode/lib_edit_mode.lua
msgid "%(name)'s client does not support the Edit Mode extension."
msgstr "El cliente de %(name) no admite la extensión Modo Edición."

#: catalog/extensions/edit_mode/lib_edit_mode.lua
msgid "Edit mode: %(why)."
msgstr "Modo edición: %(why)."
