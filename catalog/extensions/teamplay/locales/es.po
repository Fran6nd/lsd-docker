#: catalog/extensions/teamplay/lib_teamplay.lua
msgid "Pinging is turned off on this server."
msgstr "Las marcas están desactivadas en este servidor."

#: catalog/extensions/teamplay/lib_teamplay.lua
msgid "You cannot ping while dead."
msgstr "No puedes marcar estando muerto."

#: catalog/extensions/teamplay/lib_teamplay.lua
msgid "Too soon: wait a moment before pinging again."
msgstr "Demasiado pronto: espera un momento antes de volver a marcar."

#: catalog/extensions/teamplay/lib_teamplay.lua
msgid "That position is off the map."
msgstr "Esa posición está fuera del mapa."

#: catalog/extensions/teamplay/lib_teamplay.lua
msgid "You can only ping what you are looking at."
msgstr "Solo puedes marcar lo que estás mirando."

#: catalog/extensions/teamplay/lib_teamplay.lua
msgid "Unknown command"
msgstr "Comando desconocido"

#: catalog/extensions/teamplay/lib_teamplay.lua
msgid "Nothing to ping: /pingmark needs a position, three numbers, before the reason."
msgstr "Nada que marcar: /pingmark necesita una posición, tres números, antes del motivo."

#: catalog/extensions/teamplay/lib_teamplay.lua
msgctxt "command"
msgid "Ping a position for your team."
msgstr "Marcar una posición para tu equipo."

#: catalog/extensions/teamplay/lib_teamplay.lua
msgid "Enemy"
msgstr "Enemigo"

#: catalog/extensions/teamplay/lib_teamplay.lua
msgid "Ping this spot for your team"
msgstr "Marcar este punto para tu equipo"

#: catalog/extensions/teamplay/lib_teamplay.lua
msgid "Attack"
msgstr "Atacar"

#: catalog/extensions/teamplay/lib_teamplay.lua
msgid "Defend"
msgstr "Defender"

#: catalog/extensions/teamplay/lib_teamplay.lua
msgid "Need help"
msgstr "Necesito ayuda"

#: catalog/extensions/teamplay/lib_teamplay.lua
msgid "Danger"
msgstr "Peligro"

#: catalog/extensions/teamplay/lib_teamplay.lua
msgid "Go here"
msgstr "Ve aquí"
