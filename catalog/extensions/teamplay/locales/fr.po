#: catalog/extensions/teamplay/lib_teamplay.lua
msgid "Pinging is turned off on this server."
msgstr "Les signalements sont désactivés sur ce serveur."

#: catalog/extensions/teamplay/lib_teamplay.lua
msgid "You cannot ping while dead."
msgstr "Tu ne peux pas signaler en étant mort."

#: catalog/extensions/teamplay/lib_teamplay.lua
msgid "Too soon: wait a moment before pinging again."
msgstr "Trop tôt : attends un peu avant de signaler à nouveau."

#: catalog/extensions/teamplay/lib_teamplay.lua
msgid "That position is off the map."
msgstr "Cette position est hors de la carte."

#: catalog/extensions/teamplay/lib_teamplay.lua
msgid "You can only ping what you are looking at."
msgstr "Tu ne peux signaler que ce que tu regardes."

#: catalog/extensions/teamplay/lib_teamplay.lua
msgid "Unknown command"
msgstr "Commande inconnue"

#: catalog/extensions/teamplay/lib_teamplay.lua
msgid "Nothing to ping: /pingmark needs a position, three numbers, before the reason."
msgstr "Rien à signaler : /pingmark veut une position, trois nombres, avant la raison."

#: catalog/extensions/teamplay/lib_teamplay.lua
msgctxt "command"
msgid "Ping a position for your team."
msgstr "Signaler une position à ton équipe."

#: catalog/extensions/teamplay/lib_teamplay.lua
msgid "Enemy"
msgstr "Ennemi"

#: catalog/extensions/teamplay/lib_teamplay.lua
msgid "Ping this spot for your team"
msgstr "Signaler cet endroit à l'équipe"

#: catalog/extensions/teamplay/lib_teamplay.lua
msgid "Attack"
msgstr "Attaquer"

#: catalog/extensions/teamplay/lib_teamplay.lua
msgid "Defend"
msgstr "Défendre"

#: catalog/extensions/teamplay/lib_teamplay.lua
msgid "Need help"
msgstr "À l'aide"

#: catalog/extensions/teamplay/lib_teamplay.lua
msgid "Danger"
msgstr "Danger"

#: catalog/extensions/teamplay/lib_teamplay.lua
msgid "Go here"
msgstr "Aller ici"
