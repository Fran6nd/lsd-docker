#: catalog/tools/vote_map/vote_map.lua
msgid "%(name) wants the next map: type /va to agree (%(have)/%(need))."
msgstr "%(name) хочет следующую карту: набери /va, чтобы согласиться (%(have)/%(need))."

#: catalog/tools/vote_map/vote_map.lua
msgid "%(name) wants the next map (%(have)/%(need))."
msgstr "%(name) хочет следующую карту (%(have)/%(need))."

#: catalog/tools/vote_map/vote_map.lua
msgid "You already voted for the next map."
msgstr "Ты уже проголосовал за следующую карту."

#: catalog/tools/vote_map/vote_map.lua
msgid "The vote carried: on to the next map."
msgstr "Голосование прошло: переходим к следующей карте."

#: catalog/tools/vote_map/vote_map.lua
msgid "Fetching a new map from the web..."
msgstr "Ищем новую карту в сети..."

#: catalog/tools/vote_map/vote_map.lua
msgid "No new map could be had: on to the next one here."
msgstr "Новую карту получить не удалось: переходим к следующей здесь."

#: catalog/tools/vote_map/vote_map.lua
msgid "The vote for the next map failed."
msgstr "Голосование за следующую карту провалилось."

#: catalog/tools/vote_map/vote_map.lua
msgid "A new map is already on its way."
msgstr "Новая карта уже в пути."

#: catalog/tools/vote_map/vote_map.lua
msgctxt "command"
msgid "Vote to move on to the next map (a new one from the web where maps are random)."
msgstr "Проголосовать за переход к следующей карте (новой из сети, если карты случайные)."
