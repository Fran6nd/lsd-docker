#: catalog/tools/votekick/votekick.lua
msgid "%(starter) started a votekick against %(target)! Type /y to vote (%(have)/%(need))."
msgstr "%(starter) 发起了对 %(target) 的投票踢人！输入 /y 投票（%(have)/%(need)）。"

#: catalog/tools/votekick/votekick.lua
msgid "%(voter) voted to kick %(target) (%(have)/%(need))."
msgstr "%(voter) 投票踢出 %(target)（%(have)/%(need)）。"

#: catalog/tools/votekick/votekick.lua
msgid "%(target) was votekicked."
msgstr "%(target) 已被投票踢出。"

#: catalog/tools/votekick/votekick.lua
msgid "The votekick against %(target) failed."
msgstr "对 %(target) 的投票踢人失败。"

#: catalog/tools/votekick/votekick.lua
msgid "You already voted."
msgstr "你已经投过票了。"

#: catalog/tools/votekick/votekick.lua
msgid "No votekick is in progress -- start one with /votekick <player>."
msgstr "当前没有进行中的投票踢人——用 /votekick <player> 发起。"

#: catalog/tools/votekick/votekick.lua
msgid "Not enough players for a votekick."
msgstr "玩家人数不足，无法投票踢人。"

#: catalog/tools/votekick/votekick.lua
msgid "You can't votekick yourself."
msgstr "你不能投票踢自己。"

#: catalog/tools/votekick/votekick.lua
msgid "%(target) can't be votekicked."
msgstr "%(target) 无法被投票踢出。"

#: catalog/tools/votekick/votekick.lua
msgid "Vote kicked"
msgstr "被投票踢出"

#: catalog/tools/votekick/votekick.lua
msgctxt "command"
msgid "Start (or add your voice to) a vote to kick a player."
msgstr "发起（或参与）踢出一名玩家的投票。"

#: catalog/tools/votekick/votekick.lua
msgid "Vote kick"
msgstr "投票踢人"

#: catalog/tools/votekick/votekick.lua
msgid "Start a vote to kick this player"
msgstr "发起投票踢出此玩家"

#: catalog/tools/votekick/votekick.lua
msgctxt "command"
msgid "Vote yes on the current votekick."
msgstr "对当前投票踢人投赞成票。"
