#: catalog/tools/votekick/votekick.lua
msgid "%(starter) started a votekick against %(target)! Type /y to vote (%(have)/%(need))."
msgstr "¡%(starter) inició una votación de expulsión contra %(target)! Escribe /y para votar (%(have)/%(need))."

#: catalog/tools/votekick/votekick.lua
msgid "%(voter) voted to kick %(target) (%(have)/%(need))."
msgstr "%(voter) votó por expulsar a %(target) (%(have)/%(need))."

#: catalog/tools/votekick/votekick.lua
msgid "%(target) was votekicked."
msgstr "%(target) fue expulsado por votación."

#: catalog/tools/votekick/votekick.lua
msgid "The votekick against %(target) failed."
msgstr "La votación de expulsión contra %(target) fracasó."

#: catalog/tools/votekick/votekick.lua
msgid "You already voted."
msgstr "Ya has votado."

#: catalog/tools/votekick/votekick.lua
msgid "No votekick is in progress -- start one with /votekick <player>."
msgstr "No hay ninguna votación de expulsión en curso -- inicia una con /votekick <jugador>."

#: catalog/tools/votekick/votekick.lua
msgid "Not enough players for a votekick."
msgstr "No hay suficientes jugadores para una votación de expulsión."

#: catalog/tools/votekick/votekick.lua
msgid "You can't votekick yourself."
msgstr "No puedes iniciar una votación de expulsión contra ti mismo."

#: catalog/tools/votekick/votekick.lua
msgid "%(target) can't be votekicked."
msgstr "%(target) no puede ser expulsado por votación."

#: catalog/tools/votekick/votekick.lua
msgid "Vote kicked"
msgstr "Expulsado por votación"

#: catalog/tools/votekick/votekick.lua
msgctxt "command"
msgid "Start (or add your voice to) a vote to kick a player."
msgstr "Iniciar (o apoyar) una votación para expulsar a un jugador."

#: catalog/tools/votekick/votekick.lua
msgid "Vote kick"
msgstr "Votar expulsión"

#: catalog/tools/votekick/votekick.lua
msgid "Start a vote to kick this player"
msgstr "Iniciar una votación para expulsar a este jugador"

#: catalog/tools/votekick/votekick.lua
msgctxt "command"
msgid "Vote yes on the current votekick."
msgstr "Votar sí en la votación de expulsión actual."
