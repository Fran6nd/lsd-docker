#: catalog/tools/votekick/votekick.lua
msgid "%(starter) started a votekick against %(target)! Type /y to vote (%(have)/%(need))."
msgstr "%(starter) a lancé un vote d'exclusion contre %(target) ! Tape /y pour voter (%(have)/%(need))."

#: catalog/tools/votekick/votekick.lua
msgid "%(voter) voted to kick %(target) (%(have)/%(need))."
msgstr "%(voter) a voté pour exclure %(target) (%(have)/%(need))."

#: catalog/tools/votekick/votekick.lua
msgid "%(target) was votekicked."
msgstr "%(target) a été exclu par vote."

#: catalog/tools/votekick/votekick.lua
msgid "The votekick against %(target) failed."
msgstr "Le vote d'exclusion contre %(target) a échoué."

#: catalog/tools/votekick/votekick.lua
msgid "You already voted."
msgstr "Tu as déjà voté."

#: catalog/tools/votekick/votekick.lua
msgid "No votekick is in progress -- start one with /votekick <player>."
msgstr "Aucun vote d'exclusion en cours -- lance-en un avec /votekick <joueur>."

#: catalog/tools/votekick/votekick.lua
msgid "Not enough players for a votekick."
msgstr "Pas assez de joueurs pour un vote d'exclusion."

#: catalog/tools/votekick/votekick.lua
msgid "You can't votekick yourself."
msgstr "Tu ne peux pas voter ta propre exclusion."

#: catalog/tools/votekick/votekick.lua
msgid "%(target) can't be votekicked."
msgstr "%(target) ne peut pas être exclu par vote."

#: catalog/tools/votekick/votekick.lua
msgid "Vote kicked"
msgstr "Expulsé par vote"

#: catalog/tools/votekick/votekick.lua
msgctxt "command"
msgid "Start (or add your voice to) a vote to kick a player."
msgstr "Lancer (ou rejoindre) un vote pour exclure un joueur."

#: catalog/tools/votekick/votekick.lua
msgid "Vote kick"
msgstr "Voter l'exclusion"

#: catalog/tools/votekick/votekick.lua
msgid "Start a vote to kick this player"
msgstr "Lancer un vote pour exclure ce joueur"

#: catalog/tools/votekick/votekick.lua
msgctxt "command"
msgid "Vote yes on the current votekick."
msgstr "Voter oui au vote d'exclusion en cours."
