#: catalog/tools/votekick/votekick.lua
msgid "%(starter) started a votekick against %(target)! Type /y to vote (%(have)/%(need))."
msgstr "%(starter) начал голосование за кик игрока %(target)! Введи /y, чтобы проголосовать (%(have)/%(need))."

#: catalog/tools/votekick/votekick.lua
msgid "%(voter) voted to kick %(target) (%(have)/%(need))."
msgstr "%(voter) голосует за кик игрока %(target) (%(have)/%(need))."

#: catalog/tools/votekick/votekick.lua
msgid "%(target) was votekicked."
msgstr "Игрок %(target) кикнут голосованием."

#: catalog/tools/votekick/votekick.lua
msgid "The votekick against %(target) failed."
msgstr "Голосование за кик игрока %(target) провалилось."

#: catalog/tools/votekick/votekick.lua
msgid "You already voted."
msgstr "Ты уже проголосовал."

#: catalog/tools/votekick/votekick.lua
msgid "No votekick is in progress -- start one with /votekick <player>."
msgstr "Голосования за кик сейчас нет -- начни его командой /votekick <игрок>."

#: catalog/tools/votekick/votekick.lua
msgid "Not enough players for a votekick."
msgstr "Недостаточно игроков для голосования за кик."

#: catalog/tools/votekick/votekick.lua
msgid "You can't votekick yourself."
msgstr "Нельзя голосовать за кик самого себя."

#: catalog/tools/votekick/votekick.lua
msgid "%(target) can't be votekicked."
msgstr "Игрока %(target) нельзя кикнуть голосованием."

#: catalog/tools/votekick/votekick.lua
msgid "Vote kicked"
msgstr "Кикнут голосованием"

#: catalog/tools/votekick/votekick.lua
msgctxt "command"
msgid "Start (or add your voice to) a vote to kick a player."
msgstr "Начать голосование за кик игрока (или поддержать текущее)."

#: catalog/tools/votekick/votekick.lua
msgid "Vote kick"
msgstr "Кик голосованием"

#: catalog/tools/votekick/votekick.lua
msgid "Start a vote to kick this player"
msgstr "Начать голосование за кик этого игрока"

#: catalog/tools/votekick/votekick.lua
msgctxt "command"
msgid "Vote yes on the current votekick."
msgstr "Проголосовать «за» в текущем голосовании за кик."
