#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: cannot write %(path) (%(err)) -- drop the :ro on the maps mount to persist"
msgstr "world_editor: не удалось записать %(path) (%(err)) -- убери :ro у монтирования maps, чтобы сохранялось"

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: %(path) is not valid json, ignoring"
msgstr "world_editor: %(path) -- невалидный json, пропускаю"

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: loaded %(path)"
msgstr "world_editor: загружен %(path)"

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: could not load %(name) (%(err))"
msgstr "world_editor: не удалось загрузить %(name) (%(err))"

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: could not delist (%(err))"
msgstr "world_editor: не удалось убрать из списков (%(err))"

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: could not relist (%(err))"
msgstr "world_editor: не удалось вернуть в списки (%(err))"

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: relisted after a reload (edit mode did not survive it)"
msgstr "world_editor: снова в списках после перезагрузки (режим редактирования её не пережил)"

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: component %(name) failed to load: %(err)"
msgstr "world_editor: компонент %(name) не загрузился: %(err)"

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: edit mode %(state)"
msgstr "world_editor: режим редактирования %(state)"

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: cannot write %(path) (%(err))"
msgstr "world_editor: не удалось записать %(path) (%(err))"

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: not in edit mode (enable it from the console)."
msgstr "world_editor: режим редактирования выключен (включи его из консоли)."

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: edit mode can only be toggled from the console."
msgstr "world_editor: режим редактирования переключается только из консоли."

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: edit mode is %(state) (map %(map))%(extra)"
msgstr "world_editor: режим редактирования %(state) (карта %(map))%(extra)"

#: catalog/tools/world_editor/world_editor.lua
msgid ", delisted by edit mode"
msgstr ", убран из списков режимом редактирования"

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: created %(path)"
msgstr "world_editor: создан %(path)"

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: %(names) loaded -- terrain editing and flight for the session."
msgstr "world_editor: загружено %(names) -- редактирование рельефа и полёт на эту сессию."

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: delisted from the public lists (ip:port still works, so you can invite builders in)"
msgstr "world_editor: убран из публичных списков (ip:port по-прежнему работает, так что строителей можно пригласить)"

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: listed publicly again."
msgstr "world_editor: снова в публичных списках."

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: edit mode ENABLED -- the map is being built on."
msgstr "world_editor: режим редактирования ВКЛЮЧЁН -- карту строят."

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: edit mode disabled."
msgstr "world_editor: режим редактирования выключен."

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: placeable -- %(names)"
msgstr "world_editor: можно разместить -- %(names)"

#: catalog/tools/world_editor/world_editor.lua
msgid "  /place <component> for its help, e.g. /place elevator"
msgstr "  /place <компонент> -- его справка, напр. /place elevator"

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: no such component. placeable: %(names)"
msgstr "world_editor: нет такого компонента. можно разместить: %(names)"

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: %(name) -- %(desc)"
msgstr "world_editor: %(name) -- %(desc)"

#: catalog/tools/world_editor/world_editor.lua
msgid "  usage: /place %(name) %(usage)"
msgstr "  использование: /place %(name) %(usage)"

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: %(text)"
msgstr "world_editor: %(text)"

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: nothing being placed -- start with /place or /chunk."
msgstr "world_editor: ничего не размещается -- начни с /place или /chunk."

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: pick the two corners of the %(kind) -- aim and click each one."
msgstr "world_editor: выбери два угла (%(kind)) -- наведись и кликни по каждому."

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: nothing being placed -- start with /place, /chunk or /delete."
msgstr "world_editor: ничего не размещается -- начни с /place, /chunk или /delete."

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: spade or shoot a block of the component to delete."
msgstr "world_editor: ударь лопатой или выстрели в блок компонента, чтобы удалить его."

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: spade two opposite corners."
msgstr "world_editor: ударь лопатой по двум противоположным углам."

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: spade the centre, then the edge."
msgstr "world_editor: ударь лопатой по центру, затем по краю."

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: mark at %(x) %(y) %(z)"
msgstr "world_editor: отметка в %(x) %(y) %(z)"

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: that mark is outside the map."
msgstr "world_editor: эта отметка за пределами карты."

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: nothing to mark there -- aim at ground or water."
msgstr "world_editor: тут нечего отметить -- наведись на землю или воду."

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: placement finished on mark %(n) -- %(extra) extra ignored."
msgstr "world_editor: размещение завершено на отметке %(n) -- лишние (%(extra)) пропущены."

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: %(kind) #%(id) placed."
msgstr "world_editor: %(kind) #%(id) размещён."

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: no component on that block -- aim right at one."
msgstr "world_editor: на этом блоке нет компонента -- наведись точно на него."

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: no components on this map."
msgstr "world_editor: на этой карте нет компонентов."

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: broke %(kind) #%(id)."
msgstr "world_editor: сломан %(kind) #%(id)."

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: %(verb) %(kind) #%(id) -- its blocks stay, back at rest."
msgstr "world_editor: %(kind) #%(id): %(verb) -- его блоки остаются, в состоянии покоя."

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: nothing to undo."
msgstr "world_editor: нечего отменять."

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: %(kind) #%(id) is now %(perm)"
msgstr "world_editor: %(kind) #%(id) теперь %(perm)"

#: catalog/tools/world_editor/world_editor.lua
msgid "  #%(id) %(kind) at %(x),%(y) %(perm) blocks %(blocks) %(status)"
msgstr "  #%(id) %(kind) в %(x),%(y) %(perm) блоков %(blocks) %(status)"

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: perm must be ro, rw, or rw:<team>."
msgstr "world_editor: права должны быть ro, rw или rw:<команда>."

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: chunk %(name) (%(perm)) created."
msgstr "world_editor: зона %(name) (%(perm)) создана."

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: you are not in a chunk (use /defaultperm for the open map)."
msgstr "world_editor: ты не в зоне (для открытой карты используй /defaultperm)."

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: %(name) is now %(perm)"
msgstr "world_editor: %(name) теперь %(perm)"

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: removed chunk %(name)"
msgstr "world_editor: зона %(name) удалена"

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: default %(perm)%(readonly)"
msgstr "world_editor: по умолчанию %(perm)%(readonly)"

#: catalog/tools/world_editor/world_editor.lua
msgid ", map READONLY"
msgstr ", карта ТОЛЬКО ДЛЯ ЧТЕНИЯ"

#: catalog/tools/world_editor/world_editor.lua
msgid "  #%(id) %(name) %(shape) %(perm)"
msgstr "  #%(id) %(name) %(shape) %(perm)"

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: default is now %(perm)"
msgstr "world_editor: по умолчанию теперь %(perm)"

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: map readonly %(state)"
msgstr "world_editor: карта только для чтения: %(state)"

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: no map name known -- pass one: /wesavemap <name>."
msgstr "world_editor: имя карты неизвестно -- укажи его: /wesavemap <имя>."

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: bad name (no / \\ or leading dot)."
msgstr "world_editor: плохое имя (без / \\ и точки в начале)."

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: saved %(name).vxl + %(name).editor.json in %(dir)/"
msgstr "world_editor: сохранено %(name).vxl + %(name).editor.json в %(dir)/"

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: save failed -- see server log (is maps/ writable?)."
msgstr "world_editor: сохранить не удалось -- см. лог сервера (доступна ли запись в maps/?)."

#: catalog/tools/world_editor/world_editor.lua
msgctxt "command"
msgid "Toggle world edit mode (console only)."
msgstr "Переключить режим редактирования мира (только из консоли)."

#: catalog/tools/world_editor/world_editor.lua
msgctxt "command"
msgid "Place a component; /place alone lists them, /place <c> shows help."
msgstr "Разместить компонент; /place без аргументов -- список, /place <к> -- справка."

#: catalog/tools/world_editor/world_editor.lua
msgctxt "command"
msgid "Drop a placement mark where you are (or at x y z)."
msgstr "Поставить отметку размещения там, где ты стоишь (или в x y z)."

#: catalog/tools/world_editor/world_editor.lua
msgctxt "command"
msgid "Place one or more placement marks by coordinate."
msgstr "Поставить одну или несколько отметок размещения по координатам."

#: catalog/tools/world_editor/world_editor.lua
msgctxt "command"
msgid "Set protection on the nearest component."
msgstr "Задать защиту ближайшего компонента."

#: catalog/tools/world_editor/world_editor.lua
msgctxt "command"
msgid "Un-place the most recent component (its blocks stay)."
msgstr "Отменить размещение последнего компонента (его блоки остаются)."

#: catalog/tools/world_editor/world_editor.lua
msgctxt "command"
msgid "Un-place the component whose block you mark (its blocks stay)."
msgstr "Отменить размещение компонента, чей блок ты отметишь (его блоки остаются)."

#: catalog/tools/world_editor/world_editor.lua
msgctxt "command"
msgid "Save the map (.vxl) and its components (.editor.json) to maps/."
msgstr "Сохранить карту (.vxl) и её компоненты (.editor.json) в maps/."

#: catalog/tools/world_editor/world_editor.lua
msgctxt "command"
msgid "Create an authorization chunk (spade two marks to set its extent)."
msgstr "Создать зону доступа (ударь лопатой по двум отметкам, чтобы задать её границы)."

#: catalog/tools/world_editor/world_editor.lua
msgctxt "command"
msgid "Set the authorization of the chunk you are standing in."
msgstr "Задать доступ для зоны, в которой ты стоишь."

#: catalog/tools/world_editor/world_editor.lua
msgctxt "command"
msgid "Delete the chunk you are standing in."
msgstr "Удалить зону, в которой ты стоишь."

#: catalog/tools/world_editor/world_editor.lua
msgctxt "command"
msgid "List placed components and their live state."
msgstr "Показать размещённые компоненты и их текущее состояние."

#: catalog/tools/world_editor/world_editor.lua
msgctxt "command"
msgid "List authorization chunks."
msgstr "Показать зоны доступа."

#: catalog/tools/world_editor/world_editor.lua
msgctxt "command"
msgid "Authorization for blocks outside every chunk (console only)."
msgstr "Доступ для блоков вне всех зон (только из консоли)."

#: catalog/tools/world_editor/world_editor.lua
msgctxt "command"
msgid "Master lock: refuse every player block edit (console only)."
msgstr "Общий замок: запретить игрокам любые изменения блоков (только из консоли)."

#: catalog/tools/world_editor/world_editor/door.lua
msgid "direction must be up, down, left or right."
msgstr "направление должно быть up, down, left или right."

#: catalog/tools/world_editor/world_editor/door.lua
msgid "mark one corner of the door."
msgstr "отметь один угол двери."

#: catalog/tools/world_editor/world_editor/door.lua
msgid "now mark the opposite corner."
msgstr "теперь отметь противоположный угол."

#: catalog/tools/world_editor/world_editor/door.lua
msgid "a vertical door needs height -- mark corners at different heights."
msgstr "вертикальной двери нужна высота -- отметь углы на разной высоте."

#: catalog/tools/world_editor/world_editor/door.lua
msgid "a sliding door needs width -- mark corners apart horizontally."
msgstr "раздвижной двери нужна ширина -- отметь углы на расстоянии по горизонтали."

#: catalog/tools/world_editor/world_editor/door.lua
msgid "that box overlaps another component -- mark clear of it."
msgstr "эта область пересекает другой компонент -- отмечай в стороне от него."

#: catalog/tools/world_editor/world_editor/door.lua
msgid "a door is a panel, not a block of wall -- one of its two horizontal sides has to be a single block thick."
msgstr "дверь -- это панель, а не кусок стены: по одной из двух горизонтальных осей она должна быть толщиной в один блок."

#: catalog/tools/world_editor/world_editor/door.lua
msgid "world_editor: door -- a built surface that retracts when a player nears it."
msgstr "world_editor: door -- построенная поверхность, которая убирается, когда к ней подходит игрок."

#: catalog/tools/world_editor/world_editor/door.lua
msgid "  usage: /place door <up|down|left|right>"
msgstr "  использование: /place door <up|down|left|right>"

#: catalog/tools/world_editor/world_editor/door.lua
msgid "  up/down retract into ceiling/floor; left/right retract aside."
msgstr "  up/down убираются в потолок/пол; left/right -- в сторону."

#: catalog/tools/world_editor/world_editor/door.lua
msgid "  build the shape first, then mark two opposite corners around it:"
msgstr "  сначала построй форму, затем отметь вокруг неё два противоположных угла:"

#: catalog/tools/world_editor/world_editor/door.lua
msgid "  its blocks, colours and gaps all become the door and move together."
msgstr "  все её блоки, цвета и пустоты становятся дверью и двигаются вместе."

#: catalog/tools/world_editor/world_editor/door.lua
msgid "  the panel retracts into the marked box and needs no room behind it."
msgstr "  панель убирается внутрь отмеченной области, место за ней не нужно."

#: catalog/tools/world_editor/world_editor/door.lua
msgid "  an empty box gives a solid panel in your palette colour instead."
msgstr "  пустая область даёт сплошную панель твоего цвета из палитры."

#: catalog/tools/world_editor/world_editor/elevator.lua
msgid "direction must be up or down."
msgstr "направление должно быть up или down."

#: catalog/tools/world_editor/world_editor/elevator.lua
msgid "mark one corner of the platform."
msgstr "отметь один угол платформы."

#: catalog/tools/world_editor/world_editor/elevator.lua
msgid "now mark the opposite corner of the platform."
msgstr "теперь отметь противоположный угол платформы."

#: catalog/tools/world_editor/world_editor/elevator.lua
msgid "now mark a block at the altitude to travel to."
msgstr "теперь отметь блок на высоте, куда ехать."

#: catalog/tools/world_editor/world_editor/elevator.lua
msgid "that altitude is the platform's own level -- mark a different height."
msgstr "это уровень самой платформы -- отметь другую высоту."

#: catalog/tools/world_editor/world_editor/elevator.lua
msgid "the shaft would run through another component -- pick another altitude."
msgstr "шахта пройдёт через другой компонент -- выбери другую высоту."

#: catalog/tools/world_editor/world_editor/elevator.lua
msgid "world_editor: elevator -- a built platform that carries riders up or down."
msgstr "world_editor: elevator -- построенная платформа, которая возит игроков вверх или вниз."

#: catalog/tools/world_editor/world_editor/elevator.lua
msgid "  usage: /place elevator <up|down>"
msgstr "  использование: /place elevator <up|down>"

#: catalog/tools/world_editor/world_editor/elevator.lua
msgid "  up rests at the bottom and rises when stood on; down is the reverse."
msgstr "  up стоит внизу и поднимается, когда на неё встают; down -- наоборот."

#: catalog/tools/world_editor/world_editor/elevator.lua
msgid "  build the pad first, then mark two opposite corners around it,"
msgstr "  сначала построй площадку, затем отметь вокруг неё два противоположных угла,"

#: catalog/tools/world_editor/world_editor/elevator.lua
msgid "  then mark the altitude it should travel to -- the pad comes to"
msgstr "  затем отметь высоту, куда ей ехать -- площадка"

#: catalog/tools/world_editor/world_editor/elevator.lua
msgid "  rest level with that mark."
msgstr "  остановится вровень с этой отметкой."

#: catalog/tools/world_editor/world_editor/elevator.lua
msgid "  its blocks, colours and gaps all become the platform."
msgstr "  все её блоки, цвета и пустоты становятся платформой."

#: catalog/tools/world_editor/world_editor/elevator.lua
msgid "  the piston column under it takes the colour of the pad's core."
msgstr "  поршневая колонна под ней берёт цвет центра площадки."

#: catalog/tools/world_editor/world_editor/elevator.lua
msgid "  an empty box gives a plain slab in your palette colour instead."
msgstr "  пустая область даёт простую плиту твоего цвета из палитры."
