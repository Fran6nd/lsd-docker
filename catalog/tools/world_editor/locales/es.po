#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: cannot write %(path) (%(err)) -- drop the :ro on the maps mount to persist"
msgstr "world_editor: no se puede escribir %(path) (%(err)) -- quita el :ro del montaje de maps para que persista"

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: %(path) is not valid json, ignoring"
msgstr "world_editor: %(path) no es json válido, se ignora"

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: loaded %(path)"
msgstr "world_editor: cargado %(path)"

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: could not load %(name) (%(err))"
msgstr "world_editor: no se pudo cargar %(name) (%(err))"

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: could not delist (%(err))"
msgstr "world_editor: no se pudo retirar de las listas (%(err))"

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: could not relist (%(err))"
msgstr "world_editor: no se pudo volver a listar (%(err))"

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: relisted after a reload (edit mode did not survive it)"
msgstr "world_editor: listado de nuevo tras una recarga (el modo edición no sobrevivió)"

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: component %(name) failed to load: %(err)"
msgstr "world_editor: el componente %(name) no se pudo cargar: %(err)"

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: edit mode %(state)"
msgstr "world_editor: modo edición %(state)"

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: cannot write %(path) (%(err))"
msgstr "world_editor: no se puede escribir %(path) (%(err))"

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: not in edit mode (enable it from the console)."
msgstr "world_editor: no estás en modo edición (actívalo desde la consola)."

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: edit mode can only be toggled from the console."
msgstr "world_editor: el modo edición solo se puede alternar desde la consola."

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: edit mode is %(state) (map %(map))%(extra)"
msgstr "world_editor: el modo edición está %(state) (mapa %(map))%(extra)"

#: catalog/tools/world_editor/world_editor.lua
msgid ", delisted by edit mode"
msgstr ", retirado de las listas por el modo edición"

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: created %(path)"
msgstr "world_editor: creado %(path)"

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: %(names) loaded -- terrain editing and flight for the session."
msgstr "world_editor: %(names) cargados -- edición de terreno y vuelo para la sesión."

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: delisted from the public lists (ip:port still works, so you can invite builders in)"
msgstr "world_editor: retirado de las listas públicas (ip:puerto sigue funcionando, así que puedes invitar a constructores)"

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: listed publicly again."
msgstr "world_editor: listado públicamente de nuevo."

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: edit mode ENABLED -- the map is being built on."
msgstr "world_editor: modo edición ACTIVADO -- se está construyendo el mapa."

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: edit mode disabled."
msgstr "world_editor: modo edición desactivado."

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: placeable -- %(names)"
msgstr "world_editor: colocables -- %(names)"

#: catalog/tools/world_editor/world_editor.lua
msgid "  /place <component> for its help, e.g. /place elevator"
msgstr "  /place <componente> para ver su ayuda, p. ej. /place elevator"

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: no such component. placeable: %(names)"
msgstr "world_editor: no existe ese componente. colocables: %(names)"

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: %(name) -- %(desc)"
msgstr "world_editor: %(name) -- %(desc)"

#: catalog/tools/world_editor/world_editor.lua
msgid "  usage: /place %(name) %(usage)"
msgstr "  uso: /place %(name) %(usage)"

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: %(text)"
msgstr "world_editor: %(text)"

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: nothing being placed -- start with /place or /chunk."
msgstr "world_editor: no se está colocando nada -- empieza con /place o /chunk."

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: pick the two corners of the %(kind) -- aim and click each one."
msgstr "world_editor: elige las dos esquinas de %(kind) -- apunta y haz clic en cada una."

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: nothing being placed -- start with /place, /chunk or /delete."
msgstr "world_editor: no se está colocando nada -- empieza con /place, /chunk o /delete."

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: spade or shoot a block of the component to delete."
msgstr "world_editor: golpea con la pala o dispara a un bloque del componente para borrarlo."

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: spade two opposite corners."
msgstr "world_editor: golpea con la pala dos esquinas opuestas."

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: spade the centre, then the edge."
msgstr "world_editor: golpea con la pala el centro y luego el borde."

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: mark at %(x) %(y) %(z)"
msgstr "world_editor: marca en %(x) %(y) %(z)"

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: that mark is outside the map."
msgstr "world_editor: esa marca está fuera del mapa."

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: nothing to mark there -- aim at ground or water."
msgstr "world_editor: nada que marcar ahí -- apunta al suelo o al agua."

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: placement finished on mark %(n) -- %(extra) extra ignored."
msgstr "world_editor: colocación terminada en la marca %(n) -- %(extra) de más ignoradas."

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: %(kind) #%(id) placed."
msgstr "world_editor: %(kind) #%(id) colocado."

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: no component on that block -- aim right at one."
msgstr "world_editor: ningún componente en ese bloque -- apunta justo a uno."

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: no components on this map."
msgstr "world_editor: no hay componentes en este mapa."

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: broke %(kind) #%(id)."
msgstr "world_editor: %(kind) #%(id) roto."

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: %(verb) %(kind) #%(id) -- its blocks stay, back at rest."
msgstr "world_editor: %(verb) %(kind) #%(id) -- sus bloques se quedan, de vuelta en reposo."

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: nothing to undo."
msgstr "world_editor: nada que deshacer."

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: %(kind) #%(id) is now %(perm)"
msgstr "world_editor: %(kind) #%(id) ahora es %(perm)"

#: catalog/tools/world_editor/world_editor.lua
msgid "  #%(id) %(kind) at %(x),%(y) %(perm) blocks %(blocks) %(status)"
msgstr "  #%(id) %(kind) en %(x),%(y) %(perm) bloques %(blocks) %(status)"

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: perm must be ro, rw, or rw:<team>."
msgstr "world_editor: perm debe ser ro, rw o rw:<equipo>."

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: chunk %(name) (%(perm)) created."
msgstr "world_editor: zona %(name) (%(perm)) creada."

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: you are not in a chunk (use /defaultperm for the open map)."
msgstr "world_editor: no estás en ninguna zona (usa /defaultperm para el mapa abierto)."

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: %(name) is now %(perm)"
msgstr "world_editor: %(name) ahora es %(perm)"

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: removed chunk %(name)"
msgstr "world_editor: zona %(name) eliminada"

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: default %(perm)%(readonly)"
msgstr "world_editor: predeterminado %(perm)%(readonly)"

#: catalog/tools/world_editor/world_editor.lua
msgid ", map READONLY"
msgstr ", mapa de SOLO LECTURA"

#: catalog/tools/world_editor/world_editor.lua
msgid "  #%(id) %(name) %(shape) %(perm)"
msgstr "  #%(id) %(name) %(shape) %(perm)"

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: default is now %(perm)"
msgstr "world_editor: el predeterminado ahora es %(perm)"

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: map readonly %(state)"
msgstr "world_editor: mapa de solo lectura %(state)"

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: no map name known -- pass one: /wesavemap <name>."
msgstr "world_editor: no se conoce el nombre del mapa -- indica uno: /wesavemap <nombre>."

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: bad name (no / \\ or leading dot)."
msgstr "world_editor: nombre incorrecto (sin / \\ ni punto inicial)."

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: saved %(name).vxl + %(name).editor.json in %(dir)/"
msgstr "world_editor: guardado %(name).vxl + %(name).editor.json en %(dir)/"

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: save failed -- see server log (is maps/ writable?)."
msgstr "world_editor: error al guardar -- revisa el log del servidor (¿se puede escribir en maps/?)."

#: catalog/tools/world_editor/world_editor.lua
msgctxt "command"
msgid "Toggle world edit mode (console only)."
msgstr "Alternar el modo edición del mundo (solo consola)."

#: catalog/tools/world_editor/world_editor.lua
msgctxt "command"
msgid "Place a component; /place alone lists them, /place <c> shows help."
msgstr "Colocar un componente; /place solo los lista, /place <c> muestra la ayuda."

#: catalog/tools/world_editor/world_editor.lua
msgctxt "command"
msgid "Drop a placement mark where you are (or at x y z)."
msgstr "Poner una marca de colocación donde estás (o en x y z)."

#: catalog/tools/world_editor/world_editor.lua
msgctxt "command"
msgid "Place one or more placement marks by coordinate."
msgstr "Poner una o más marcas de colocación por coordenadas."

#: catalog/tools/world_editor/world_editor.lua
msgctxt "command"
msgid "Set protection on the nearest component."
msgstr "Fijar la protección del componente más cercano."

#: catalog/tools/world_editor/world_editor.lua
msgctxt "command"
msgid "Un-place the most recent component (its blocks stay)."
msgstr "Deshacer la colocación del componente más reciente (sus bloques se quedan)."

#: catalog/tools/world_editor/world_editor.lua
msgctxt "command"
msgid "Un-place the component whose block you mark (its blocks stay)."
msgstr "Deshacer la colocación del componente cuyo bloque marques (sus bloques se quedan)."

#: catalog/tools/world_editor/world_editor.lua
msgctxt "command"
msgid "Save the map (.vxl) and its components (.editor.json) to maps/."
msgstr "Guardar el mapa (.vxl) y sus componentes (.editor.json) en maps/."

#: catalog/tools/world_editor/world_editor.lua
msgctxt "command"
msgid "Create an authorization chunk (spade two marks to set its extent)."
msgstr "Crear una zona de autorización (golpea con la pala dos marcas para fijar su extensión)."

#: catalog/tools/world_editor/world_editor.lua
msgctxt "command"
msgid "Set the authorization of the chunk you are standing in."
msgstr "Fijar la autorización de la zona en la que estás."

#: catalog/tools/world_editor/world_editor.lua
msgctxt "command"
msgid "Delete the chunk you are standing in."
msgstr "Borrar la zona en la que estás."

#: catalog/tools/world_editor/world_editor.lua
msgctxt "command"
msgid "List placed components and their live state."
msgstr "Listar los componentes colocados y su estado actual."

#: catalog/tools/world_editor/world_editor.lua
msgctxt "command"
msgid "List authorization chunks."
msgstr "Listar las zonas de autorización."

#: catalog/tools/world_editor/world_editor.lua
msgctxt "command"
msgid "Authorization for blocks outside every chunk (console only)."
msgstr "Autorización para los bloques fuera de toda zona (solo consola)."

#: catalog/tools/world_editor/world_editor.lua
msgctxt "command"
msgid "Master lock: refuse every player block edit (console only)."
msgstr "Bloqueo maestro: rechazar toda edición de bloques de los jugadores (solo consola)."

#: catalog/tools/world_editor/world_editor/door.lua
msgid "direction must be up, down, left or right."
msgstr "la dirección debe ser up, down, left o right."

#: catalog/tools/world_editor/world_editor/door.lua
msgid "mark one corner of the door."
msgstr "marca una esquina de la puerta."

#: catalog/tools/world_editor/world_editor/door.lua
msgid "now mark the opposite corner."
msgstr "ahora marca la esquina opuesta."

#: catalog/tools/world_editor/world_editor/door.lua
msgid "a vertical door needs height -- mark corners at different heights."
msgstr "una puerta vertical necesita altura -- marca esquinas a distintas alturas."

#: catalog/tools/world_editor/world_editor/door.lua
msgid "a sliding door needs width -- mark corners apart horizontally."
msgstr "una puerta corredera necesita anchura -- marca esquinas separadas en horizontal."

#: catalog/tools/world_editor/world_editor/door.lua
msgid "that box overlaps another component -- mark clear of it."
msgstr "esa caja se solapa con otro componente -- marca lejos de él."

#: catalog/tools/world_editor/world_editor/door.lua
msgid "a door is a panel, not a block of wall -- one of its two horizontal sides has to be a single block thick."
msgstr "una puerta es un panel, no un bloque de muro -- uno de sus dos lados horizontales debe tener un solo bloque de grosor."

#: catalog/tools/world_editor/world_editor/door.lua
msgid "world_editor: door -- a built surface that retracts when a player nears it."
msgstr "world_editor: door -- una superficie construida que se retrae cuando un jugador se acerca."

#: catalog/tools/world_editor/world_editor/door.lua
msgid "  usage: /place door <up|down|left|right>"
msgstr "  uso: /place door <up|down|left|right>"

#: catalog/tools/world_editor/world_editor/door.lua
msgid "  up/down retract into ceiling/floor; left/right retract aside."
msgstr "  up/down se retraen al techo/suelo; left/right se retraen a un lado."

#: catalog/tools/world_editor/world_editor/door.lua
msgid "  build the shape first, then mark two opposite corners around it:"
msgstr "  construye primero la forma y luego marca dos esquinas opuestas a su alrededor:"

#: catalog/tools/world_editor/world_editor/door.lua
msgid "  its blocks, colours and gaps all become the door and move together."
msgstr "  sus bloques, colores y huecos pasan a ser la puerta y se mueven juntos."

#: catalog/tools/world_editor/world_editor/door.lua
msgid "  the panel retracts into the marked box and needs no room behind it."
msgstr "  el panel se retrae dentro de la caja marcada y no necesita espacio detrás."

#: catalog/tools/world_editor/world_editor/door.lua
msgid "  an empty box gives a solid panel in your palette colour instead."
msgstr "  una caja vacía da en su lugar un panel sólido del color de tu paleta."

#: catalog/tools/world_editor/world_editor/elevator.lua
msgid "direction must be up or down."
msgstr "la dirección debe ser up o down."

#: catalog/tools/world_editor/world_editor/elevator.lua
msgid "mark one corner of the platform."
msgstr "marca una esquina de la plataforma."

#: catalog/tools/world_editor/world_editor/elevator.lua
msgid "now mark the opposite corner of the platform."
msgstr "ahora marca la esquina opuesta de la plataforma."

#: catalog/tools/world_editor/world_editor/elevator.lua
msgid "now mark a block at the altitude to travel to."
msgstr "ahora marca un bloque a la altitud de destino."

#: catalog/tools/world_editor/world_editor/elevator.lua
msgid "that altitude is the platform's own level -- mark a different height."
msgstr "esa altitud es el propio nivel de la plataforma -- marca otra altura."

#: catalog/tools/world_editor/world_editor/elevator.lua
msgid "the shaft would run through another component -- pick another altitude."
msgstr "el hueco atravesaría otro componente -- elige otra altitud."

#: catalog/tools/world_editor/world_editor/elevator.lua
msgid "world_editor: elevator -- a built platform that carries riders up or down."
msgstr "world_editor: elevator -- una plataforma construida que sube o baja a quien va encima."

#: catalog/tools/world_editor/world_editor/elevator.lua
msgid "  usage: /place elevator <up|down>"
msgstr "  uso: /place elevator <up|down>"

#: catalog/tools/world_editor/world_editor/elevator.lua
msgid "  up rests at the bottom and rises when stood on; down is the reverse."
msgstr "  up reposa abajo y sube cuando alguien se pone encima; down es lo contrario."

#: catalog/tools/world_editor/world_editor/elevator.lua
msgid "  build the pad first, then mark two opposite corners around it,"
msgstr "  construye primero la base y luego marca dos esquinas opuestas a su alrededor,"

#: catalog/tools/world_editor/world_editor/elevator.lua
msgid "  then mark the altitude it should travel to -- the pad comes to"
msgstr "  después marca la altitud de destino -- la base queda"

#: catalog/tools/world_editor/world_editor/elevator.lua
msgid "  rest level with that mark."
msgstr "  en reposo al nivel de esa marca."

#: catalog/tools/world_editor/world_editor/elevator.lua
msgid "  its blocks, colours and gaps all become the platform."
msgstr "  sus bloques, colores y huecos pasan a ser la plataforma."

#: catalog/tools/world_editor/world_editor/elevator.lua
msgid "  the piston column under it takes the colour of the pad's core."
msgstr "  la columna del pistón bajo ella toma el color del centro de la base."

#: catalog/tools/world_editor/world_editor/elevator.lua
msgid "  an empty box gives a plain slab in your palette colour instead."
msgstr "  una caja vacía da en su lugar una losa lisa del color de tu paleta."
