#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: cannot write %(path) (%(err)) -- drop the :ro on the maps mount to persist"
msgstr "world_editor: impossible d'écrire %(path) (%(err)) -- retire le :ro du montage maps pour conserver"

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: %(path) is not valid json, ignoring"
msgstr "world_editor: %(path) n'est pas du json valide, ignoré"

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: loaded %(path)"
msgstr "world_editor: %(path) chargé"

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: could not load %(name) (%(err))"
msgstr "world_editor: impossible de charger %(name) (%(err))"

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: could not delist (%(err))"
msgstr "world_editor: impossible de retirer des listes (%(err))"

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: could not relist (%(err))"
msgstr "world_editor: impossible de réinscrire dans les listes (%(err))"

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: relisted after a reload (edit mode did not survive it)"
msgstr "world_editor: réinscrit dans les listes après un rechargement (le mode édition n'y a pas survécu)"

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: component %(name) failed to load: %(err)"
msgstr "world_editor: échec du chargement du composant %(name) : %(err)"

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: edit mode %(state)"
msgstr "world_editor: mode édition %(state)"

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: cannot write %(path) (%(err))"
msgstr "world_editor: impossible d'écrire %(path) (%(err))"

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: not in edit mode (enable it from the console)."
msgstr "world_editor: pas en mode édition (active-le depuis la console)."

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: edit mode can only be toggled from the console."
msgstr "world_editor: le mode édition ne se bascule que depuis la console."

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: edit mode is %(state) (map %(map))%(extra)"
msgstr "world_editor: le mode édition est %(state) (carte %(map))%(extra)"

#: catalog/tools/world_editor/world_editor.lua
msgid ", delisted by edit mode"
msgstr ", retiré des listes par le mode édition"

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: created %(path)"
msgstr "world_editor: %(path) créé"

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: %(names) loaded -- terrain editing and flight for the session."
msgstr "world_editor: %(names) chargé(s) -- édition du terrain et vol pour la session."

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: delisted from the public lists (ip:port still works, so you can invite builders in)"
msgstr "world_editor: retiré des listes publiques (ip:port marche toujours, tu peux donc inviter des bâtisseurs)"

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: listed publicly again."
msgstr "world_editor: de nouveau listé publiquement."

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: edit mode ENABLED -- the map is being built on."
msgstr "world_editor: mode édition ACTIVÉ -- la carte est en construction."

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: edit mode disabled."
msgstr "world_editor: mode édition désactivé."

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: placeable -- %(names)"
msgstr "world_editor: plaçables -- %(names)"

#: catalog/tools/world_editor/world_editor.lua
msgid "  /place <component> for its help, e.g. /place elevator"
msgstr "  /place <composant> pour son aide, ex. /place elevator"

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: no such component. placeable: %(names)"
msgstr "world_editor: composant inconnu. plaçables : %(names)"

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: %(name) -- %(desc)"
msgstr "world_editor: %(name) -- %(desc)"

#: catalog/tools/world_editor/world_editor.lua
msgid "  usage: /place %(name) %(usage)"
msgstr "  utilisation : /place %(name) %(usage)"

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: %(text)"
msgstr "world_editor: %(text)"

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: nothing being placed -- start with /place or /chunk."
msgstr "world_editor: rien en cours de placement -- commence par /place ou /chunk."

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: pick the two corners of the %(kind) -- aim and click each one."
msgstr "world_editor: choisis les deux coins du %(kind) -- vise et clique sur chacun."

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: nothing being placed -- start with /place, /chunk or /delete."
msgstr "world_editor: rien en cours de placement -- commence par /place, /chunk ou /delete."

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: spade or shoot a block of the component to delete."
msgstr "world_editor: frappe à la pelle ou tire sur un bloc du composant à supprimer."

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: spade two opposite corners."
msgstr "world_editor: frappe deux coins opposés à la pelle."

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: spade the centre, then the edge."
msgstr "world_editor: frappe le centre à la pelle, puis le bord."

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: mark at %(x) %(y) %(z)"
msgstr "world_editor: marque en %(x) %(y) %(z)"

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: that mark is outside the map."
msgstr "world_editor: cette marque est hors de la carte."

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: nothing to mark there -- aim at ground or water."
msgstr "world_editor: rien à marquer ici -- vise le sol ou l'eau."

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: placement finished on mark %(n) -- %(extra) extra ignored."
msgstr "world_editor: placement terminé à la marque %(n) -- %(extra) en trop ignorée(s)."

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: %(kind) #%(id) placed."
msgstr "world_editor: %(kind) #%(id) placé."

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: no component on that block -- aim right at one."
msgstr "world_editor: aucun composant sur ce bloc -- vise-le bien."

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: no components on this map."
msgstr "world_editor: aucun composant sur cette carte."

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: broke %(kind) #%(id)."
msgstr "world_editor: %(kind) #%(id) cassé."

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: %(verb) %(kind) #%(id) -- its blocks stay, back at rest."
msgstr "world_editor: %(verb) %(kind) #%(id) -- ses blocs restent, au repos."

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: nothing to undo."
msgstr "world_editor: rien à annuler."

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: %(kind) #%(id) is now %(perm)"
msgstr "world_editor: %(kind) #%(id) est maintenant %(perm)"

#: catalog/tools/world_editor/world_editor.lua
msgid "  #%(id) %(kind) at %(x),%(y) %(perm) blocks %(blocks) %(status)"
msgstr "  #%(id) %(kind) en %(x),%(y) %(perm) blocs %(blocks) %(status)"

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: perm must be ro, rw, or rw:<team>."
msgstr "world_editor: perm doit valoir ro, rw ou rw:<équipe>."

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: chunk %(name) (%(perm)) created."
msgstr "world_editor: chunk %(name) (%(perm)) créé."

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: you are not in a chunk (use /defaultperm for the open map)."
msgstr "world_editor: tu n'es dans aucun chunk (utilise /defaultperm pour la carte ouverte)."

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: %(name) is now %(perm)"
msgstr "world_editor: %(name) est maintenant %(perm)"

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: removed chunk %(name)"
msgstr "world_editor: chunk %(name) supprimé"

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: default %(perm)%(readonly)"
msgstr "world_editor: par défaut %(perm)%(readonly)"

#: catalog/tools/world_editor/world_editor.lua
msgid ", map READONLY"
msgstr ", carte en LECTURE SEULE"

#: catalog/tools/world_editor/world_editor.lua
msgid "  #%(id) %(name) %(shape) %(perm)"
msgstr "  #%(id) %(name) %(shape) %(perm)"

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: default is now %(perm)"
msgstr "world_editor: par défaut maintenant %(perm)"

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: map readonly %(state)"
msgstr "world_editor: carte en lecture seule %(state)"

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: no map name known -- pass one: /wesavemap <name>."
msgstr "world_editor: nom de carte inconnu -- donne-en un : /wesavemap <nom>."

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: bad name (no / \\ or leading dot)."
msgstr "world_editor: nom invalide (pas de / \\ ni de point au début)."

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: saved %(name).vxl + %(name).editor.json in %(dir)/"
msgstr "world_editor: %(name).vxl + %(name).editor.json enregistrés dans %(dir)/"

#: catalog/tools/world_editor/world_editor.lua
msgid "world_editor: save failed -- see server log (is maps/ writable?)."
msgstr "world_editor: échec de l'enregistrement -- voir le journal du serveur (maps/ est-il accessible en écriture ?)."

#: catalog/tools/world_editor/world_editor.lua
msgctxt "command"
msgid "Toggle world edit mode (console only)."
msgstr "Basculer le mode édition du monde (console uniquement)."

#: catalog/tools/world_editor/world_editor.lua
msgctxt "command"
msgid "Place a component; /place alone lists them, /place <c> shows help."
msgstr "Placer un composant ; /place seul les liste, /place <c> affiche l'aide."

#: catalog/tools/world_editor/world_editor.lua
msgctxt "command"
msgid "Drop a placement mark where you are (or at x y z)."
msgstr "Poser une marque de placement là où tu es (ou en x y z)."

#: catalog/tools/world_editor/world_editor.lua
msgctxt "command"
msgid "Place one or more placement marks by coordinate."
msgstr "Poser une ou plusieurs marques de placement par coordonnées."

#: catalog/tools/world_editor/world_editor.lua
msgctxt "command"
msgid "Set protection on the nearest component."
msgstr "Régler la protection du composant le plus proche."

#: catalog/tools/world_editor/world_editor.lua
msgctxt "command"
msgid "Un-place the most recent component (its blocks stay)."
msgstr "Annuler le placement du dernier composant (ses blocs restent)."

#: catalog/tools/world_editor/world_editor.lua
msgctxt "command"
msgid "Un-place the component whose block you mark (its blocks stay)."
msgstr "Annuler le placement du composant dont tu marques un bloc (ses blocs restent)."

#: catalog/tools/world_editor/world_editor.lua
msgctxt "command"
msgid "Save the map (.vxl) and its components (.editor.json) to maps/."
msgstr "Enregistrer la carte (.vxl) et ses composants (.editor.json) dans maps/."

#: catalog/tools/world_editor/world_editor.lua
msgctxt "command"
msgid "Create an authorization chunk (spade two marks to set its extent)."
msgstr "Créer un chunk d'autorisation (frappe deux marques à la pelle pour son étendue)."

#: catalog/tools/world_editor/world_editor.lua
msgctxt "command"
msgid "Set the authorization of the chunk you are standing in."
msgstr "Régler l'autorisation du chunk où tu te trouves."

#: catalog/tools/world_editor/world_editor.lua
msgctxt "command"
msgid "Delete the chunk you are standing in."
msgstr "Supprimer le chunk où tu te trouves."

#: catalog/tools/world_editor/world_editor.lua
msgctxt "command"
msgid "List placed components and their live state."
msgstr "Lister les composants placés et leur état en direct."

#: catalog/tools/world_editor/world_editor.lua
msgctxt "command"
msgid "List authorization chunks."
msgstr "Lister les chunks d'autorisation."

#: catalog/tools/world_editor/world_editor.lua
msgctxt "command"
msgid "Authorization for blocks outside every chunk (console only)."
msgstr "Autorisation des blocs hors de tout chunk (console uniquement)."

#: catalog/tools/world_editor/world_editor.lua
msgctxt "command"
msgid "Master lock: refuse every player block edit (console only)."
msgstr "Verrou général : refuser toute modification de bloc par les joueurs (console uniquement)."

#: catalog/tools/world_editor/world_editor/door.lua
msgid "direction must be up, down, left or right."
msgstr "la direction doit être up, down, left ou right."

#: catalog/tools/world_editor/world_editor/door.lua
msgid "mark one corner of the door."
msgstr "marque un coin de la porte."

#: catalog/tools/world_editor/world_editor/door.lua
msgid "now mark the opposite corner."
msgstr "marque maintenant le coin opposé."

#: catalog/tools/world_editor/world_editor/door.lua
msgid "a vertical door needs height -- mark corners at different heights."
msgstr "une porte verticale a besoin de hauteur -- marque des coins à des hauteurs différentes."

#: catalog/tools/world_editor/world_editor/door.lua
msgid "a sliding door needs width -- mark corners apart horizontally."
msgstr "une porte coulissante a besoin de largeur -- écarte les coins à l'horizontale."

#: catalog/tools/world_editor/world_editor/door.lua
msgid "that box overlaps another component -- mark clear of it."
msgstr "cette boîte chevauche un autre composant -- marque à l'écart."

#: catalog/tools/world_editor/world_editor/door.lua
msgid "a door is a panel, not a block of wall -- one of its two horizontal sides has to be a single block thick."
msgstr "une porte est un panneau, pas un pan de mur -- un de ses deux côtés horizontaux doit faire un seul bloc d'épaisseur."

#: catalog/tools/world_editor/world_editor/door.lua
msgid "world_editor: door -- a built surface that retracts when a player nears it."
msgstr "world_editor: door -- une surface construite qui s'escamote quand un joueur approche."

#: catalog/tools/world_editor/world_editor/door.lua
msgid "  usage: /place door <up|down|left|right>"
msgstr "  utilisation : /place door <up|down|left|right>"

#: catalog/tools/world_editor/world_editor/door.lua
msgid "  up/down retract into ceiling/floor; left/right retract aside."
msgstr "  up/down s'escamotent dans le plafond/le sol ; left/right sur le côté."

#: catalog/tools/world_editor/world_editor/door.lua
msgid "  build the shape first, then mark two opposite corners around it:"
msgstr "  construis d'abord la forme, puis marque deux coins opposés autour :"

#: catalog/tools/world_editor/world_editor/door.lua
msgid "  its blocks, colours and gaps all become the door and move together."
msgstr "  ses blocs, couleurs et vides forment la porte et bougent ensemble."

#: catalog/tools/world_editor/world_editor/door.lua
msgid "  the panel retracts into the marked box and needs no room behind it."
msgstr "  le panneau s'escamote dans la boîte marquée, sans place derrière."

#: catalog/tools/world_editor/world_editor/door.lua
msgid "  an empty box gives a solid panel in your palette colour instead."
msgstr "  une boîte vide donne plutôt un panneau plein de ta couleur de palette."

#: catalog/tools/world_editor/world_editor/elevator.lua
msgid "direction must be up or down."
msgstr "la direction doit être up ou down."

#: catalog/tools/world_editor/world_editor/elevator.lua
msgid "mark one corner of the platform."
msgstr "marque un coin de la plateforme."

#: catalog/tools/world_editor/world_editor/elevator.lua
msgid "now mark the opposite corner of the platform."
msgstr "marque maintenant le coin opposé de la plateforme."

#: catalog/tools/world_editor/world_editor/elevator.lua
msgid "now mark a block at the altitude to travel to."
msgstr "marque maintenant un bloc à l'altitude à atteindre."

#: catalog/tools/world_editor/world_editor/elevator.lua
msgid "that altitude is the platform's own level -- mark a different height."
msgstr "cette altitude est celle de la plateforme -- marque une autre hauteur."

#: catalog/tools/world_editor/world_editor/elevator.lua
msgid "the shaft would run through another component -- pick another altitude."
msgstr "la cage traverserait un autre composant -- choisis une autre altitude."

#: catalog/tools/world_editor/world_editor/elevator.lua
msgid "world_editor: elevator -- a built platform that carries riders up or down."
msgstr "world_editor: elevator -- une plateforme construite qui monte ou descend ses passagers."

#: catalog/tools/world_editor/world_editor/elevator.lua
msgid "  usage: /place elevator <up|down>"
msgstr "  utilisation : /place elevator <up|down>"

#: catalog/tools/world_editor/world_editor/elevator.lua
msgid "  up rests at the bottom and rises when stood on; down is the reverse."
msgstr "  up repose en bas et monte quand on s'y tient ; down fait l'inverse."

#: catalog/tools/world_editor/world_editor/elevator.lua
msgid "  build the pad first, then mark two opposite corners around it,"
msgstr "  construis d'abord la plateforme, puis marque deux coins opposés autour,"

#: catalog/tools/world_editor/world_editor/elevator.lua
msgid "  then mark the altitude it should travel to -- the pad comes to"
msgstr "  puis marque l'altitude à atteindre -- la plateforme s'arrête"

#: catalog/tools/world_editor/world_editor/elevator.lua
msgid "  rest level with that mark."
msgstr "  au niveau de cette marque."

#: catalog/tools/world_editor/world_editor/elevator.lua
msgid "  its blocks, colours and gaps all become the platform."
msgstr "  ses blocs, couleurs et vides forment la plateforme."

#: catalog/tools/world_editor/world_editor/elevator.lua
msgid "  the piston column under it takes the colour of the pad's core."
msgstr "  la colonne de piston dessous prend la couleur du cœur de la plateforme."

#: catalog/tools/world_editor/world_editor/elevator.lua
msgid "  an empty box gives a plain slab in your palette colour instead."
msgstr "  une boîte vide donne plutôt une dalle unie de ta couleur de palette."
