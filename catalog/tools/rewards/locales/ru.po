msgstr "Аптечка"

#: catalog/tools/rewards/lib_rewards.lua
msgid "Area heal"
msgstr "Зональное лечение"

#: catalog/tools/rewards/lib_rewards.lua
msgid "Night vision"
msgstr "Ночное видение"

#: catalog/tools/rewards/lib_rewards.lua
msgid "You earned: %(what). Use it with /inv, or the pie menu."
msgstr "Ты получил: %(what). Используй через /inv или круговое меню."

#: catalog/tools/rewards/lib_rewards.lua
msgid "%(name) earned a reward"
msgstr "%(name) получил награду"

#: catalog/tools/rewards/lib_rewards.lua
msgid "Rewards are for the living."
msgstr "Награды только для живых."

#: catalog/tools/rewards/lib_rewards.lua
msgid "%(what) is only for the night."
msgstr "%(what) работает только ночью."

#: catalog/tools/rewards/lib_rewards.lua
msgid "No such reward. Your rewards are in your inventory: /inv."
msgstr "Нет такой награды. Твои награды в инвентаре: /inv."

#: catalog/tools/rewards/lib_rewards.lua
msgid "%(what) could not be used right now; you keep it."
msgstr "%(what) сейчас нельзя использовать; предмет остаётся у тебя."

#: catalog/tools/rewards/lib_rewards.lua
msgid "You have no %(what): rewards come every %(kills) kills, and with every capture."
msgstr "У тебя нет предмета «%(what)»: награды дают за каждые %(kills) убийств и за каждый захват."

#: catalog/tools/rewards/lib_rewards.lua
msgctxt "command"
msgid "Use one of your rewards (they are in your inventory: /inv)."
msgstr "Использовать одну из своих наград (они в инвентаре: /inv)."
