#: catalog/tools/rewards/lib_rewards.lua
msgid "You earned a reward point (%(points)/%(max)). Spend it: /reward, or the pie menu."
msgstr "Tu as gagné un point de récompense (%(points)/%(max)). Dépense-le : /reward, ou le menu radial."

#: catalog/tools/rewards/lib_rewards.lua
msgid "%(name) earned a reward"
msgstr "%(name) a gagné une récompense"

#: catalog/tools/rewards/lib_rewards.lua
msgid "Rewards -- you have %(points) point(s):"
msgstr "Récompenses -- tu as %(points) point(s) :"

#: catalog/tools/rewards/lib_rewards.lua
msgid "  /reward %(name): %(label), %(cost) point(s)"
msgstr "  /reward %(name) : %(label), %(cost) point(s)"

#: catalog/tools/rewards/lib_rewards.lua
msgid "  Nothing is on offer here."
msgstr "  Rien n'est proposé ici."

#: catalog/tools/rewards/lib_rewards.lua
msgid "You got: %(what). Points left: %(points)."
msgstr "Tu as obtenu : %(what). Points restants : %(points)."

#: catalog/tools/rewards/lib_rewards.lua
msgid "%(what) costs %(cost) point(s) and you have %(points)."
msgstr "%(what) coûte %(cost) point(s) et tu en as %(points)."

#: catalog/tools/rewards/lib_rewards.lua
msgid "Rewards are for the living."
msgstr "Les récompenses sont pour les vivants."

#: catalog/tools/rewards/lib_rewards.lua
msgid "%(what) is only offered at night."
msgstr "%(what) n'est proposé que la nuit."

#: catalog/tools/rewards/lib_rewards.lua
msgid "No such reward. Type /reward for the list."
msgstr "Récompense inconnue. Tape /reward pour la liste."

#: catalog/tools/rewards/lib_rewards.lua
msgid "%(what) could not be used right now; no point spent."
msgstr "%(what) ne peut pas être utilisé maintenant ; aucun point dépensé."

#: catalog/tools/rewards/lib_rewards.lua
msgctxt "command"
msgid "Spend your reward points: /reward lists what you can get."
msgstr "Dépenser tes points de récompense : /reward affiche ce que tu peux obtenir."

#: catalog/tools/rewards/lib_rewards.lua
msgid "Rewards"
msgstr "Récompenses"
