#: catalog/tools/rewards/lib_rewards.lua
msgid "You earned: %(what). Use it with /inv, or the pie menu."
msgstr "Ganaste: %(what). Úsalo con /inv, o el menú circular."

#: catalog/tools/rewards/lib_rewards.lua
msgid "%(name) earned a reward"
msgstr "%(name) ha ganado una recompensa"

#: catalog/tools/rewards/lib_rewards.lua
msgid "Rewards are for the living."
msgstr "Las recompensas son para los vivos."

#: catalog/tools/rewards/lib_rewards.lua
msgid "%(what) is only for the night."
msgstr "%(what) solo sirve de noche."

#: catalog/tools/rewards/lib_rewards.lua
msgid "No such reward. Your rewards are in your inventory: /inv."
msgstr "No existe esa recompensa. Tus recompensas están en tu inventario: /inv."

#: catalog/tools/rewards/lib_rewards.lua
msgid "%(what) could not be used right now; you keep it."
msgstr "%(what) no se puede usar ahora; lo conservas."

#: catalog/tools/rewards/lib_rewards.lua
msgid "You have no %(what): rewards come every %(kills) kills, and with every capture."
msgstr "No tienes %(what): hay una recompensa cada %(kills) bajas, y con cada captura."

#: catalog/tools/rewards/lib_rewards.lua
msgctxt "command"
msgid "Use one of your rewards (they are in your inventory: /inv)."
msgstr "Usar una de tus recompensas (están en tu inventario: /inv)."
