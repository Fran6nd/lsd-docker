#: catalog/tools/rewards/lib_rewards.lua
msgid "Railgun"
msgstr "Cañón de riel"

#: catalog/tools/rewards/lib_rewards.lua
msgid "Rocket"
msgstr "Cohete"

#: catalog/tools/rewards/lib_rewards.lua
msgid "Airstrike"
msgstr "Bombardeo aéreo"

#: catalog/tools/rewards/lib_rewards.lua
msgid "Medkit"
msgstr "Botiquín"

#: catalog/tools/rewards/lib_rewards.lua
msgid "Area heal"
msgstr "Curación en área"

#: catalog/tools/rewards/lib_rewards.lua
msgid "Night vision"
msgstr "Visión nocturna"

#: catalog/tools/rewards/lib_rewards.lua
msgid "You earned a reward point (%(points)/%(max)). Spend it: /reward, or the pie menu."
msgstr "Has ganado un punto de recompensa (%(points)/%(max)). Gástalo con /reward o desde el menú circular."

#: catalog/tools/rewards/lib_rewards.lua
msgid "%(name) earned a reward"
msgstr "%(name) ha ganado una recompensa"

#: catalog/tools/rewards/lib_rewards.lua
msgid "Rewards -- you have %(points) point(s):"
msgstr "Recompensas -- tienes %(points) punto(s):"

#: catalog/tools/rewards/lib_rewards.lua
msgid "  /reward %(name): %(label), %(cost) point(s)"
msgstr "  /reward %(name): %(label), %(cost) punto(s)"

#: catalog/tools/rewards/lib_rewards.lua
msgid "  Nothing is on offer here."
msgstr "  Aquí no hay nada a la venta."

#: catalog/tools/rewards/lib_rewards.lua
msgid "You got: %(what). Points left: %(points)."
msgstr "Has obtenido: %(what). Puntos restantes: %(points)."

#: catalog/tools/rewards/lib_rewards.lua
msgid "%(what) costs %(cost) point(s) and you have %(points)."
msgstr "%(what) cuesta %(cost) punto(s) y tienes %(points)."

#: catalog/tools/rewards/lib_rewards.lua
msgid "Rewards are for the living."
msgstr "Las recompensas son para los vivos."

#: catalog/tools/rewards/lib_rewards.lua
msgid "%(what) is only offered at night."
msgstr "%(what) solo se ofrece de noche."

#: catalog/tools/rewards/lib_rewards.lua
msgid "No such reward. Type /reward for the list."
msgstr "No existe esa recompensa. Escribe /reward para ver la lista."

#: catalog/tools/rewards/lib_rewards.lua
msgid "%(what) could not be used right now; no point spent."
msgstr "%(what) no se puede usar ahora; no se gasta ningún punto."

#: catalog/tools/rewards/lib_rewards.lua
msgctxt "command"
msgid "Spend your reward points: /reward lists what you can get."
msgstr "Gastar tus puntos de recompensa: /reward muestra lo que puedes conseguir."

#: catalog/tools/rewards/lib_rewards.lua
msgid "Rewards"
msgstr "Recompensas"
