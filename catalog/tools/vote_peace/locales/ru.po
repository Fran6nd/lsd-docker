#: catalog/tools/vote_peace/vote_peace.lua
msgid "Peace: nobody can hurt anybody. /votepeace to end it."
msgstr "Мир: никто никому не может навредить. /votepeace — закончить его."

#: catalog/tools/vote_peace/vote_peace.lua
msgid "Peace is over: damage is back."
msgstr "Мир закончился: урон снова наносится."

#: catalog/tools/vote_peace/vote_peace.lua
msgid "New map: peace is over, damage is back."
msgstr "Новая карта: мир закончился, урон снова наносится."

#: catalog/tools/vote_peace/vote_peace.lua
msgid "%(name) wants to change the peace (a vote): type /votepeace to agree (%(have)/%(need))."
msgstr "%(name) хочет изменить мир (голосование): напиши /votepeace, чтобы согласиться (%(have)/%(need))."

#: catalog/tools/vote_peace/vote_peace.lua
msgid "%(name) agrees to change the peace (%(have)/%(need))."
msgstr "%(name) согласен изменить мир (%(have)/%(need))."

#: catalog/tools/vote_peace/vote_peace.lua
msgid "You already voted on the peace."
msgstr "Ты уже голосовал по миру."

#: catalog/tools/vote_peace/vote_peace.lua
msgid "The vote on the peace failed."
msgstr "Голосование по миру не удалось."

#: catalog/tools/vote_peace/vote_peace.lua
msgid "Peace is on: nobody can hurt anybody. /votepeace to end it."
msgstr "Мир идёт: никто никому не может навредить. /votepeace — закончить его."

#: catalog/tools/vote_peace/vote_peace.lua
msgid "Peace is on: nobody can hurt anybody. /votepeace to vote it over."
msgstr "Мир идёт: никто никому не может навредить. /votepeace — проголосовать за его конец."

#: catalog/tools/vote_peace/vote_peace.lua
msgid "No peace: /votepeace to vote one."
msgstr "Мира нет: /votepeace — проголосовать за него."

#: catalog/tools/vote_peace/vote_peace.lua
msgctxt "command"
msgid "Vote for a peace, where nobody can hurt anybody -- or, at peace, to end it."
msgstr "Проголосовать за мир, когда никто никому не может навредить, или, в мире, закончить его."

#: catalog/tools/vote_peace/vote_peace.lua
msgctxt "command"
msgid "Say whether there is peace (nobody can hurt anybody)."
msgstr "Сказать, есть ли мир (никто никому не может навредить)."
