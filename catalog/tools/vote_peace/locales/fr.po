#: catalog/tools/vote_peace/vote_peace.lua
msgid "Peace: nobody can hurt anybody. /votepeace to end it."
msgstr "Paix : personne ne peut blesser personne. /votepeace pour y mettre fin."

#: catalog/tools/vote_peace/vote_peace.lua
msgid "Peace is over: damage is back."
msgstr "La paix est finie : les dégâts sont de retour."

#: catalog/tools/vote_peace/vote_peace.lua
msgid "New map: peace is over, damage is back."
msgstr "Nouvelle carte : la paix est finie, les dégâts sont de retour."

#: catalog/tools/vote_peace/vote_peace.lua
msgid "%(name) wants to change the peace (a vote): type /votepeace to agree (%(have)/%(need))."
msgstr "%(name) veut changer la paix (un vote) : tape /votepeace pour être d'accord (%(have)/%(need))."

#: catalog/tools/vote_peace/vote_peace.lua
msgid "%(name) agrees to change the peace (%(have)/%(need))."
msgstr "%(name) est d'accord pour changer la paix (%(have)/%(need))."

#: catalog/tools/vote_peace/vote_peace.lua
msgid "You already voted on the peace."
msgstr "Tu as déjà voté sur la paix."

#: catalog/tools/vote_peace/vote_peace.lua
msgid "The vote on the peace failed."
msgstr "Le vote sur la paix a échoué."

#: catalog/tools/vote_peace/vote_peace.lua
msgid "Peace is on: nobody can hurt anybody. /votepeace to end it."
msgstr "Paix en cours : personne ne peut blesser personne. /votepeace pour y mettre fin."

#: catalog/tools/vote_peace/vote_peace.lua
msgid "Peace is on: nobody can hurt anybody. /votepeace to vote it over."
msgstr "Paix en cours : personne ne peut blesser personne. /votepeace pour voter sa fin."

#: catalog/tools/vote_peace/vote_peace.lua
msgid "No peace: /votepeace to vote one."
msgstr "Pas de paix : /votepeace pour en voter une."

#: catalog/tools/vote_peace/vote_peace.lua
msgctxt "command"
msgid "Vote for a peace, where nobody can hurt anybody -- or, at peace, to end it."
msgstr "Voter une paix, où personne ne peut blesser personne -- ou, en paix, y mettre fin."

#: catalog/tools/vote_peace/vote_peace.lua
msgctxt "command"
msgid "Say whether there is peace (nobody can hurt anybody)."
msgstr "Dire s'il y a la paix (personne ne peut blesser personne)."
