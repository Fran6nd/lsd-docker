      {"name": "parkour", "line": 15, "header": true, "above": ["# parkour.bt -- one team, no enemy, a course to run: to our base, again", "# and again.", "#", "# Words: core/vocab.h. Grammar: core/bt.h. The server's rules", "# (catalog/gamemodes/parkour): everybody is on one team; the course runs", "# from where a bot is put to its team's tent; reaching the tent ends the", "# run and the server puts the runner back at the start. The water kills,", "# and the server says so (the settings water, water.damage), so no route", "# enters it; a bot that dies is put back on the course by the server.", "#", "# So there is one thing to do, and the top `pick` is only the PRIORITY", "# LIST every tree has above it. The jumps, the steps and the beams are", "# navigation's business, not the tree's.", ""], "root":
        {"id": 0, "kind": "select", "line": 16, "column": 1, "text": "select", "children": [
          {"id": 1, "kind": "pick", "line": 17, "column": 2, "text": "pick every=1 sticky=0.2 noise=0", "roll": "weighed", "every": 1, "sticky": 0.2, "noise": 0, "defaults": ["roll"], "children": [
            {"id": 2, "kind": "option", "line": 18, "column": 3, "text": "option none grenade_near x100", "trait": "none", "score": "grenade_near", "args": [], "factor": 100, "defaults": [], "comment": "a grenade at its feet (its own team's cannot hurt it, but it does not know whose)", "children": [
              {"id": 3, "kind": "do", "line": 19, "column": 4, "text": "do evade", "action": "evade", "args": []}
            ]},
            {"id": 4, "kind": "option", "line": 20, "column": 3, "text": "option none harmful_water x60", "trait": "none", "score": "harmful_water", "args": [], "factor": 60, "defaults": [], "comment": "in the water, if it ever is: out", "children": [
              {"id": 5, "kind": "do", "line": 21, "column": 4, "text": "do leave_water", "action": "leave_water", "args": []}
            ]},
            {"id": 6, "kind": "option", "line": 22, "column": 3, "text": "option none has_order x30", "trait": "none", "score": "has_order", "args": [], "factor": 30, "defaults": [], "comment": "the server said so", "children": [
              {"id": 7, "kind": "do", "line": 23, "column": 4, "text": "do obey", "action": "obey", "args": []}
